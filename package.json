{
  "name": "mindbattle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "preview": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "content-check": "vitest run tests/unit/catalog-topics.test.ts tests/unit/catalog-full.test.ts",
    "content:baseline": "node scripts/generateCatalogBaseline.mjs",
    "content:feedback-report": "node scripts/generateFeedbackAnalysis.mjs",
    "content:findings": "node scripts/generateContentFindings.mjs docs/content-audits/content-findings-final-2026-09-02.json",
    "content:findings-baseline": "node scripts/generateContentFindings.mjs docs/content-audits/content-findings-baseline-2026-09-02.json --legacy-only",
    "content:case-check": "python3 scripts/checkRussianCases.py docs/content-audits/russian-case-findings-final-2026-09-02.json",
    "content:source-check": "node scripts/verifySourceUrls.mjs",
    "content:source-check:strict": "node scripts/verifySourceUrls.mjs --strict",
    "content:finalize-legacy-audit": "node scripts/finalizeExistingCatalogAudit.mjs",
    "content:verify-reviews": "node scripts/finalizeCatalogReviews.mjs",
    "content:mark-reviewed-packages": "node scripts/markReviewedPackages.mjs",
    "content:final-stats": "node scripts/generateFinalCatalogStats.mjs",
    "content:eligibility": "node scripts/generateEligibilityReport.mjs",
    "content:performance": "node scripts/measureCatalogPerformance.mjs",
    "content:legacy-integrity": "node scripts/checkLegacyAnswerIntegrity.mjs verify",
    "content:legacy-prefix": "node scripts/checkLegacyReviewedPrefix.mjs",
    "content:baseline-wrong-notes": "node scripts/verifyBaselineWrongAnswerNotes.mjs",
    "build": "tsc --noEmit && vite build",
    "test:browser": "npm run build && playwright test",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
