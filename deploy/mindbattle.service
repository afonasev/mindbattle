[Unit]
Description=Mindbattle web game
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mindbattle
Group=mindbattle
WorkingDirectory=/opt/mindbattle
Environment=NODE_ENV=production
Environment=MINDBATTLE_HOST=127.0.0.1
Environment=MINDBATTLE_PORT=4173
Environment=MINDBATTLE_FEEDBACK_PATH=/var/lib/mindbattle/difficulty-feedback.ndjson
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mindbattle

[Install]
WantedBy=multi-user.target
