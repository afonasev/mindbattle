    },
    "mars": {
      "url": "https://science.nasa.gov/mars/facts/",
      "locator": "Surface, Orbit and Rotation",
      "passage": "Олимп — крупнейший вулкан. Год на Марсе составляет 687 земных суток."
    },
    "uranus": {
      "url": "https://science.nasa.gov/uranus/facts/",
      "locator": "Orbit and Rotation",
      "passage": "Год Урана длится около 84 земных лет."
    },
    "neptune": {
      "url": "https://science.nasa.gov/neptune/neptune-facts/",
      "locator": "Orbit and Rotation; Rings",
      "passage": "Нептун облетает Солнце примерно за 165 лет. Есть кольца."
    },
