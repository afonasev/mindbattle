    },
    "teth": {
      "url": "https://science.nasa.gov/saturn/moons/tethys/",
      "locator": "Overview",
      "passage": "На Тефии есть долина Итака."
    },
    "rhea": {
      "url": "https://science.nasa.gov/saturn/moons/rhea/",
