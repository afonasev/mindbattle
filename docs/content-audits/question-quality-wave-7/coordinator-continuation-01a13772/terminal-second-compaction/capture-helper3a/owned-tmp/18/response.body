          <mrow class="MJX-TeXAtom-ORD">
            <mover>
              <msub>
                <mi>r</mi>
                <mrow class="MJX-TeXAtom-ORD">
                  <mi>w</mi>
                </mrow>
              </msub>
              <mo stretchy="false">¯<!-- ¯ --></mo>
            </mover>
          </mrow>
        </mrow>
        <mspace width="thinmathspace"></mspace>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle u_{dn}={\frac {p_{i}-p_{w}}{p_{w}}}\chi N_{w}{\bar {r_{w}}}\,}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/e92b04e4f2d752594b488ac477b0e0d15a611dbe" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -2.338ex; width:22.305ex; height:5.676ex;" alt="{\displaystyle u_{dn}={\frac {p_{i}-p_{w}}{p_{w}}}\chi N_{w}{\bar {r_{w}}}\,}"/></span></dd></dl>

<p id="mwOg">where <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt18" id="mwOw" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"\\eta"}}'><span class="mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" class="mathjax_ignore" alttext="{\displaystyle \eta }">
  <semantics>
    <mrow class="MJX-TeXAtom-ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <mi>η<!-- η --></mi>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle \eta }</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/e4d701857cf5fbec133eebaf94deadf722537f64" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.838ex; width:1.169ex; height:2.176ex;" alt="{\displaystyle \eta }"/></span> and <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt19" id="mwPA" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"\\chi"}}'><span class="mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" class="mathjax_ignore" alttext="{\displaystyle \chi }">
  <semantics>
    <mrow class="MJX-TeXAtom-ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <mi>χ<!-- χ --></mi>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle \chi }</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/656111758322ace96d80a9371771aa6d3de25437" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.671ex; width:1.455ex; height:2.009ex;" alt="{\displaystyle \chi }"/></span> are coefficients dependent on temperature and pressure, <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt20" id="mwPQ" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"N_i"}}'><span class="mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" class="mathjax_ignore" alttext="{\displaystyle N_{i}}">
  <semantics>
