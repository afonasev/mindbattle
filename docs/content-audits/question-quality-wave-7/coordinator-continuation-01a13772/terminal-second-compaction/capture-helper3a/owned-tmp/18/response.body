</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/46b1b5351297b83bda1d199910eb88fa2eb80a42" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -2.338ex; width:20.722ex; height:5.676ex;" alt="{\displaystyle u_{up}={\frac {p_{w}-p_{i}}{p_{i}}}\eta N_{i}{\bar {r_{i}}}\,}"/></span></dd>
<dd id="mwOA"><span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt17" id="mwOQ" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"u_{dn} = \\frac{p_i - p_w}{p_w} \\chi N_w \\bar{r_w} \\,"}}'><span class="mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" class="mathjax_ignore" alttext="{\displaystyle u_{dn}={\frac {p_{i}-p_{w}}{p_{w}}}\chi N_{w}{\bar {r_{w}}}\,}">
  <semantics>
