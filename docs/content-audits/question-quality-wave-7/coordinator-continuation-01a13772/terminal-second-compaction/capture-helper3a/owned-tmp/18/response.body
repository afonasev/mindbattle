                  <mi>i</mi>
                </mrow>
              </msub>
              <mo stretchy="false">¯<!-- ¯ --></mo>
            </mover>
          </mrow>
        </mrow>
      </mstyle>
    </mrow>
    <annotation encoding="application/x-tex">{\displaystyle {\bar {r_{i}}}}</annotation>
  </semantics>
</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/0b396370f18a886841ca7bca9287161f27d0ee9c" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.671ex; width:1.848ex; height:2.343ex;" alt="{\displaystyle {\bar {r_{i}}}}"/></span> and <span class="mwe-math-element mwe-math-element-inline" typeof="mw:Extension/math" about="#mwt23" id="mwQA" data-mw='{"name":"math","attrs":{},"body":{"extsrc":"\\bar{r_w}"}}'><span class="mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML" class="mathjax_ignore" alttext="{\displaystyle {\bar {r_{w}}}}">
  <semantics>
