    <div data-type="exercise-question" data-is-answer-order-important="true" data-formats="free-response multiple-choice" id="243006"><span class="os-number">13</span>
<span class="os-divider">. </span>

<div class="os-problem-container">
  
  
  <div data-type="question-stem">What is the range of frequencies that humans are capable of hearing?</div>
  <ol data-type="question-answers" type="a">
            <li data-type="question-answer" data-correctness="">
                <div data-type="answer-content">20 Hz to 200,000 Hz</div>
                
            </li>
            <li data-type="question-answer" data-correctness="">
                <div data-type="answer-content">2 Hz to 50,000 Hz</div>
                
            </li>
            <li data-type="question-answer" data-correctness="">
                <div data-type="answer-content">2 Hz to 2,000 Hz</div>
                
            </li>
            <li data-type="question-answer" data-correctness="">
                <div data-type="answer-content">20 Hz to 20,000 Hz</div>
                
            </li>
            </ol>
</div>

        
        
        </div>
    </div><div data-type="exercise" id="fs-id1167065892043" class="os-exercise"><header></header><section>
<div data-type="problem" id="fs-id1167065954558">
<span class="os-number">14</span><span class="os-divider">. </span>
<div class="os-problem-container">
<!--<para id="fs-id1167062315154">
<link class="os-embed" url="#ost/api/ex/k12phys-ch14-ex041"/>
</para>-->
<p id="fs-id1164564191900">How do humans change the pitch of their voice?</p>
<ol id="fs-id1164566351018" type="a">
<li>Relaxing or tightening their glottis</li>
<li>Relaxing or tightening their uvula</li>
<li>Relaxing or tightening their tongue</li>
<li>Relaxing or tightening their larynx</li>
</ol>
</div>
</div>
</section></div>
</section>



































