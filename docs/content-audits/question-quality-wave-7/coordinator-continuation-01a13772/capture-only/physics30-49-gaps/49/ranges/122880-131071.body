   <mrow>
    <mtext>&nbsp;log</mtext></mrow>
   <mrow>
    <mn>10</mn></mrow>
  </msub>
  <mrow><mo>(</mo>
   <mrow>
    <mfrac>
     <mi>I</mi>
     <mrow>
      <msub>
