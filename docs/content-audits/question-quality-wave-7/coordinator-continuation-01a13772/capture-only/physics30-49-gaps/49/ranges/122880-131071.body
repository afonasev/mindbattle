mi>Δ</mi><mi>p</mi></mrow>
      <mo>)</mo></mrow></mrow>
     <mn>2</mn>
    </msup>
    </mrow>
   <mrow>
    <mn>2</mn><mi>ρ</mi><msub>
     <mi>v</mi>
     <mrow></mrow>
    </msub>
    </mrow>
  </mfrac>
  </mrow>
</mrow><annotation-xml encoding="MathML-Content"><mrow>
  <mi>I</mi><mo>=</mo><mfrac>
   <mrow>
    <msup>
     <mrow>
      <mrow><mo>(</mo>
       <mrow>
        <mi>Δ</mi><mi>p</mi></mrow>
      <mo>)</mo></mrow></mrow>
     <mn>2</mn>
    </msup>
    </mrow>
   <mrow>
    <mn>2</mn><mi>ρ</mi><msub>
     <mi>v</mi>
     <mrow></mrow>
    </msub>
    </mrow>
  </mfrac>
  </mrow></annotation-xml></semantics></math></span> . Using <em data-effect="italics">I </em>, we can calculate <em data-effect="italics">β </em>straight from its definition in  <span class="os-math-in-para"><math display="inline"><semantics><mrow>
 <mrow>
  <mi>β</mi><mtext>&nbsp;(</mtext><mi>d</mi><mtext>B)</mtext><mo>=</mo><mn>10</mn><msub>
   <mrow>
