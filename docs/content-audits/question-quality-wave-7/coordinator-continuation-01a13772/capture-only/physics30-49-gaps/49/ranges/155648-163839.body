-k12phys filter-type:import:has-context grasp-check k12phys-ch14-s02 context-cnxmod:ee7c1f56-44a5-49d1-b67b-cb03518f6685 time:short assignment-type:homework blooms:2 filter-type:import:hs inbook-yes book-slug:college-physics-ap-courses module-slug:college-physics-ap-courses:17-6-hearing" data-is-vocab="false">
    <div data-type="exercise-question" data-is-answer-order-important="true" data-formats="free-response multiple-choice" id="243001">
        <div data-type="question-stem">If you turn up the volume of your stereo, will the pitch change? Why or why not?</div>
        <ol data-type="question-answers" type="a">
            <li data-type="question-answer" data-correctness="">
                <div data-type="answer-content">No, because pitch does not depend on intensity.</div>
                
            </li>
            <li data-type="question-answer" data-correctness="">
                <div data-type="answer-content">Yes, because pitch is directly related to intensity.</div>
                
            </li>
            </ol>
        </div>
    </div></div></section></div>
</section>



<section data-depth="1" id="fs-id1167065911336" class="check-understanding"><h3 data-type="title">Check Your Understanding</h3>
