<div data-type="injected-exercise" class="os-embed autogenerated-content" data-injected-from-nickname="" data-injected-from-version="8" data-injected-from-url="https://exercises.openstax.org/api/exercises?q=tag:k12phys-ch14-ex036" data-tags="os-practice-concepts k12phys-ch14-s02-lo01 k12phys-ch14-ex036 exid:k12phys-ch14-ex036 lo:stax-phys:17-3-1 dok:1 k12phys-ch14 k12phys book:stax-phys book:stax-k12phys book:stax-apphys k12phys-ch14-s02 context-cnxmod:ee7c1f56-44a5-49d1-b67b-cb03518f6685 context-cnxmod:5c130275-5283-49e9-8932-9dd427e28bf9 context-cnxmod:a2e1a3a2-c3e5-41ba-9d29-62320ab4822e aplo:stax-apphys:6.A.4.1 time:short science-practice:argumentation filter-type:import:hs inbook-yes book-slug:college-physics-ap-courses module-slug:college-physics-ap-courses:17-3-sound-intensity-and-sound-level assignment-type:reading blooms:1" data-is-vocab="false">
    <div data-type="exercise-question" data-is-answer-order-important="true" data-formats="free-response multiple-choice" id="243002"><span class="os-number">9</span>
<span class="os-divider">. </span>

<div class="os-problem-container">
  
  
  <div data-type="question-stem">What is sound intensity?</div>
  <ol data-type="question-answers" type="a">
            <li data-type="question-answer" data-correctness="">
                <div data-type="answer-content">Intensity is the energy per unit area carried by a wave.</div>
                
            </li>
            <li data-type="question-answer" data-correctness="">
                <div data-type="answer-content">Intensity is the energy per unit volume carried by a wave.</div>
                
            </li>
            <li data-type="question-answer" data-correctness="">
                <div data-type="answer-content">Intensity is the power per unit area carried by a wave.</div>
                
            </li>
            <li data-type="question-answer" data-correctness="">
                <div data-type="answer-content">Intensity is the power per unit volume carried by a wave.</div>
                
            </li>
            </ol>
</div>

        
        
        </div>
    </div><div data-type="injected-exercise" class="os-embed autogenerated-content" data-injected-from-nickname="" data-injected-from-version="7" data-injected-from-url="https://exercises.openstax.org/api/exercises?q=tag:k12phys-ch14-ex037" data-tags="os-practice-concepts k12phys-ch14-s02-lo01 k12phys-ch14-ex037 exid:k12phys-ch14-ex037 lo:stax-phys:17-3-1 dok:1 k12phys-ch14 k12phys book:stax-phys book:stax-k12phys k12phys-ch14-s02 context-cnxmod:ee7c1f56-44a5-49d1-b67b-cb03518f6685 context-cnxmod:5c130275-5283-49e9-8932-9dd427e28bf9 context-cnxmod:a2e1a3a2-c3e5-41ba-9d29-62320ab4822e aplo:stax-apphys:6.A.4.1 time:short filter-type:import:hs inbook-yes book-slug:college-physics-ap-courses module-slug:college-physics-ap-courses:17-3-sound-intensity-and-sound-level assignment-type:reading blooms:1" data-is-vocab="false">
    <div data-type="exercise-question" data-is-answer-order-important="true" data-formats="free-response multiple-choice" id="243003"><span class="os-number">10</span>
<span class="os-divider">. </span>

<div class="os-problem-container">
  
  
  <div data-type="question-stem">How is power defined with reference to a sound wave?</div>
  <ol data-type="question-answers" type="a">
            <li data-type="question-answer" data-correctness="">
                <div data-type="answer-content">Power is the rate at which energy is transferred by a sound wave.</div>
                
            </li>
            <li data-type="question-answer" data-correctness="">
                <div data-type="answer-content">Power is the rate at which mass is transferred by a sound wave.</div>
                
            </li>
            <li data-type="question-answer" data-correctness="">
                <div data-type="answer-content">Power is the rate at which amplitude of a sound wave changes.</div>
                
            </li>
            <li data-type="question-answer" data-correctness="">
                <div data-type="answer-content">Power is the rate at which wavelength of a sound wave changes.</div>
                
            </li>
            </ol>
</div>

        
        
        </div>
    </div><div data-type="exercise" id="fs-id1167066088746" class="os-exercise"><header></header><section>
<div data-type="problem" id="fs-id1167065952613">
<span class="os-number">11</span><span class="os-divider">. </span>
<div class="os-problem-container">
<!--<para id="fs-id1167065849089">
<link class="os-embed" url="#ost/api/ex/k12phys-ch14-ex038"/>
</para>-->
<p id="fs-id1164567904741">What word or phrase is used to describe the loudness of sound?</p>
<ol id="fs-id1164565535136" type="a">
<li>frequency or oscillation</li>
<li>intensity level or decibel</li>
<li>timbre</li>
<li>pitch</li>
</ol>
</div>
</div>
</section></div>
<div data-type="injected-exercise" class="os-embed autogenerated-content" data-injected-from-nickname="" data-injected-from-version="9" data-injected-from-url="https://exercises.openstax.org/api/exercises?q=tag:k12phys-ch14-ex039" data-tags="os-practice-concepts k12phys-ch14-s02-lo02 k12phys-ch14-ex039 exid:k12phys-ch14-ex039 science-practice:mathematical-routines dok:1 k12phys-ch14 k12phys book:stax-phys book:stax-k12phys book:stax-apphys lo:stax-phys:17-3-2 k12phys-ch14-s02 context-cnxmod:ee7c1f56-44a5-49d1-b67b-cb03518f6685 context-cnxmod:5c130275-5283-49e9-8932-9dd427e28bf9 context-cnxmod:a2e1a3a2-c3e5-41ba-9d29-62320ab4822e aplo:stax-apphys:6.A.4.1 time:short filter-type:import:hs inbook-yes book-slug:college-physics-ap-courses module-slug:college-physics-ap-courses:17-3-sound-intensity-and-sound-level assignment-type:reading blooms:1" data-is-vocab="false">
    <div data-type="exercise-question" data-is-answer-order-important="true" data-formats="free-response multiple-choice" id="243005"><span class="os-number">12</span>
<span class="os-divider">. </span>

<div class="os-problem-container">
  
  
  <div data-type="question-stem">What is the mathematical expression for sound intensity level <math alttext="\beta">
  <mi>β<!-- &#946; --></mi>
</math>?</div>
  <ol data-type="question-answers" type="a">
            <li data-type="question-answer" data-correctness="">
                <div data-