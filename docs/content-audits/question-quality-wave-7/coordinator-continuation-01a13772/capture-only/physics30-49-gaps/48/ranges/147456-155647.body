                <mi>d</mi>
                <mi>o</mi>
              </msub>

            </mrow>
          </mrow><annotation-xml encoding="MathML-Content"><mrow>
              <msub>
                <mi>W</mi>
                <mi>o</mi>
              </msub>
              <mo>=</mo><msub>
                <mstyle mathvariant="bold" mat