              </msub>

            </mrow>
          </mfrac>

        </mrow></annotation-xml></semantics></math>

    </div>

    <p id="fs-id1167066880418">Getting back to conservation of energy, for any simple machine, the work put into the machine, <em data-effect="italics">W<sub>i</sub></em>, equals the work the machine puts out, <em data-effect="italics">W<sub>o</sub></em>. Combining this with the information in the paragraphs above, we can write </p>
    <div data-type="equation" id="fs-id1167066784672" class="unnumbered" data-label="">
       <math display="block"><semantics><mrow>
        <mtable columnalign="left">
          <mtr>
            <mtd>
              <msub>
                <mi>W</mi>
                <mi>i</mi>
              </msub>
              <mo>=</mo><msub>
                <mi>W</mi>
                <mi>o</mi>
              </msub>

            </mtd>
          </mtr>
          <mtr>
            <mtd>
              <msub>
                <mstyle mathvariant="bold" mathsize="normal"><mi>F</mi></mstyle>
                <mi>e</mi>
              </msub>
              <msub>
                <mi>d</mi>
                <mi>e</mi>
              </msub>
              <mo>=</mo><msub>
                <mstyle mathvariant="bold" mathsize="normal"><mi>F</mi></mstyle>
                <mi>r</mi>
              <