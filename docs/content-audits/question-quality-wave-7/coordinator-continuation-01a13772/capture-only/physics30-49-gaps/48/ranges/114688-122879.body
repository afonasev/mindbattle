/msub>
              <msub>
                <mi>d</mi>
                <mi>r</mi>
              </msub>

            </mtd>
          </mtr>
          <mtr>
            <mtd>
              <mtext>If&nbsp;&nbsp;</mtext><msub>
                <mstyle mathvariant="bold" mathsize="normal"><mi>F</mi></mstyle>
                <mi>e</mi>
              </msub>
              <mo>&lt;</mo><msub>
                <mstyle mathvariant="bold" mathsize="normal"><mi>F</mi></mstyle>
                <mi>r</mi>
              </msub>
              <mtext>,&nbsp;then&nbsp;</mtext><msub>
                <mi>d</mi>
                <mi>e</mi>
              </msub>
              <mo>&gt;</mo><msub>
                <mi>d</mi>
                <mi>r</mi>
              </msub>
<mtext>.</mtext>
            </mtd>
          </mtr>
        </mtable>

      </mrow><annotation-xml encoding="MathML-Content"><mtable columnalign="left">
          <mtr>
            <mtd>
              <msub>
                <mi>W</mi>
                <mi>i</mi>
              </msub>
              <mo>=</mo><msub>
                <mi>W</mi>
