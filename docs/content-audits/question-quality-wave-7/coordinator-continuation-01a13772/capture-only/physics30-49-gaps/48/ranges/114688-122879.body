                <mi>d</mi>
                <mi>e</mi>
              </msub>
              <mo>=</mo><msub>
                <mstyle mathvariant="bold" mathsize="normal"><mi>F</mi></mstyle>
                <mi>r</mi>
              </msub>
              <msub>
                <mi>d</mi>
                <mi>r</mi>
