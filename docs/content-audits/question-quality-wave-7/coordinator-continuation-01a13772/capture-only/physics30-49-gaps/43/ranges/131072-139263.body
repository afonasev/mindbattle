ncoding="MathML-Content"><mrow>
  <mi>T</mi><mo>=</mo><mtext>273&nbsp;K</mtext>
 </mrow></annotation-xml></semantics></math></span>  So the change in entropy is</p>
<div data-type="equation" id="fs-id1164563431889"> <math display="block"><semantics><mrow>
 <mrow>
  <mi>Δ</mi><mi>S</mi><mo>=</mo><mfrac>
   <mi>Q</mi>
   <mi>T</mi>
  </mfrac>
  <mo>=</mo><mfrac>
   <mrow>
    <mn>3.34</mn><mo>×</mo><msup>
     <mrow>
      <mn>10</mn>
     </mrow>
     <mn>5</mn>
    </msup>
    <mtext>J</mtext>
   </mrow>
   <mrow>
    <mtext>273&nbsp;K</mtext>
   </mrow>
  </mfrac>
  <mo>=</mo><mn>1.22</mn><mo>×</mo><msup>
   <mrow>
    <mn>10</mn>
   </mrow>
   <mn>3</mn>
  </msup>
  <mtext>J/K.</mtext>
 </mrow>
</mrow><annotation-xml encoding="MathML-Content"><mrow>
  <mi>Δ</mi><mi>S</mi><mo>=</mo><mfrac>
   <mi>Q</mi>
   <mi>T</mi>
  </mfrac>
  <mo>=</mo><mfrac>
   <mrow>
    <mn>3.34</mn><mo>×</mo><msup>
     <mrow>
      <mn>10</mn>
     </mrow>
     <mn>5</mn>
    </msup>
    <mtext>J</mtext>
   </mrow>
   <mrow>
    <mtext>273&nbsp;K</mtext>
   </mrow>
  </mfrac>
  <mo>=</mo><mn>1.22</mn><mo>×</mo><msup>
   <mrow>
    <mn>10</mn>
