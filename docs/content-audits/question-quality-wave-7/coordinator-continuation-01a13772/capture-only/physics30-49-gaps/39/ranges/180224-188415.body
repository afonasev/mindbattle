  </msub>
  <mo>=</mo><mfrac>
   <mrow>
    <msub>
     <mi>d</mi>
     <mi>i</mi>
    </msub>
    <mi>f</mi>
   </mrow>
   <mrow>
    <msub>
     <mi>d</mi>
     <mi>i</mi>
    </msub>
    <mo>−</mo><mi>f</mi>
   </mrow>
  </mfrac>
  <mo>.</mo>
 </mrow>
</mrow><annotation-xml encoding="MathML-Content"><mrow>
