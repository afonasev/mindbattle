 </mrow></annotation-xml></semantics></math>
<div class="os-equation-number">
  <span class="os-number">16.2</span>
</div>
</div>

<p id="fs-id1167065795538">Entering the known quantities gives us</p>
<div data-type="equation" id="fs-id1164562176961"> <math display="block"><semantics><mrow>
 <mrow>
  <msub>
   <mi>d</mi>
