    </msup>
    <mo stretchy="false">)</mo><mo>−</mo><mn>25.0</mn>
   </mrow>
  </mfrac>
  <mo>=</mo><mn>27.3</mn><mspace width="0.3em"></mspace><mtext>&nbsp;cm</mtext><mtext>.</mtext>
 </mrow>
</mrow><annotation-xml encoding="MathML-Content"><mrow>
  <msub>
   <mi>d</mi>
   <mi>o</mi>
  </msub>
  <mo>=</mo><mfrac>
   <mrow>
