  </msub>
  <mo>=</mo><mfrac>
   <mrow>
    <mo stretchy="false">(</mo><mn>3.00</mn><mspace width="0.25em"></mspace><mo>×</mo><mspace width="0.25em"></mspace><msup>
     <mrow>
