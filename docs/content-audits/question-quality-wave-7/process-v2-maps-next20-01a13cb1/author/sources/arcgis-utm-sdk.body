            <div id="i-syntax-VB" class="i-code i-filtered-content-VB">
            <pre><pre><span style="color: #0000FF; ">Public</span> <span style="color: #0000FF; ">Shared</span> <span style="color: #0000FF; ">Function</span> CreateWgs84UtmFromLocation( _
   <span style="color: #0000FF; ">ByVal</span> <i><a class="i-popup-link" id="longitudePopupLink" data-popup-contentsource="#longitudePopupContent" data-popup-showevent="click mouseenter">longitude</a></i> <span style="color: #0000FF; ">As</span> <a href="#" onclick="javascript:navigateToHelp2Keyword('frlrfSystemDoubleClassTopic','System.Double')">Double</a>, _
   <span style="color: #0000FF; ">ByVal</span> <i><a class="i-popup-link" id="latitudePopupLink" data-popup-contentsource="#latitudePopupContent" data-popup-showevent="click mouseenter">latitude</a></i> <span style="color: #0000FF; ">As</span> <a href="#" onclick="javascript:navigateToHelp2Keyword('frlrfSystemDoubleClassTopic','System.Double')">Double</a> _
) <span style="color: #0000FF; ">As</span> <a href="topic8770.html">SpatialReference</a></pre></pre>
