            <div id="i-syntax-CS" class="i-code i-filtered-content-CS">
            <pre><pre><span style="color: #0000FF; ">public</span> <span style="color: #0000FF; ">static</span> <a href="topic8770.html">SpatialReference</a> CreateWgs84UtmFromLocation( 
   <a href="#" onclick="javascript:navigateToHelp2Keyword('frlrfSystemDoubleClassTopic','System.Double')">double</a> <i><a class="i-popup-link" id="longitudePopupLink" data-popup-contentsource="#longitudePopupContent" data-popup-showevent="click mouseenter">longitude</a></i>,
