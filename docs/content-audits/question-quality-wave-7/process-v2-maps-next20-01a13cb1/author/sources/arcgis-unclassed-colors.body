				<!--googleon: all-->
			
		</main>
	</div>
	
	<!--googleoff: all-->
	
		
			<div id="main-toc-large" class="column-5">
			    <div class="panel font-size--2 tablet-hide trailer-1">
			      <h5 class="trailer-half">In this topic</h5>
			      <ol class="list-plain pre-0 trailer-0"><li><a href="#ESRI_SECTION1_269150DC7DB44FBE90D090B90879405A">Modify unclassed color symbology</a></li><li><a href="#ESRI_SECTION1_FAC0632687A946DD9E6FAAD8EB916FB3">Vary unclassed color symbology by transparency, rotation, or size</a></li></ol>
