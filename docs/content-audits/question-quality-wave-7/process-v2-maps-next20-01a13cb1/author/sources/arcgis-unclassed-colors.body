    <META name="description" content="Unclassed colors symbology shows quantitative differences between features. It differs from graduated colors symbology by having no defined classes."><META name="last-modified" content="2025-10-14"><META name="product" content="arcgis-pro"><META name="version" content="pro3.6"><META name="search-collection" content="help"><META name="search-category" content="help-general"><META name="subject" content="MAPPING"><META name="sub_category" content="ArcGIS Pro"><META name="content_type" content="Help Topic"><META name="subject_label" content="MAPPING"><META name="sub_category_label" content="ArcGIS Pro"><META name="content_type_label" content="Help Topic"><META name="content-language" content="en">
