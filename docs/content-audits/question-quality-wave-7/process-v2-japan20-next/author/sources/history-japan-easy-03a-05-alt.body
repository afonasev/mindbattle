<!-- ▼資料展示 (Exhibition) ▼ -->
<section id="exhibition">
<h2 class="serif"><span class="textWrap">Exhibition <span class="textMin">(Admission Free)</span></span></h2>
<div class="informationWrap"><img class="pct l" src="assets/images/en/noh/pct_exhibition.jpg" alt="" />
<div class="textArea">
<p>The costumes, masks, and props used in Nohgaku performances have been handed down from generation to generation. In the exhibition room of the Theatre, you can have a closer look at their artistry.</p>
<p><a class="arrow textArrow" href="https://www.ntj.jac.go.jp/en/news/noh_theatre/2026/r8special/">About the Current Exhibition</a></p>
</div>
</div>
</section>
      <section id="performingArts">
        <h2 class="serif">Explore Traditional Japanese Performing Arts!</h2>
        <p class="leadText">Whether you are new to traditional performing arts or already familiar with them, why not visit the links below to find out some more?</p>
        <ul class="linkList">
          <li class="banner"><a class="online" href="/en/national_theatre_online/">
              <dl class="bannerText">
                <dt class="serif arrow">National Theatre Online</dt>
                <dd class="nonHover">This online platform offers a wide array of clips from our performances and videos related to traditional Japanese performing arts.</dd>
              </dl>
              <div class="imgBlock">
                <picture><source media="(max-width:750px)" srcset="/assets/images/en/top/ph_performingarts_01_sp.jpg">
                  <img src="/assets/images/en/top/ph_performingarts_01.jpg" alt="">
                </picture>
              </div></a></li>
          <li class="banner"><a class="kabuki" href="https://www2.ntj.jac.go.jp/unesco/kabuki/en/" target="_blank" rel="nonoopener">
              <dl class="bannerText">
                <dt><span class="serif textMin">Invitation to</span> <span class="serif blank">Kabuki</span></dt>
                <dd class="nonHover">Kabuki is a traditional popular drama theater with music and dance performed only by male actors in a highly stylized manner.</dd>
              </dl>
              <div class="imgBlock">
                <picture><source media="(max-width:750px)" srcset="/assets/images/en/top/ph_performingarts_02_sp.jpg">
                  <img src="/assets/images/en/top/ph_performingarts_02.jpg" alt="">
                </picture>
              </div></a></li>
          <li class="banner"><a class="bunraku" href="https://www2.ntj.jac.go.jp/unesco/bunraku/en/" target="_blank" rel="nonoopener">
              <dl class="bannerText">
                <dt><span class="serif textMin">Invitation to</span> <span class="serif blank">Bunraku</span></dt>
                <dd class="nonHover">Bunraku is a collaborative art synchronizing narrative recitation, shamisen music, and puppetry in performance.</dd>
              </dl>
              <div class="imgBlock">
                <picture><source media="(max-width:750px)" srcset="/assets/images/en/top/ph_performingarts_03_sp.jpg">
                  <img src="/assets/images/en/top/ph_performingarts_03.jpg" alt="">
                </picture>
              </div></a></li>
          <li class="banner"><a class="noh" href="https://www2.ntj.jac.go.jp/unesco/noh/en/" target="_blank" rel="nonoopener">
              <dl class="bannerText">
                <dt><span class="serif textMin">Invitation to</span> <span class="serif blank">Nohgaku</span></dt>
                <dd class="nonHover">Noh is a highly sophisticated mask play with a long history. While its sibling, Kyogen, is a comedic, conversational play.</dd>
              </dl>
              <div class="imgBlock">
                <picture><source media="(max-width:750px)" srcset="/assets/images/en/top/ph_performingarts_04_sp.jpg">
                  <img src="/assets/images/en/top/ph_performingarts_04.jpg" alt="">
                </picture>
              </div></a></li>
        </ul>
      </section>
      </div>
      <div class="tabContents" id="content2" role="tabpanel" aria-labelledby="tabContent2">
  <section id="visit"><!--<a class="importantNews" href="/en/your_visit/covid19/"><strong>COVID-19</strong> Safety <br class="s">Guidelines<span class="textMin l">Please read through our COVID-19 Safety Guidelines before your visit.</span></a>-->
    <ul class="anchor">
      <li><a class="serif" href="en/theatre/noh/#anchor01" aria-label="Details on How To Buy Tickets at National Noh Theatre">How To Buy Tickets?</a></li>
      <li><a class="serif" href="en/theatre/noh/#anchor02" aria-label="Details on Facility at National Noh Theatre">Facility</a></li>
      <li><a class="serif" href="en/theatre/noh/#anchor03" aria-label="Details on Accessibility at National Noh Theatre">Accessibility</a></li>
      <li><a class="serif" href="en/theatre/noh/#anchor04" aria-label="Details on Free Wi-Fi at National Noh Theatre">Free Wi-Fi</a></li>
      <li><a class="serif" href="en/theatre/noh/#anchor05" aria-label="Details on Restaurant & Shop at National Noh Theatre">Restaurant & Shop</a></li>
    </ul>
    <article class="innerBlock tickets" id="anchor01">
      <h2 class="serif left">How To Buy Tickets?</h2>
      <p>Tickets for the Council-organized performances can be reserved online, by phone, or in person at the Box Office/Ticket Office. You can find further details <a href="/en/your_visit/tickets/" aria-label="Details on how to buy tickets">here</a>.</p>
    </article>
    <article class="innerBlock facility" id="anchor02">
      <h2 class="serif left">Facility</h2>
      <div class="flexBlock nonTab">
        <div class="innerArticle"><img class="pct" src="/assets/images/en/noh/ph_facility_theatre.jpg" alt=""></div>
        <div class="innerArticle"><img class="pct" src="/assets/images/en/noh/ph_facility_lobby.jpg" alt=""></div>
      </div>
      <h3 class="serif tabSingle l">Noh Stage</h3>
      <p>Capacity: 627 seats<br>Main Genres of Performances: <a href="https://www2.ntj.jac.go.jp/unesco/noh/en/" target="_blank" rel="nonoopener" class="textBlank">Noh and Kyogen</a></p><a class="btnStile pdfLink singleLink" href="/assets/files/en/noh/seating_plan.pdf" target="_blank" rel="noopener">Seating Plan</a>
    </article>
    <article class="innerBlock accessibility" id="anchor03">
      <h2 class="serif left">Accessibility</h2>
      <p>This section explains accessibility for facilities of National Noh Theatre. Click <a href="/en/your_visit/accessibility/" aria-label="General accessibility information">here</a> for general accessibility information. </p>
      <div class="flexBlock accordionStyle">
        <div class="innerArticle">
          <h3><span class="serif l">Wheelchair spaces</span>
            <button class="spAccordionTrg serif s" aria-pressed="false">Wheelchair spaces</button>
          </h3>
          <div class="spAccordionContent">
            <p>There is a reserved area for wheelchairs by the front row. Please advise us of your request in advance by phone or in person at the Ticket Office of the theater.</p>
          </div>
        </div>
        <div class="innerArticle">
          <h3><span class="serif l">Difference in level</span>
            <button class="spAccordionTrg serif s" aria-pressed="false">Difference in level</button>
          </h3>
          <div class="spAccordionContent">
            <p>The aisles of the auditorium are sloped. There are no steps between the entrance and the front row seats except for the GB seats. There is one step to the GB seats.</p>
          </div>
        </div>
        <div class="innerArticle mb00">
          <h3><span class="serif l">Elevators/Lifts and Escalators</span>
            <button class="spAccordionTrg serif s" aria-pressed="false">Elevators/Lifts and Escalators</button>
          </h3>
          <div class="spAccordionContent">
            <p>There is no elevator in the Theatre. The theater facilities and the exhibition room are all on the first floor.</p>
          </div>
        </div>
        <div class="innerArticle mb00">
          <h3><span class="serif l">Parking spots for the disabled</span>
            <button class="spAccordionTrg serif s" aria-pressed="false">Parking spots for the disabled</button>
          </h3>
          <div class="spAccordionContent">
            <p>Free parking spots for the disabled are available in front of the theater entrance. Please ask the guard at the entrance to use the spot.</p>
          </div>
        </div>
      </div>
    </article>
    <article class="innerBlock freeWiFi" id="anchor04">
      <h2 class="serif left">Free Wi-Fi</h2>
      <p>Free Wi-Fi is available at our theaters. For setup and other information, review <a href="/en/your_visit/wi-fi/" aria-label="How to set up free Wi-Fi, etc.">here</a>.</p>
    </article>
    <article class="innerBlock restaurantShop" id="anchor05">
      <h2 class="serif left">Restaurant & Shop</h2>
      <div class="flexBlock tabStyle l">
        <div class="innerArticle"><img class="pct" src="/assets/images/en/noh/ph_shop_restaurant.jpg" alt="">
          <dl class="dlStyle">
            <dt class="serif">Restaurant/Café</dt>
            <dd>How about having a meal in a relaxed atmosphere, overlooking our beautiful garden? You can enjoy a variety of food, drinks, and cakes.<br>We are open 30 minutes before the curtain time on the days of the performances.  When there is no performance, the opening hour is from 11:30 to 14:00 (last orders). Staying away from the hustle and bustle of Tokyo, come to enjoy your quiet lunchtime at National Noh Theatre.</dd>
          </dl>
        </div>
        <div class="innerArticle"><img class="pct" src="/assets/images/en/noh/ph_shop_shop.jpg" alt="">
          <dl class="dlStyle">
            <dt class="serif">Shop</dt>
            <dd>We offer you a wide range of Nohgaku-related goods, including our exclusive goods and articles for Nohgaku practices. The shop is open on the days of the performances. Come and have a peep to find souvenirs for your family members, friends, and yourself!</dd>
          </dl>
        </div>
      </div>
      <div class="flexBlock tabStyle s">
        <ul id="innerTabList" role="tablist">
          <li role="presentation">
            <button class="spTabTrg serif active" role="tab" aria-controls="innerTab1" aria-selected="true">Restaurant/Café</button>
          </li>
          <li role="presentation">
            <button class="spTabTrg serif" role="tab" aria-controls="innerTab2" aria-selected="false">Shop</button>
          </li>
        </ul>
        <div class="spTabContent active" id="innerTab1" role="tabpanel"><img class="pct" src="/assets/images/en/noh/ph_shop_restaurant.jpg" alt="">How about having a meal in a relaxed atmosphere, overlooking our beautiful garden? You can enjoy a variety of food, drinks, and cakes.<br>We are open 30 minutes before the curtain time on the days of the performances.  When there is no performance, the opening hour is from 11:30 to 14:00 (last orders). Staying away from the hustle and bustle of Tokyo, come to enjoy your quiet lunchtime at National Noh Theatre.</div>
        <div class="spTabContent" id="innerTab2" role="tabpanel"><img class="pct" src="/assets/images/en/noh/ph_shop_shop.jpg" alt="">We offer you a wide range of Nohgaku-related goods, including our exclusive goods and articles for Nohgaku practices. The shop is open on the days of the performances. Come and have a peep to find souvenirs for your family members, friends, and yourself!</div>
      </div>
    </article>
  </section>
</div>
<div class="tabContents" id="content3" role="tabpanel" aria-labelledby="tabContent3">
  <section id="location">
    <h2 class="serif left">Location</h2><a class="spLink" href="/assets/images/en/noh/pct_location.png" target="_blank" rel="noopener"><img class="map" src="/assets/images/en/noh/pct_location.png" alt="Access Map"></a>
    <p>4-18-1 Sendagaya, Shibuya-ku, Tokyo 151-0051<br>Tel. +81-3-3423-1331</p>
    <article class="innerBlock">
      <h2 class="serif left">How To Get Here?</h2>
      <div class="flexBlock">
        <div class="innerArticle">
          <dl class="dlStyle">
            <dt class="serif">JR Line</dt>
            <dd>5min. walk from Sendagaya Station<br>(JR Chuo-Sobu Line/You can find lifts and escalators on the Yoyogi side of the platform.)</dd>
          </dl>
        </div>
        <div class="innerArticle">
          <dl class="dlStyle">
            <dt class="serif">Subway</dt>
            <dd>5min. walk from Kokuritsu-kyogijo Station<br>(Exit A4, Toei Oedo Line/Exit A4 has an escalator (upward) only. You can find a lift at Exit A2.)<br>7min. walk from Kita-sando Station (Fukutoshin Line)</dd>
          </dl>
        </div>
        <div class="innerArticle">
          <dl class="dlStyle">
            <dt class="serif">Bus</dt>
            <dd>
              <ul>
                <li class="indentStyle">− 5min. walk from Sendagaya Ekimae Bus Stop<br>(Toei Bus, Route number "早81" or "黒77")</li>
                <li class="indentStyle">− 1min. walk from National Noh Theatre Bus Stop<br>(Hachiko Bus, Jingu no Mori route)</li>
              </ul>
            </dd>
          </dl>
        </div>
        <div class="innerArticle">
          <dl class="dlStyle">
            <dt class="serif">By Car</dt>
            <dd>There is no parking lot.</dd>
          </dl>
        </div>
      </div>
      <a class="btnStile mapPdf" href="/assets/files/en/noh/pct_location_print.pdf" target="_blank" rel="noopener"><span class="textWrap">Print</span></a>
    </article>
  </section>
</div>
    </div>
