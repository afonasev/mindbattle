<section  class="usa-banner" aria-label="Official government website">
  <div class="usa-accordion">  <header class="usa-banner__header">
    <div class="usa-banner__inner">
      <div class="grid-col-auto">
        <img class="usa-banner__header-flag" src="/themes/custom/noaa_guswds/dist/images/us_flag_small.png" alt="U.S. flag" />
      </div>
      <div class="grid-col-fill tablet:grid-col-auto">
        <p class="usa-banner__header-text"><span aria-hidden="true">An </span>official website of the United States government</p>
              <p class="usa-banner__header-action" aria-hidden="true">Here’s how you know</p></div>
        <button class="usa-accordion__button usa-banner__button" aria-expanded="false" aria-controls="gov-banner">
          <span class="usa-banner__button-text">Here’s how you know</span>
        </button>
          </div>
  </header>
      <div class="usa-banner__content usa-accordion__content" id="gov-banner">
      <div class="grid-row grid-gap-lg">
                  <div class="usa-banner__guidance tablet:grid-col-6">
            <img class="usa-banner__icon usa-media-block__img" src="/themes/custom/noaa_guswds/dist/images/icon-dot-gov.svg" alt="Dot gov">
            <div class="usa-media-block__body">
              <p>
                <strong>Official websites use .gov</strong>
                <br> A <strong>.gov</strong> website belongs to an official government organization in the United States.
              </p>
            </div>
          </div>
                  <div class="usa-banner__guidance tablet:grid-col-6">
            <img class="usa-banner__icon usa-media-block__img" src="/themes/custom/noaa_guswds/dist/images/icon-https.svg" alt="HTTPS">
            <div class="usa-media-block__body">
              <p>
                <strong>Secure .gov websites use HTTPS</strong>
                <br> A <strong>lock</strong> (<span class="icon-lock"><svg xmlns="http://www.w3.org/2000/svg" width="52" height="64" viewBox="0 0 52 64" class="usa-banner__lock-image" role="img" aria-labelledby="banner-lock-title banner-lock-description"><title id="banner-lock-title">Lock</title><desc id="banner-lock-description">A locked padlock</desc><path fill="#000000" fill-rule="evenodd" d="M26 0c10.493 0 19 8.507 19 19v9h3a4 4 0 0 1 4 4v28a4 4 0 0 1-4 4H4a4 4 0 0 1-4-4V32a4 4 0 0 1 4-4h3v-9C7 8.507 15.507 0 26 0zm0 8c-5.979 0-10.843 4.77-10.996 10.712L15 19v9h22v-9c0-6.075-4.925-11-11-11z"/></svg></span>) or <strong>https://</strong> means you’ve safely connected to the .gov website. Share sensitive information only on official, secure websites.
              </p>
            </div>
          </div>
              </div>
    </div>
  </div>
  </section>

    
    <header class="l-header header-weather" role="banner">
              






  <div  id="block-noaaweatherwidget" class="c-block c-block--provider-noaa-weather c-block--id-noaa-weather-widget-block">

  
  
    

      <div  class="c-block__content">
  
      <form class="weather-widget-form no-weather hide-formatting noaa-weather-widget-form" action="#" method="post" accept-charset="UTF-8">
  <div class="upper">
    <script class="noaa_weather_upper" type="text/x-handlebars-template" >
      
        {{#if nodata}}
          <div class="current-temp"></div>
        {{else}}
          <div class="current-temp" {{#if icon}}style="background-image: url(&quot;/themes/custom/noaa_guswds/images/icons/weather/{{icon}}&quot;)" {{/if}}>{{#if deg}}{{deg}}°{{/if}}</div>
        {{/if}}

        <div class="inner">
          <div class="city icon-location-after">{{#if nodata}}Not Available{{else}}{{city}}{{#if state}}, {{state}}{{/if}}{{/if}}</div>
        </div>
      
    </script>
    <div class="weather-toggle icon-location-after">
      <span class="underline" data-ga="Weather:Find">Find your local weather</span>
    </div>
  </div>
  <div class="lower">
    <div class="close-button" tabindex="0"></div>
    <script class="noaa_weather_lower" type="text/x-handlebars-template" >
      
        <div class="city">{{#if nodata}}Not Available{{else}}{{city}}{{#if state}}, {{state}}{{/if}}{{/if}}</div>
        <div class="forecast-wrapper{{#if pop}} has-precip{{/if}}">
          <div class="upper">
          <div class="inner">
            {{#if nodata}}
              <div class="current-temp"></div>
            {{else}}
              <div class="current-temp" {{#if icon}}style="background-image: url(&quot;/themes/custom/noaa_guswds/images/icons/weather/{{icon}}&quot;)" {{/if}}>{{#if deg}}{{deg}}°{{/if}}</div>
              <div class="label">currently</div>
            {{/if}}
          </div>
          </div>
          {{#if nodata}}
            <a class="not-available" href="/no-data">Why is data not available?</a>
          {{else}}
          <div class="forecast-temp forecast-item"><div class="data">{{maxt}}/{{mint}}° </div><div class="label">high/low</div></div>
          {{#if pop}}<div class="forecast-precip forecast-item"><div class="data">{{pop}}% </div><div class="label">chance of {{precip_type}}</div></div>{{/if}}
          {{#if wspd}}<div class="wind forecast-item"><div class="data">{{#if wdir}}{{wdir}}{{/if}} {{wspd}} </div><div class="label">mph winds</div></div>{{/if}}
        </div>
        <a href="http://forecast.weather.gov/MapClick.php?lat={{lat}}&amp;lon={{lng}}" class="forecast-link{{#if pop}} has-precip{{/if}}" name="edit-forecast" data-ga="Weather:See full forecast">See full local forecast</a>
        {{/if}}
      
    </script>
    <div class="form-wrapper">
      <div class="change">Change location:</div>
      <div class="form-item form-type-textfield form-item-zip">
        <label class="visually-hidden" for="edit-zip" id="zip-label">Enter City, State or ZIP code</label>
        <input placeholder="Enter City, State or ZIP code" class="zip-input form-text" data-ga="Weather:Text field" type="text" id="edit-zip" name="edit-zip" aria-labelledby="zip-label" value="" size="0" maxlength="128">
        <input type="submit" name="edit-submit" value="GO" class="form-submit" data-ga="Weather:Submit button">
      </div>
    </div>
  </div>
</form>

  
      </div>
  
  
  </div>









  
  
    

  
