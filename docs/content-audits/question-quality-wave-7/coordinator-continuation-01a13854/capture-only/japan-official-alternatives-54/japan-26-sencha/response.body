                              </a></li>
                              <li><a href="javascript:void(0);" role="button" tabindex="0">
                                <img src="/kizuna/_userdata/image2/icon-sns-x.svg" alt="X Post Button (Open in a new window)" class="btn-sns-x">
                              </a></li>
                              <li><a href="https://www.linkedin.com/sharing/share-offsite/?url=https://www.japan.go.jp/kizuna/2024/10/zen_spirit_of_the_sencha_tea_ceremony.html" target="_blank" rel="noopener noreferrer">
                                <img src="/kizuna/_userdata/image2/icon-sns-in.svg" alt="LinkedIn Share Button (Open in a new window)" class="btn-sns-in">
                              </a></li>
                            </ul>
                          </div>
                        </div>
                        <!-- /.article-btm-sns-->
