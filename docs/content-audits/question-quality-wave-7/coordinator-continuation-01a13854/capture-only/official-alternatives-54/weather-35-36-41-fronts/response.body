                            <div class="div-full">
<div class="cms-content"><script>
$(document).ready(function(){    
	$('.subMenuNav').hide();  // removes the WFO level menus - optional
	$('#myfcst-widget').hide(); 
	$('.full-width-border').css('border-top', 'white');
