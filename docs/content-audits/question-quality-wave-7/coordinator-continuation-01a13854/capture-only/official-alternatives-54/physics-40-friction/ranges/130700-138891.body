(d) <span class="os-math-in-para"><math display="inline"><semantics><mrow><mrow><mstyle mathvariant="bold" mathsize="normal"><mover accent="true"><mi>P</mi><mo stretchy="false">→</mo></mover></mstyle><mo>=</mo><mn>180.0</mn><mspace width="0.2em"></mspace><mtext>N</mtext><mstyle mathvariant="bold" mathsize="normal"><mover accent="true"><mi>i</mi><mo>^</mo></mover></mstyle><mtext>.</mtext></mrow></mrow><annotation-xml encoding="MathML-Content"><mrow><mstyle mathvariant="bold" mathsize="normal"><mover accent="true"><mi>P</mi><mo stretchy="false">→</mo></mover></mstyle><mo>=</mo><mn>180.0</mn><mspace width="0.2em"></mspace><mtext>N</mtext><mstyle mathvariant="bold" mathsize="normal"><mover acce