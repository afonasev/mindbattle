  <div class="c-field__content"><div class="c-field__item">  <img loading="lazy" src="/sites/default/files/2023-10/SOSlatmap.png" width="649" height="330" alt="Longitude &amp; Latitude Map" title="Longitude &amp; Latitude Map">

</div></div></div>

  </article>

