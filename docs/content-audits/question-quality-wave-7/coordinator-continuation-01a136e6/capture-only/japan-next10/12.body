								<td class="mattersBttm">Portsmouth Treaty signed between Japan and Russia, ending war</td>
								<td class="materialBttm">&nbsp;</td>
							</tr>
							<tr>
								<td class="year">&nbsp;</td>
								<td class="date">-</td>
								<td class="matters">Start of so-called &quot;Keion&quot; era (KATSURA and SAIONJI alternate the prime ministership) (through 1912)</td>
								<td class="materialBttm"><a href="../cha2/description21.html#c2211">Letter from SAIONJI Kinmochi to KATSURA Taro</a></td>
							</tr>
