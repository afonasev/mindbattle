								<td class="materialBttm"><a href="../cha2/description11.html#c2111">House of Representatives Member Certificate</a></td>
							</tr>
							<tr>
								<td class="year">&nbsp;</td>
								<td class="dateBttm">July 10</td>
								<td class="mattersBttm">1st House of Peers mutual-voting election by lower-ranked peers (counts, viscounts, barons)</td>
								<td class="materialBttm"><a href="../cha2/description11.html#c2112">List and Ballot of Viscount Candidates for Election to the House of Peers</a></td>
							</tr>
							<tr>
