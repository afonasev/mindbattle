  <span class="os-number">9.5</span>
  <span class="os-divider"> </span>
<span class="os-title" data-type="title">Critical Temperature and Critical Magnetic Field at <math display="inline">
  <semantics>
    <mrow>
      <mrow>
        <mi>T</mi>
        <mo>=</mo>
        <mn>0</mn>
        <mspace width="0.2em"></mspace>
