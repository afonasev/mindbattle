�</mo><mi>t</mi><mo>=</mo><mn>600</mn><mspace width="0.2em"></mspace><mtext>A</mtext><mo>·</mo><mtext>h;</mtext><mspace width="0.2em"></mspace><mi>V</mi><mo>=</mo><mn>12.0</mn><mspace width="0.2em"></mspace><mtext>V;</mtext><mspace width="0.2em"></mspace><mi>c</mi><mo>=</mo><mn>3.00</mn><mspace width="0.2em"></mspace><mo>×</mo><mspace width="0.2em"></mspace><msup><mrow><mn>10</mn></mrow><mn>8</mn></msup><mspace width="0.2em"></mspace><mtext>m/s.</mtext></mrow></mrow><annotation-xml encoding="MathML-Content"><mrow><mi>I</mi><mo>·</mo><mi>t</mi><mo>=</mo><mn>600</mn><mspace width="0.2em"></mspace><mtext>A</mtext><mo>·</mo><mtext>h;</mtext><mspace width="0.2em"></mspace><mi>V</mi><mo>=</mo><mn>12.0</mn><mspace width="0.2em"></mspace><mtext>V;</mtext><mspace width="0.2em"></mspace><mi>c</mi><mo>=</mo><mn>3.00</mn><mspace width="0.2em"></mspace><mo>×</mo><mspace width="0.2em"></mspace><msup><mrow><mn>10</mn></mrow><mn>8</mn></msup><mspace width="0.2em"></mspace><mtext>m/s.</mtext></mrow></annotation-xml></semantics></math></li>
<li>Identify the unknown: <math display="inline"><semantics><mrow><mrow><mtext>Δ</mtext><mi>m</mi><mo>.</mo></mrow></mrow><annotation-xml encoding="MathML-Content"><mrow><mtext>Δ</mtext><mi>m</mi><mo>.</mo></mrow></annotation-xml></semantics></math></li>
<li>Express the answer as an equation:
<div data-type="equation" id="fs-id1167794172538" class="unnumbered" data-label=""><math display="block"><semantics><mrow><mtable><mtr><mtd columnalign="right"><msub><mi>E</mi><mrow><mtext>batt</mtext></mrow></msub></mtd><mtd columnalign="left"><mo>=</mo></mtd><mtd columnalign="left"><mo stretchy="false">(</mo><mi>Δ</mi><mi>m</mi><mo stretchy="false">)</mo><msup><mi>c</mi><mn>2</mn></msup></mtd></mtr><mtr><mtd columnalign="right"><mi>Δ</mi><mi>m</mi></mtd><mtd columnalign="left"><mo>=</mo></mtd><mtd columnalign="left"><mfrac><mrow><msub><mi>E</mi><mrow><mtext>batt</mtext></mrow></msub></mrow><mrow><msup><mi>c</mi><mn>2</mn></msup></mrow></mfrac></mtd></mtr><mtr><mtd></mtd><mtd columnalign="left"><mo>=</mo></mtd><mtd columnalign="left"><mfrac><mrow><mi>q</mi><mi>V</mi></mrow><mrow><msup><mi>c</mi><mn>2</mn></msup></mrow></mfrac></mtd></mtr><mtr><mtd></mtd><mtd columnalign="left"><mo>=</mo></mtd><mtd columnalign="left"><mfrac><mrow><mo stretchy="false">(</mo><mi>I</mi><mi>t</mi><mo stretchy="false">)</mo><mi>V</mi></mrow><mrow><msup><mi>c</mi><mn>2</mn></msup></mrow></mfrac><mo>.</mo></mtd></mtr></mtable></mrow><annotation-xml encoding="MathML-Content"><mtable><mtr><mtd columnalign="right"><msub><mi>E</mi><mrow><mtext>batt</mtext></mrow></msub></mtd><mtd columnalign="left"><mo>=</mo></mtd><mtd columnalign="left"><mo stretchy="false">(</mo><mi>Δ</mi><mi>m</mi><mo stretchy="false">)</mo><msup><mi>c</mi><mn>2</mn></msup></mtd></mtr><mtr><mtd columnalign="right"><mi>Δ</mi><mi>m</mi></mtd><mtd columnalign="left"><mo>=</mo></mtd><mtd columnalign="left"><mfrac><mrow><msub><mi>E</mi><mrow><mtext>batt</mtext></mrow></msub></mrow><mrow><msup><mi>c</mi><mn>2</mn></msup></mrow></mfrac></mtd></mtr><mtr><mtd></mtd><mtd columnalign="left"><mo>=</mo></mtd><mtd columnalign="left"><mfrac><mrow><mi>q</mi><mi>V</mi></mrow><mrow><msup><mi>c</mi><mn>2</mn></msup></mrow></mfrac></mtd></mtr><mtr><mtd></mtd><mtd columnalign="left"><mo>=</mo></mtd><mtd columnalign="left"><mfrac><mrow><mo stretchy="false">(</mo><mi>I</mi><mi>t</mi><mo stretchy="false">)</mo><mi>V</mi></mrow><mrow><msup><mi>c</mi><mn>2</mn></msup></mrow></mfrac><mo>.</mo></mtd></mtr></mtable></annotation-xml></semantics></math></div></li>
<li>Do the calculation:
<div data-type="equation" id="fs-id1167793566812" class="unnumbered" data-label=""><math display="block"><semantics><mrow><mrow><mtext>Δ</mtext><mi>m</mi><mo>=</mo><mfrac><mrow><mo stretchy="false">(</mo><mn>600</mn><mspace width="0.2em"></mspace><mtext>A</mtext><mo>·</mo><mtext>h</mtext><mo>)</mo><mo>(</mo><mn>12.0</mn><mspace width="0.2em"></mspace><mtext>V</mtext><mo>)</mo></mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mn>3.00</mn><mspace width="0.2em"></mspace><mo>×</mo><mspace width="0.2em"></mspace><msup><mrow><mn>10</mn></mrow><mn>8</mn></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac><mo>.</mo></mrow></mrow><annotation-xml encoding="MathML-Content"><mrow><mtext>Δ</mtext><mi>m</mi><mo>=</mo><mfrac><mrow><mo stretchy="false">(</mo><mn>600</mn><mspace width="0.2em"></mspace><mtext>A</mtext><mo>·</mo><mtext>h</mtext><mo>)</mo><mo>(</mo><mn>12.0</mn><mspace width="0.2em"></mspace><mtext>V</mtext><mo>)</mo></mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mn>3.00</mn><mspace width="0.2em"></mspace><mo>×</mo><mspace width="0.2em"></mspace><msup><mrow><mn>10</mn></mrow><mn>8</mn></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mfrac><mo>.</mo></mrow></annotation-xml></semantics></math></div>
Write amperes A as coulombs per second (C/s), and convert hours into seconds:
<div data-type="equation" id="fs-id1167793443455" class="unnumbered" data-label=""><math display="block"><semantics><mrow><mtable><mtr><mtd columnalign="left"><mtext>Δ</mtext><mi>m</mi></mtd><mtd columnalign="left"><mo>=</mo><mfrac><mrow><mrow><mo>(</mo><mrow><mn>600</mn><mspace width="0.2em"></mspace><mtext>C/s</mtext><mspace width="0.2em"></mspace><mo>·</mo><mtext>h</mtext></mrow><mo>)</mo></mrow><mrow><mo>(</mo><mrow><mfrac><mrow><mn>3600</mn><mspace width="0.2em"></mspace><mtext>s</mtext></mrow><mrow><mn>1</mn><mspace width="0.2em"></mspace><mtext>h</mtext></mrow></mfrac></mrow><mo>)</mo></mrow><mo stretchy="false">(</mo><mn>12.0</mn><mspace width="0.2em"></mspace><mtext>J/C)</mtext></mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mn>3.00</mn><mspace width="0.2em"></mspace><mo>×</mo><mspace width="0.2em"></mspace><msup><mrow><mn>10</mn></mrow><mn>8</mn></msup><mspace width="0.2em"></mspace><mtext>m/s)</mtext></mrow><mn>2</mn></msup></mrow></mfrac></mtd></mtr><mtr><mtd></mtd><mtd columnalign="left"><mo>=</mo><mn>2.88</mn><mspace width="0.2em"></mspace><mo>×</mo><mspace width="0.2em"></mspace><msup><mn>10</mn><mrow><mn>−10</mn></mrow></msup><mspace width="0.2em"></mspace><mtext>kg.</mtext></mtd></mtr></mtable></mrow><annotation-xml encoding="MathML-Content"><mtable><mtr><mtd columnalign="left"><mtext>Δ</mtext><mi>m</mi></mtd><mtd columnalign="left"><mo>=</mo><mfrac><mrow><mrow><mo>(</mo><mrow><mn>600</mn><mspace width="0.2em"></mspace><mtext>C/s</mtext><mspace width="0.2em"></mspace><mo>·</mo><mtext>h</mtext></mrow><mo>)</mo></mrow><mrow><mo>(</mo><mrow><mfrac><mrow><mn>3600</mn><mspace width="0.2em"></mspace><mtext>s</mtext></mrow><mrow><mn>1</mn><mspace width="0.2em"></mspace><mtext>h</mtext></mrow></mfrac></mrow><mo>)</mo></mrow><mo stretchy="false">(</mo><mn>12.0</mn><mspace width="0.2em"></mspace><mtext>J/C)</mtext></mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mn>3.00</mn><mspace width="0.2em"></mspace><mo>×</mo><mspace width="0.2em"></mspace><msup><mrow><mn>10</mn></mrow><mn>8</mn></msup><mspace width="0.2em"></mspace><mtext>m/s)</mtext></mrow><mn>2</mn></msup></mrow></mfrac></mtd></mtr><mtr><mtd></mtd><mtd columnalign="left"><mo>=</mo><mn>2.88</mn><mspace width="0.2em"></mspace><mo>×</mo><mspace width="0.2em"></mspace><msup><mn>10</mn><mrow><mn>−10</mn></mrow></msup><mspace width="0.2em"></mspace><mtext>kg.</mtext></mtd></mtr></mtable></annotation-xml></semantics></math></div>
where we have used the conversion <math display="inline"><semantics><mrow><mrow><mn>1</mn><mspace width="0.2em"></mspace><mtext>kg</mtext><mo>·</mo><msup><mtext>m</mtext><mn>2</mn></msup><msup><mrow><mtext>/s</mtext></mrow><mn>2</mn></msup><mo>=</mo><mn>1</mn><mspace width="0.2em"></mspace><mtext>J</mtext><mtext>.</mtext></mrow></mrow><annotation-xml encoding="MathML-Content"><mrow><mn>1</mn><mspace width="0.2em"></mspace><mtext>kg</mtext><mo>·</mo><msup><mtext>m</mtext><mn>2</mn></msup><msup><mrow><mtext>/s</mtext></mrow><mn>2</mn></msup><mo>=</mo><mn>1</mn><mspace width="0.2em"></mspace><mtext>J</mtext><mtext>.</mtext></mrow></annotation-xml></semantics></math></li>
</ol>
