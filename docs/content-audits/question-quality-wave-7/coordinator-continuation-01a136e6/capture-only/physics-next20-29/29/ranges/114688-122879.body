n>2</mn></msup></mrow></mtd></mtr></mtable></mrow><annotation-xml encoding="MathML-Content"><mtable><mtr><mtd columnalign="right"><mi>K</mi></mtd>
<mtd columnalign="left"><mo>=</mo><mrow><mfrac><mrow><mi>m</mi><msup><mi>u</mi><mn>2</mn></msup></mrow>
<mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msup><mrow><mrow><mo>(</mo><mrow><mi>u</mi><mtext>/</mtext><mi>c</mi></mrow><mo>)</mo></mrow></mrow><mn>2</mn></msup></mrow></msqrt></mrow></mfrac></mrow><msubsup><mo>|</mo><mn>0</mn><mi>u</mi></msubsup><mo>−</mo><mi>m</mi><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mfrac><mi>u</mi><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msup><mrow><mrow><mo>(</mo><mrow><mi>u</mi><mtext>/</mtext><mi>c</mi></mrow><mo>)</mo></mrow></mrow><mn>2</mn></msup></mrow></msqrt></mrow></mfrac><mspace width="0.2em"></mspace><mfrac><mrow><mi>d</mi><mi>u</mi></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac><mspace width="0.2em"></mspace><mi>d</mi><mi>t</mi></mrow></mrow></mstyle></mtd></mtr>

<mtr><mtd columnalign="right"><mi>K</mi></mtd><mtd columnalign="left"><mo>=</mo><mrow><mfrac><mrow><mi>m</mi><msup><mi>u</mi><mn>2</mn></msup></mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msup><mrow><mrow><mo>(</mo><mrow><mi>u</mi><mtext>/</mtext><mi>c</mi></mrow><mo>)</mo></mrow></mrow><mn>2</mn></msup></mrow></msqrt></mrow></mfrac><mo>−</mo><mi>m</mi><mo>∫</mo><mfrac><mrow><mi>u</mi><mspace width="0.2em"></mspace><mi>du</mi></mrow><mrow><msqrt><mn>1</mn><mo>–</mo><mo>(</mo><mi>u</mi><mtext>/</mtext><mi>c</mi><msup><mo>)</mo><mn>2</mn></msup></msqrt></mrow></mfrac></mrow></mtd></mtr>

<mtr><mtd></mtd><mtd columnalign="left"><mo>=</mo><mrow><mfrac><mrow><mi>m</mi><msup><mi>u</mi><mn>2</mn></msup></mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msup><mrow><mrow><mo>(</mo><mrow><mi>u</mi><mtext>/</mtext><mi>c</mi></mrow><mo>)</mo></mrow></mrow><mn>2</mn></msup></mrow></msqrt></mrow></mfrac><mo>−</mo><mi>m</mi><mo>[</mo><mo>–</mo><msup><mi>c</mi><mn>2</mn></msup><msqrt><mn>1</mn><mo>–</mo><mo>(</mo><mi>u</mi><mtext>/</mtext><mi>c</mi><msup><mo>)</mo><mn>2</mn></msup></msqrt><msubsup><mo>]</mo><mn>0</mn><mi>u</mi></msubsup></mrow></mtd></mtr>

<mtr><mtd></mtd><mtd columnalign="left"><mo>=</mo><mrow><mfrac><mrow><mi>m</mi><msup><mi>u</mi><mn>2</mn></msup></mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msup><mrow><mrow><mo>(</mo><mrow><mi>u</mi><mtext>/</mtext><mi>c</mi></mrow><mo>)</mo></mrow></mrow><mn>2</mn></msup></mrow></msqrt></mrow></mfrac><mo>+</mo><mi>m</mi><msup><mi>c</mi><mn>2</mn></msup><mo>[</mo><msqrt><mn>1</mn><mo>–</mo><mo>(</mo><mi>u</mi><mtext>/</mtext><mi>c</mi><msup><mo>)</mo><mn>2</mn></msup></msqrt><msubsup><mo>]</mo><mn>0</mn><mi>u</mi></msubsup></mrow></mtd></mtr>

<mtr><mtd></mtd><mtd columnalign="left"><mo>=</mo><mrow><mfrac><mrow><mi>m</mi><msup><mi>u</mi><mn>2</mn></msup></mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msup><mrow><mrow><mo>(</mo><mrow><mi>u</mi><mtext>/</mtext><mi>c</mi></mrow><mo>)</mo></mrow></mrow><mn>2</mn></msup></mrow></msqrt></mrow></mfrac><mo>+</mo><mi>m</mi><msup><mi>c</mi><mn>2</mn></msup><mo>(</mo><msqrt><mn>1</mn><mo>–</mo><mo>(</mo><mi>u</mi><mtext>/</mtext><mi>c</mi><msup><mo>)</mo><mn>2</mn></msup></msqrt><mspace width="0.2em"></mspace><mo>–</mo><mn>1</mn><mo>)</mo></mrow></mtd></mtr>

<mtr><mtd></mtd><mtd columnalign="left"><mo>=</mo><mrow><mfrac><mrow><mi>m</mi><msup><mi>u</mi><mn>2</mn></msup></mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msup><mrow><mrow><mo>(</mo><mrow><mi>u</mi><mtext>/</mtext><mi>c</mi></mrow><mo>)</mo></mrow></mrow><mn>2</mn></msup></mrow></msqrt></mrow></mfrac><mo>+</mo><mfrac><mrow><mi>m</mi><msup><mi>c</mi><mn>2</mn></msup><mo>(</mo><mn>1</mn><mo>–</mo><mo>(</mo><mi>u</mi><mtext>/</mtext><mi>c</mi><msup><mo>)</mo><mn>2</mn></msup><mo>)</mo></mrow><mrow><msqrt><mn>1</mn><mo>–</mo><mo>(</mo><mi>u</mi><mtext>/</mtext><mi>c</mi><msup><mo>)</mo><mn>2</mn></msup></msqrt></mrow></mfrac><mo>–</mo><mi>m</mi><msup><mi>c</mi><mn>2</mn></msup></mrow></mtd></mtr>

<mtr><mtd></mtd><mtd columnalign="left"><mo>=</mo><mrow><mfrac><mrow><mi>m</mi><msup><mi>c</mi><mn>2</mn></msup></mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msup><mrow><mrow><mo>(</mo><mrow><mi>u</mi><mtext>/</mtext><mi>c</mi></mrow><mo>)</mo></mrow></mrow><mn>2</mn></msup></mrow></msqrt></mrow></mfrac><mo>–</mo><mi>m</mi><msup><mi>c</mi><mn>2</mn></msup></mrow></mtd></mtr>

<mtr><mtd columnalign="right"><mi>K</mi></mtd><mtd columnalign="left"><mo>=</mo><mrow><mo>(</mo><mi>γ</mi><mspace width="0.2em"></mspace><mo>–</mo><mspace width="0.2em"></mspace><mn>1</mn><mo>)</mo><mi>m</mi><msup><mi>c</mi><mn>2</mn></msup></mrow></mtd></mtr></mtable></annotation-xml></semantics></math></div>

<div data-type="note" id="fs-id1167794328350" class="ui-has-child-title"><header><h3 class="os-title" data-type="title">
  <span class="os-title-label" data-type="">Relativistic Kinetic Energy</span>
</h3></header><section>
<div class="os-note-body">
<p id="fs-id1167793840214"><span data-type="term" id="term-00001" group-by="R">Relativistic kinetic energy</span> of any particle of mass <em data-effect="italics">m</em> is</p>
<div data-type="equation" id="fs-id1167794210641"><math display="block"><semantics><mrow><mrow><msub><mi>K</mi><mrow><mtext>rel</mtext></mrow></msub><mo>=</mo><mo stretchy="false">(</mo><mi>γ</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><mi>m</mi><msup><mi>c</mi><mn>2</mn></msup><mo>.</mo></mrow></mrow><annotation-xml encoding="MathML-Content"><mrow><msub><mi>K</mi><mrow><mtext>rel</mtext></mrow></msub><mo>=</mo><mo stretchy="false">(</mo><mi>γ</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><mi>m</mi><msup><mi>c</mi><mn>2</mn></msup><mo>.</mo></mrow></annotation-xml></semantics></math><div class="os-equation-number">
  <span class="os-number">5.8</span>
</div>
</div>
</div></section></div>
<p id="fs-id1167793450493">When an object is motionless, its speed is <span class="os-math-in-para"><math display="inline"><semantics><mrow><mrow><mi>u</mi><mo>=</mo><mn>0</mn></mrow></mrow><annotation-xml encoding="MathML-Content"><mrow><mi>u</mi><mo>=</mo><mn>0</mn></mrow></annotation-xml></semantics></math></span> and</p>
<div data-type="equation" id="fs-id1167794023693" class="unnumbered" data-label=""><math display="block"><semantics><mrow><mrow><mi>γ</mi><mo>=</mo><mfrac><mn>1</mn><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msup><mi>u</mi><mn>2</mn></msup></mrow><mrow><msup><mi>c</mi><mn>2</mn></msup></mrow></mfrac></mrow></msqrt></mrow></mfrac><mo>=</mo><mn>1</mn></mrow></mrow><annotation-xml encoding="MathML-Content"><mrow><mi>γ</mi><mo>=</mo><mfrac><mn>1</mn><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><msup><mi>u</mi><mn>2</mn></msup></mrow><mrow><msup><mi>c</mi><mn>2</mn></msup></mrow></mfrac></mrow></msqrt></mrow></mfrac><mo>=</mo><mn>1</mn></mrow></annotation-xml></semantics></math></div>
<p id="fs-id1167794118697">so that <span class="os-math-in-para"><math display="inline"><semantics><mrow><mrow><msub><mi>K</mi><mrow><mtext>rel</mtext></mrow></msub><mo>=</mo><mn>0</mn></mrow></mrow><annotation-xml encoding="MathML-Content"><mrow><msub><mi>K</mi><mrow><mtext>rel</mtext></mrow></msub><mo>=</mo><mn>0</mn></mrow></annotation-xml></semantics></math></span> at rest, as expected. But the expression for relativistic kinetic energy (such as total energy and rest energy) does not look much like the classical <span class="os-math-in-para"><math display="inline"><semantics><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mspace width="0.2em"></mspace><mi>m</mi><msup><mi>u</mi><mn>2</mn></msup><mo>.</mo></mrow></mrow><annotation-xml encoding="MathML-Content"><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mspace width="0.2em"></mspace><mi>m</mi><msup><mi>u</mi><mn>2</mn></msup><mo>.</mo></mrow></annotation-xml></semantics></math></span> To show that the expression for <span class="os-math-in-para"><math display="inline"><semantics><mrow><mrow><msub><mi>K</mi><mrow><mtext>rel</mtext></mrow></msub></mrow></mrow><annotation-xml encoding="MathML-Content"><mrow><msub><mi>K</mi><mrow><mtext>rel</mtext></mrow></msub></mrow></annotation-xml></semantics></math></span> reduces to the classical expression for