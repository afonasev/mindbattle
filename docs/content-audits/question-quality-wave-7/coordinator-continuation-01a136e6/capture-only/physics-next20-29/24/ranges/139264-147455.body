</div></main><div class="prev-next-bar-wrapper disable-print" data-analytics-region="prev-next" style="--text-color:#424242;--text-regular-line-height:2.5rem;--content-text-width:82.5rem;--neutral-darkest:#e5e5e5"><a data-testid="content-link-test" href="13-1-faradays-law" class="content-link prev-next-link side-left" style="--link-color:#027EB5;--link-hover:#0064A0" aria-label="Previous Page" data-analytics-label="prev"><svg class="prev-next-icon left-arrow" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"></path></svg>Previous</a><a data-testid="content-link-test" href="13-3-motional-emf" class="content-link prev-next-link side-right" style="--link-color:#027EB5;--link-hover:#0064A0" aria-label="Next Page" data-analytics-label="next">Next<svg class="prev-next-icon right-arrow" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M10.707 17.707 16.414 12l-5.707-5.707-1.414 1.414L13.586 12l-4.293 4.293z"></path></svg></a></div><div class="buy-book-alignment disable-print" style="--buy-book-max-width:82.5rem"><a class="buy-book-link" target="_blank" rel="noopener noreferrer" href="https://he.kendallhunt.com/product/openstax-university-physics-vol-2-hardcover?utm_source=openstax&amp;utm_medium=website&amp;utm_campaign=rex