n></msub><mi>n</mi><mi>I</mi><mo>,</mo></mrow></annotation-xml></semantics></math></span> the flux through each turn of the small coil is
<div data-type="equation" id="fs-id1171242547782" class="unnumbered" data-label=""><math display="block"><semantics><mrow><mrow><msub><mtext>Φ</mtext><mtext>m</mtext></msub><mo>=</mo><msub><mi>μ</mi><mn>0</mn></msub><mi>n</mi><mi>I</mi><mrow><mo>(</mo><mrow><mfrac><mrow><mi>π</mi><msup><mi>d</mi><mn>2</mn></msup></mrow><mn>4</mn></mfrac></mrow><mo>)</mo></mrow><mo>,</mo></mrow></mrow><annotation-xml encoding="MathML-Content"><mrow><msub><mtext>Φ</mtext><mtext>m</mtext></msub><mo>=</mo><msub><mi>μ</mi><mn>0</mn></msub><mi>n</mi><mi>I</mi><mrow><mo>(</mo><mrow><mfrac><mrow><mi>π</mi><msup><mi>d</mi><mn>2</mn></msup></mrow><mn>4</mn></mfrac></mrow><mo>)</mo></mrow><mo>,</mo></mrow></annotation-xml></semantics></math></div>
<p id="fs-id1171239839678">where <em data-effect="italics">d</em> is the diameter of the coil. Now from Faraday’s law, the magnitude of the emf induced in the coil is</p>
<div data-type="equation" id="fs-id1171242238732" class="unnumbered" data-label=""><math display="block"><semantics><mrow><mtable><mtr></mtr><mtr></mtr><mtr><mtd columnalign="right"><mi>ε</mi></mtd><mtd columnalign="left"><mo>=</mo><mrow><mo>|</mo><mrow><mi>N</mi><mfrac><mrow><mi>d</mi><msub><mtext>Φ</mtext><mtext>m</mtext></msub></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac></mrow><mo>|</mo></mrow><mo>=</mo><mrow><mo>|</mo><mrow><mi>N</mi><msub><mi>μ</mi><mn>0</mn></msub><mi>n</mi><mfrac><mrow><mi>π</mi><msup><mi>d</mi><mn>2</mn></msup></mrow><mn>4</mn></mfrac><mspace width="0.2em"></mspace><mfrac><mrow><mi>d</mi><mi>I</mi></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac></mrow><mo>|</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd columnalign="left"><mo>=</mo><mn>20</mn><mrow><mo>(</mo><mrow><mn>4</mn><mi>π</mi><mspace width="0.2em"></mspace><mo>×</mo><mspace width="0.2em"></mspace><msup><mrow><mn>10</mn></mrow><mrow><mn>−7</mn></mrow></msup><mspace width="0.2em"></mspace><mtext>T</mtext><mo>·</mo><mtext>m/s</mtext></mrow><mo>)</mo></mrow><mrow><mo>(</mo><mrow><mn>2000</mn><msup><mrow><mspace width="0.2em"></mspace><mtext>m</mtext></mrow><mrow><mtext>-1</mtext></mrow></msup></mrow><mo>)</mo></mrow><mfrac><mrow><mi>π</mi><msup><mrow><mo stretchy="false">(</mo><mn>0.010</mn><mspace width="0.2em"></mspace><mtext>m</mtext><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mn>4</mn></mfrac><mrow><mo>(</mo><mrow><mn>3.0</mn><mspace width="0.2em"></mspace><mtext>A/s</mtext></mrow><mo>)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd columnalign="left"><mo>=</mo><mn>1.2</mn><mspace width="0.2em"></mspace><mo>×</mo><mspace width="0.2em"></mspace><msup><mn>10</mn><mrow><mn>−5</mn></mrow></msup><mspace width="0.2em"></mspace><mtext>V</mtext><mtext>.</mtext></mtd></mtr></mtable></mrow><annotation-xml encoding="MathML-Content"><mtable><mtr></mtr><mtr></mtr><mtr><mtd columnalign="right"><mi>ε</mi></mtd><mtd columnalign="left"><mo>=</mo><mrow><mo>|</mo><mrow><mi>N</mi><mfrac><mrow><mi>d</mi><msub><mtext>Φ</mtext><mtext>m</mtext></msub></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac></mrow><mo>|</mo></mrow><mo>=</mo><mrow><mo>|</mo><mrow><mi>N</mi><msub><mi>μ</mi><mn>0</mn></msub><mi>n</mi><mfrac><mrow><mi>π</mi><msup><mi>d</mi><mn>2</mn></msup></mrow><mn>4</mn></mfrac><mspace width="0.2em"></mspace><mfrac><mrow><mi>d</mi><mi>I</mi></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac></mrow><mo>|</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd columnalign="left"><mo>=</mo><mn>20</mn><mrow><mo>(</mo><mrow><mn>4</mn><mi>π</mi><mspace width="0.2em"></mspace><mo>×</mo><mspace width="0.2em"></mspace><msup><mrow><mn>10</mn></mrow><mrow><mn>−7</mn></mrow></msup><mspace width="0.2em"></mspace><mtext>T</mtext><mo>·</mo><mtext>m/s</mtext></mrow><mo>)</mo></mrow><mrow><mo>(</mo><mrow><mn>2000</mn><msup><mrow><mspace width="0.2em"></mspace><mtext>m</mtext></mrow><mrow><mtext>-1</mtext></mrow></msup></mrow><mo>)</mo></mrow><mfrac><mrow><mi>π</mi><msup><mrow><mo stretchy="false">(</mo><mn>0.010</mn><mspace width="0.2em"></mspace><mtext>m</mtext><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mn>4</mn></mfrac><mrow><mo>(</mo><mrow><mn>3.0</mn><mspace width="0.2em"></mspace><mtext>A/s</mtext></mrow><mo>)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd columnalign="left"><mo>=</mo><mn>1.2</mn><mspace width="0.2em"></mspace><mo>×</mo><mspace width="0.2em"></mspace><msup><mn>10</mn><mrow><mn>−5</mn></mrow></msup><mspace width="0.2em"></mspace><mtext>V</mtext><mtext>.</mtext></mtd></mtr></mtable></annotation-xml></semantics></math></div>
<p id="fs-id1171242501795"></p><h4 data-type="title">Significance</h4>
When the current is turned on in a vertical solenoid, as shown in <a href="13-2-lenzs-law#CNX_UPhysics_30_02_JRing" class="autogenerated-content" aria-label="View Figure 13.10">Figure 13.10</a>, the ring has an induced emf from the solenoid’s changing magnetic flux that opposes the change. The result is that the ring is fired vertically into the air.
<div class="os-figure" id="CNX_UPhysics_30_02_JRing"><figure data-id="CNX_UPhysics_30_02_JRing" class="ui-has-child-figcaption">
<span data-type="media" id="fs-id1171242464680" data-alt="Figure is a photograph of a thin metal ring levitating above the vertical solenoid.">
<button type="button" aria-label="Click to enlarge image of Figure is a photograph of a thin metal ring levitating above the vertical solenoid." class="image-button-wrapper"><img src="/apps/image-cdn/v1/f=webp/apps/archive/20260604.144757/resources/b0d847510ee92ae5fcb7de9ea4b22fe8b38a9594" data-media-type="image/jpeg" alt="Figure is a photograph of a thin metal ring levitating above the vertical solenoid." width="348" height="581" loading="lazy" data-original-src="/apps/archive/20260604.144757/resources/b0d847510ee92ae5fcb7de9ea4b22fe8b38a9594"></button>
</span>

<figcaption class="os-caption-container">
  <span class="os-title-label">Figure </span>
<span class="os-number">13.10</span>



  <span class="os-divider"> </span>
  <span class="os-caption">The jumping ring. When a current is turned on in the vertical solenoid, a current is induced in the metal ring. The stray field produced by the solenoid causes the ring to jump off the solenoid.</span>
</figcaption></figure></div>
</div></section></div>

