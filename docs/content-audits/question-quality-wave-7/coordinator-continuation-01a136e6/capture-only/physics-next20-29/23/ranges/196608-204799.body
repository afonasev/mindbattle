mspace><mo>×</mo><mspace width="0.25em"></mspace><msup>
     <mrow>
      <mn>10</mn></mrow>
     <mrow>
      <mn>−13</mn></mrow>
    </msup>
    <mtext>N</mtext></mrow>
  <mo>)</mo></mrow><mover accent="true">
   <mi>z</mi>
   <mo>^</mo>
  </mover>
  <mtext>.</mtext>
  </mrow>
</mrow><annotation-xml encoding="MathML-Content"><mrow>
  <mrow><mo>(</mo>
   <mrow>
    <mn>9.6</mn><mspace width="0.25em"></mspace><mo>×</mo><mspace width="0.25em"></mspace><msup>
     <mrow>
      <mn>10</mn></mrow>
     <mrow>
      <mn>−13</mn></mrow>
    </msup>
    <mtext>N</mtext></mrow>
  <mo>)</mo></mrow><mover accent="true">
   <mi>z</mi>
