    </mtd>
    <mtd columnalign="center">
     <mo>=</mo>
    </mtd>
    <mtd columnalign="left">
     <mrow>
      <mi>q</mi><mi>v</mi><mi>B</mi><mi>sin</mi><mi>θ</mi></mrow>
    </mtd>
   </mtr>
   <mtr rowalign="center">
    <mtd columnalign="right">
     <mrow></mrow>
    </mtd>
    <mtd columnalign="center">
     <mo>=</mo>
    </mtd>
    <mtd columnalign="left">
     <mrow>
      <mrow><mo>(</mo>
       <mrow>
        <mn>1.60</mn><mspace width="0.25em"></mspace><mo>×</mo><mspace width="0.25em"></mspace><msup>
         <mrow>
          <mn>10</mn></mrow>
         <mrow>
          <mn>−19</mn></mrow>
        </msup>
        <mtext>C</mtext></mrow>
      <mo>)</mo></mrow><mrow><mo>(</mo>
       <mrow>
        <mn>3.0</mn><mspace width="0.25em"></mspace><mo>×</mo><mspace width="0.25em"></mspace><msup>
         <mrow>
          <mn>10</mn></mrow>
         <mn>6</mn>
        </msup>
        <mtext>m/s</mtext></mrow>
      <mo>)</mo></mrow><mrow><mo>(</mo>
       <mrow>
        <mn>2.0</mn><mspace width="0.3em"></mspace><mtext>T</mtext></mrow>
      <mo>)</mo></mrow><mi>sin</mi><mrow><mo>(</mo>
       <mrow>
        <mn>90°</mn></mrow>
      <mo>)</mo></mrow></mrow>
    </mtd>
   </mtr>
   <mtr rowalign="center">
    <mtd columnalign="right">
     <mrow></mrow>
    </mtd>
    <mtd columnalign="center">
     <mo>=</mo>
    </mtd>
    <mtd columnalign="left">
     <mrow>
      <mn>9.6</mn><mspace width="0.25em"></mspace><mo>×</mo><mspace width="0.25em"></mspace><msup>
       <mrow>
        <mn>10</mn></mrow>
       <mrow>
        <mn>−13</mn></mrow>
      </msup>
      <mtext>N.</mtext></mrow>
    </mtd>
   </mtr>

  </mtable></mrow>
</mrow><annotation-xml encoding="MathML-Content"><mrow>
  <mtable>
   <mtr rowalign="center">
    <mtd columnalign="right">
     <mi>F</mi>
    </mtd>
