row><mn>6</mn></mrow></msub></mrow><mrow></mrow></mrow></mrow><annotation-xml encoding="MathML-Content"><semantics><mrow><mrow><msub><mtext>UF</mtext><mrow><mn>6</mn></mrow></msub></mrow><mrow></mrow></mrow><annotation encoding="StarMath 5.0"> size 12{"UF" rSub { size 8{6} } } {}</annotation></semantics></annotation-xml></semantics></math></span>. (a) The molecular masses for <span class="os-math-in-para"><math display="inline"><semantics><mrow><mrow><mrow><mrow><msup><mrow></mrow><mrow><mtext>235</mtext></mrow></msup><mtext>U</mtext></mrow></mrow><mspace width="0.25em"></mspace><mrow></mrow></mrow></mrow><annotation-xml encoding="MathML-Content"><semantics><mrow><mrow><mrow><msup><mrow></mrow><mrow><mtext>235</mtext></mrow></msup><mtext>U</mtext></mrow></mrow><mspace width="0.25em"></mspace><mrow></mrow></mrow><annotation encoding="StarMath 5.0"> size 12{ {} rSup { size 8{"235"} } U} {}</annotation></semantics></annotation-xml></semantics></math></span><span class="os-math-in-para"><math display="inline"><semantics><mrow><mrow><mrow><msub><mtext>UF</mtext><mrow><mn>6</mn></mrow></msub></mrow><mrow></mrow></mrow></mrow><annotation-xml encoding="MathML-Content"><semantics><mrow><mrow><msub><mtext>UF</mtext><mrow><mn>6</mn></mrow></msub></mrow><mrow></mrow></mrow><annotation encoding="StarMath 5.0"> size 12{"UF" rSub { size 8{6} } } {}</annotation></semantics></annotation-xml></semantics></math></span> and <span class="os-math-in-para"><math display="inline"><semantics><mrow><mrow><mrow><mrow><msup><mrow></mrow><mrow><mtext>238</mtext></mrow></msup><mtext>U</mtext></mrow></mrow><mrow></mrow></mrow></mrow><annotation-xml encoding="MathML-Content"><semantics><mrow><mrow><mrow><msup><mrow></mrow><mrow><mtext>238</mtext></mrow></msup><mtext>U</mtext></mrow></mrow><mrow></mrow></mrow><annotation encoding="StarMath 5.0"> size 12{ {} rSup { size 8{"238"} } U} {}</annotation></semantics></annotation-xml></semantics></math></span><span class="os-math-in-para"><math display="inline"><semantics><mrow><mrow><mrow><mspace width="0.25em"></mspace><msub><mtext>UF</mtext><mrow><mn>6</mn></mrow></msub></mrow><mrow></mrow></mrow></mrow><annotation-xml encoding="MathML-Content"><semantics><mrow><mrow><mspace width="0.25em"></mspace><msub><mtext>UF</mtext><mrow><mn>6</mn></mrow></msub></mrow><mrow></mrow></mrow><annotation encoding="StarMath 5.0"> size 12{"UF" rSub { size 8{6} } } {}</annotation></semantics></annotation-xml></semantics></math></span> are 349.0 g/mol and 352.0 g/mol, respectively. What is the ratio of their average velocities? (b) At what temperature would their average velocities differ by 1.00 m/s? (c) Do your answers in this problem imply that this technique may be difficult? </p></div>
