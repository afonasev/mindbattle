<mtd>                          <mo stretchy="false">=</mo></mtd>
<mtd>
                  <mrow>

                      <mrow>
                        <mrow>

                          <mfrac>
                            <mrow>
                              <mn>1</mn>
                              <mtext>.</mtext>
                              <mrow>
                                <mtext>02</mtext>
                                <mo stretchy="false">×</mo>
                                <msup>
