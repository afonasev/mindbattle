                                    </mrow>

                                </msup>
                              </mrow><mspace width="0.25em"></mspace>
                              <mtext>J</mtext>
                            </mrow>
                            <mrow>
                              <mn>2</mn>
                              <mtext>.</mtext>
                              <mrow>
                                <mtext>50</mtext>
