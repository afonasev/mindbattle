>0</mn>
                    <mtext>.</mtext>
                    <mtext>408</mtext>
                    <mtext>,&nbsp;or&nbsp;</mtext>
                    <mtext>40</mtext>
                    <mtext>.</mtext>
                    <mn>8%</mn>
                    <mtext></mtext>
                    <mrow></mrow>
                  </mrow></mtd>
                </mtr>
              </mtable>
              <mrow></mrow>
            </mrow>
          </mrow>
      </mrow><annotation-xml encoding="MathML-Content"><semantics>
          <mrow>
