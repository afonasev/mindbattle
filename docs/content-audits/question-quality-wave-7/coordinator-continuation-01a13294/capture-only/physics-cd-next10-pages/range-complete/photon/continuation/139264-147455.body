</div></main><div class="prev-next-bar-wrapper disable-print" data-analytics-region="prev-next" style="--text-color:#424242;--text-regular-line-height:2.5rem;--content-text-width:82.5rem;--neutral-darkest:#e5e5e5"><a data-testid="content-link-test" href="29-1-quantization-of-energy" class="content-link prev-next-link side-left" style="--link-color:#027EB5;--link-hover:#0064A0" aria-label="Previous Page" data-analytics-label="prev"><svg class="prev-next-icon left-arrow" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"></path></svg>Previous</a><a data-testid="content-link-test" href="29-3-photon-energies-and-the-electromagnetic-spectrum" class="content-link prev-next-link side-right" style="--link-color:#027EB5;--link-hover:#0064A0" aria-label="Next Page" data-analytics-label="next">Next<svg class="prev-next-icon right-arrow" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M10.707 17.707 16.414 12l-5.707-5.707-1.414 1.414L13.586 12l-4.293 4.293z"></path></svg></a></div><div class="buy-book-alignment disable-print" style="--buy-book-max-width:82.5rem"><a class="buy-book-link" target="_blank" rel="noopener noreferrer" href="https://buyprint.openstax.org/college-physics-ap-courses?utm_source=openstax&amp;utm_medium=website&amp;utm_campaign=rex-page" data-analytics-label="buy-book" style="--buy-book-color:#d4450c">Order a print copy</a></div></div></div><details class="attribution-details" data-testid="attribution-details" data-analytics-region="attribution" style="--attribution-text-color:#424242;--link-color:#027EB5;--link-hover:#0064A0;--content-text-width:82.5rem"><summary class="attribution-summary" aria-label="Citation/Attribution" style="--attribution-text-color:#424242;--link-color:#027EB5;--link-hover:#0064A0"><svg class="details-expand-icon attribution-summary-icon attribution-expand-icon" viewBox="0 0 192 512" aria-hidden="true"><path fill="currentColor" d="M0 384.662V127.338c0-17.818 21.543-26.741 34.142-14.142l128.662 128.662c7.81 7.81 7.8