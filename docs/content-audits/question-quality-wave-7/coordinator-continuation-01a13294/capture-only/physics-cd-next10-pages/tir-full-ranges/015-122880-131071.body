">/</mo><msub><mi>n</mi><mrow><mn>1</mn></mrow></msub></mrow></mfenced></mrow></mrow></mrow></annotation-xml></semantics></math></span> can be used to find the critical angle <em data-effect="italics"><span class="os-math-in-para"><math display="inline"><semantics><mrow><mrow><mrow><msub><mi>θ</mi><mrow><mi>c</mi></mrow></msub></mrow><mrow></mrow></mrow></mrow><annotation-xml encoding="MathML-Content"><mrow><mrow><msub><mi>θ</mi><mrow><mi>c</mi></mrow></msub></mrow><mrow></mrow></mrow></annotation-xml></semantics></math></span></em>. Here, then, <span class="os-math-in-para"><math display="inline"><semantics><mrow><mrow><mrow><mrow><mrow><msub><mi>n</mi><mrow><mn>2</mn></mrow></msub><mo stretchy="false">=</mo><mn>1</mn></mrow><mtext>.</mtext><mtext>00</mtext></mrow></mrow></mrow></mrow><annotation-xml encoding="MathML-Content"><mrow><mrow><mrow><mrow><msub><mi>n</mi><mrow><mn>2</mn></mrow></msub><mo stretchy="false">=</mo><mn>1</mn></mrow><mtext>.</mtext><mtext>00</mtext></mrow></mrow></mrow></annotation-xml></semantics></math></span> and <span class="os-math-in-para"><math display="inline"><semantics><mrow><mrow><mrow><mrow><mrow><msub><mi>n</mi><mrow><mn>1</mn></mrow></msub><mo stretchy="false">=</mo><mn>1</mn></mrow><mtext>.</mtext><mtext>49</mtext></mrow></mrow></mrow></mrow><annotation-xml encoding="MathML-Content"><mrow><mrow><mrow><mrow><msub><mi>n</mi><mrow><mn>1</mn></mrow></msub><mo stretchy="false">=</mo><mn>1</mn></mrow><mtext>.</mtext><mtext>49</mtext></mrow></mrow></mrow></annotation-xml></semantics></math></span>.</p><p id="import-auto-id1329220"></p><h4 data-type="title">Solution</h4>
  
  <p id="import-auto-id3137583">The critical angle is given by </p>
  <div data-type="equation" id="eip-25"><math display="block"><semantics><mrow><mrow><mrow><mrow><mrow><msub><mi>θ</mi><mrow><mi>c</mi></mrow></msub><mo stretchy="false">=</mo><msup><mtext>sin</mtext><mrow><mrow><mo stretchy="false">−</mo><mn>1</mn></mrow></mrow></msup></mrow><mfenced open="(" close=")"><mrow><msub><mi>n</mi><mrow><mn>2</mn></mrow></msub><mo stretchy="false">/</mo><msub><mi>n</mi><mrow><mn>1</mn></mrow></msub></mrow></mfenced></mrow></mrow><mrow></mrow><mrow><mtext>.</mtext></mrow></mrow></mrow><annotation-xml encoding="MathML-Content"><mrow><mrow><mrow><mrow><msub><mi>θ</mi><mrow><mi>c</mi></mrow></msub><mo stretchy="false">=</mo><msup><mtext>sin</mtext><mrow><mrow><mo stretchy="false">−</mo><mn>1</mn></mrow></mrow></msup></mrow><mfenced open="(" close=")"><mrow><msub><mi>n</mi><mrow><mn>2</mn></mrow></msub><mo stretchy="false">/</mo><msub><mi>n</mi><mrow><mn>1</mn></mrow></msub></mrow></mfenced></mrow></mrow><mrow></mrow><mrow><mtext>.</mtext></mrow></mrow></annotation-xml></semantics></math><div class="os-equation-number">
  <span class="os-number">25.18</span>
</div>
