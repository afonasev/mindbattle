           </mrow>
                          </mfenced>
                          <mo stretchy="false">+</mo>
                          <mtext>32</mtext>
                        </mrow>
                      </mrow>
                    </mrow>
                    <mrow></mrow>
                  </mrow>
                  <annotation encoding="StarMath 5.0"> size 12{T \( °F \) = {  {9}  over  {5} }  left [T left (K right ) - "273" "." "15" right ]+"32"} {}</annotation>
                </semantics></annotation-xml></semantics></math>
            </td>
            <td>
              <math display="block"><semantics><mrow>
                <mrow>
