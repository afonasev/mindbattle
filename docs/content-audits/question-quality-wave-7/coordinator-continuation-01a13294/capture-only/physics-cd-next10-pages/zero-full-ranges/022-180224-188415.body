            <annotation encoding="StarMath 5.0"> size 12{T rSub { size 8{°R} } = {  {0 "." 8°R}  over  {°C} }  times T rSub { size 8{°C} }  "." } {}</annotation>
          </semantics></annotation-xml></semantics></math>
      <div class="os-equation-number">
