<main class="doc">




    <div class="sr-only">
      <h1 data-noindex>ICE 1: Der Wegweiser</h1>
       <p>Im Juni 1991 begann die Erfolgsstory des ICE</p>
    </div>





<link rel="stylesheet" type="text/css" href="/.resources/bahn-common-light/webresources/css/breadcrumb-BGuXLK0B.css"/>
<nav aria-label="Brotkrumen" class="breadcrumb-overview">
  <ol class="breadcrumb__list flex hidden-s hidden-xs">
