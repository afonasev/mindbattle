<td data-align="center">1−</td>
<td data-align="center">0.00055</td>
<td data-align="center">0.00091 <math display="inline"><semantics><mrow><mrow><mo>×</mo></mrow></mrow><annotation-xml encoding="MathML-Content"><mrow><mo>×</mo></mrow></annotation-xml></semantics></math> 10<sup>−24</sup></td>
</tr>
<tr valign="top">
<td data-align="center">proton</td>
<td data-align="center">nucleus</td>
<td data-align="center">1.602 <math display="inline"><semantics><mrow><mrow><mo>×</mo></mrow></mrow><annotation-xml encoding="MathML-Content"><mrow><mo>×</mo></mrow></annotation-xml></semantics></math>10<sup>−19</sup></td>
