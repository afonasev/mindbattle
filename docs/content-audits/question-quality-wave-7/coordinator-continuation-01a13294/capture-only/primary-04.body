<div id="bk6921426" class="b-plain c-space_normal c-sp-space_normal c-sp-padding_normal cssskin-_block_billboard" data-bk-id="bk6921426">
<div class=" column -column1">
<div class="articleTitle">
<p class=" c-body">Tomodachi&nbsp;Autumn 2014</p>
<p class="c-lead">&nbsp;</p>
<h1 class=" c-page_title">The Shinkansen, Japan’s High-Speed Rail,&nbsp;Is Full of Miracles</h1>
</div>
</div>
</div>
<div id="bk6923262" class="b-plain c-space_normal c-sp-space_normal c-sp-padding_normal cssskin-_block_billboard" data-bk-id="bk6923262">
<div class=" column -column1">
<div class="articleNavi">
<div class="indexList">
<div class=" c-body">
<div class="c-img   ">
<a href="../../2014/autumn2014/index_list.html" class="js-popup" data-width="800" data-height="2000" data-resize="true" data-pid="479583"><img src="../../_src/7939983/articlenaviindex.png?v=1578473167897" alt="" id="imgsrc7939983_1"></a>
</div>
</div>
</div>
<p class=" c-body"></p>
<ul id="fontSize">
<li class="title">Change<br>Text Size</li>
<li class="fontL"><img class="changeBtn" src="../../_userdata/image/article/fontL.png" alt="Leage"></li>
<li class="fontS"><img class="changeBtn" src="../../_userdata/image/article/fontS_ov.png" alt="small"></li>
