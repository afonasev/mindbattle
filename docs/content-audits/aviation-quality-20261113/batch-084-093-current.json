  "sources": {
    "dot-codeshare": {
      "url": "https://www.transportation.gov/policy/aviation-policy/licensing/code-sharing",
      "title": "U.S. DOT — Code Sharing",
      "locator": "Definition and authorization",
      "passage": "При код-шеринге перевозчик продаёт рейс другой авиакомпании под своим кодом."
    },
    "faa-autorotation": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/helicopter_flying_handbook/hfh_ch02.pdf",
      "title": "FAA — Helicopter Flying Handbook, гл. 2",
      "locator": "Autorotation",
      "passage": "При авторотации поток через диск винта идёт снизу вверх и поддерживает его вращение. Скорость снижения зависит от воздушной скорости."
    },
    "faa-elevator-control": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 6",
      "locator": "Elevator",
      "passage": "На многих лёгких самолётах руль высоты связан с колонкой управления механическими тягами или тросами."
    },
    "faa-flaps": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 6",
      "locator": "Secondary Flight Controls, Flaps",
      "passage": "Закрылки Фаулера выдвигаются назад, увеличивая площадь крыла, и наклоняются вниз."
    },
    "faa-rotor": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/helicopter_flying_handbook/hfh_ch04.pdf",
      "title": "FAA — Helicopter Flying Handbook, гл. 4",
      "locator": "Main Rotor System",
      "passage": "Несущие винты различают по способу крепления лопастей и их подвижности относительно втулки. Выделяют жёсткую, полужёсткую и шарнирную схемы."
    },
    "faa-rudder-control": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 6",
      "locator": "Rudder",
      "passage": "Пилот отклоняет руль направления педалями. При крене руль помогает согласовать поворот."
    },
    "faa-spoilers": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 5–6",
      "locator": "High Speed Flight Controls; Spoilers",
      "passage": "Спойлеры уменьшают подъёмную силу. После касания это увеличивает нагрузку на колёса и эффективность их тормозов. В полёте некоторые конструкции помогают управлять креном."
    },
    "faa-swashplate": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/helicopter_flying_handbook/hfh_ch04.pdf",
      "title": "FAA — Helicopter Flying Handbook, гл. 4",
      "locator": "Swash Plate Assembly",
      "passage": "У автомата перекоса есть неподвижная и вращающаяся части. Тяги передают движение изменяющего положение механизма лопастям."
    },
    "faa-tail-rotor": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/helicopter_flying_handbook/hfh_ch04.pdf",
      "title": "FAA — Helicopter Flying Handbook, гл. 4",
      "locator": "Antitorque System",
      "passage": "Рулевой винт служит для компенсации реактивного момента. Его тягу меняют, чтобы сохранить или изменить направление носа."
    },
    "iata-hub": {
      "url": "https://www.iata.org/en/iata-repository/publications/economic-reports/airlines-operate-key-hubs-for-growth-and-connectivity/",
      "title": "IATA — Airlines operate key hubs for growth and connectivity",
      "locator": "Connectivity and network economics",
      "passage": "Узловые аэропорты создают возможность пересадки между рейсами и позволяют увеличивать частоту некоторых рейсов за счёт объединения потоков."
    },
    "iata-interline": {
      "url": "https://www.iata.org/contentassets/e7a533819be440edbb1e49da96e0f2a8/guidance-document-on-baggage-standards-for-interline.pdf",
      "title": "IATA — Guidance Document on Baggage Standards for Interline",
      "locator": "§8 Passenger and Baggage Processing",
      "passage": "Интерлайн позволяет оформить передачу зарегистрированного багажа при стыковке на одном билете между участвующими перевозчиками. Для багажа применяют согласованные бирки."
    },
    "iata-network": {
      "url": "https://www.iata.org/contentassets/3fc4569936dd4b9eae3c3e5d09fae86e/iata-slots-white-paper-december-2024.pdf",
      "title": "IATA — Airport Slot Coordination White Paper",
      "locator": "Airline networks",
      "passage": "Узловая модель собирает пассажиров в пересадочном аэропорту. Модель прямых маршрутов связывает отдельные пары аэропортов."
    },
    "nasa-elevator": {
      "url": "https://www1.grc.nasa.gov/beginners-guide-to-aeronautics/airplane-parts-function/",
      "title": "NASA Glenn Research Center — Airplane Parts and Function",
      "locator": "Vertical and Horizontal Stabilizer",
      "passage": "Руль высоты на обычном самолёте управляет тангажом. В некоторых конструкциях управление тангажом обеспечивает цельноповоротная поверхность."
    },
    "nasa-rudder": {
      "url": "https://www1.grc.nasa.gov/beginners-guide-to-aeronautics/airplane-parts-function/",
      "title": "NASA Glenn Research Center — Airplane Parts and Function",
      "locator": "Vertical and Horizontal Stabilizer",
      "passage": "Руль направления закреплён на задней кромке вертикального стабилизатора и управляет поворотом носа влево и вправо."
    },
    "nps-earhart": {
      "url": "https://www.nps.gov/articles/amelia-earhart-birthplace.htm",
      "title": "National Park Service — Amelia Earhart Birthplace",
      "locator": "Aviation accomplishments",
      "passage": "Эрхарт первой среди женщин в одиночку перелетела Атлантику в мае 1932 года. Она также первой в одиночку пролетела из Гонолулу до Окленда в Калифорнии."
    },
    "nps-lindbergh": {
      "url": "https://www.nps.gov/articles/aviation-pioneers.htm",
      "title": "National Park Service — Aviation Pioneers",
      "locator": "Charles Lindbergh",
      "passage": "Линдберг до рекордного перелёта работал пилотом авиапочты. В 1927 году он один перелетел из Нью-Йорка в Париж на Spirit of St. Louis."
    },
    "nps-wright": {
      "url": "https://home.nps.gov/wrbr/learn/historyculture/thefirstflight.htm",
      "title": "National Park Service — 1903: The First Flight",
      "locator": "Wright Brothers, 17 December 1903",
      "passage": "Перед созданием Flyer братья Райт испытали планёры. Орвилл управлял самолётом в первом полёте, который длился 12 секунд."
    },
    "prlib-chkalov": {
      "url": "https://www.prlib.ru/history/619324",
      "title": "Президентская библиотека — Перелёт Москва — Северный полюс — Ванкувер",
      "locator": "Перелёты 1936 и 1937 годов",
      "passage": "В 1936 году Чкалов возглавил перелёт на остров Удд. В июне 1937 года он командовал экипажем АНТ-25 до Ванкувера в штате Вашингтон."
    }
  },
