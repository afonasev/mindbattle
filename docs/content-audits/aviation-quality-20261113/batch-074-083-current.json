  "sources": {
    "faa-accelerate": {
      "url": "https://www.faa.gov/sites/faa.gov/files/2022-11/takeoff_safety.pdf",
      "title": "FAA — Takeoff Safety Training Aid",
      "locator": "§2.3.1.1; Figures 7–8",
      "passage": "Схемы показывают дистанции от начала разбега до полной остановки или до достижения контрольной высоты после отказа двигателя."
    },
    "faa-balanced": {
      "url": "https://www.faa.gov/sites/faa.gov/files/2022-11/takeoff_safety.pdf",
      "title": "FAA — Takeoff Safety Training Aid",
      "locator": "§2.3.1.2; Figure 10 Balanced Field",
      "passage": "Сбалансированной называют длину при равенстве потребной дистанции продолженного и прерванного взлёта."
    },
    "faa-controller": {
      "url": "https://www.faa.gov/sites/faa.gov/files/2021-11/2018-ABA-200-CWP_2019_Report_508.pdf",
      "title": "FAA — Air Traffic Controller Workforce Plan",
      "locator": "Flight phases and controller positions",
      "passage": "Работа диспетчеров делится между управлением движением на земле, местным управлением, выдачей разрешений и передачей данных."
    },
    "faa-crew-training": {
      "url": "https://www.faa.gov/safety/people",
      "title": "FAA — Safety: The People",
      "locator": "The Flight Attendant; The Pilot",
      "passage": "Бортпроводники обучаются эвакуации и первой помощи. Пилоты проходят периодическую подготовку и проверки."
    },
    "faa-declared": {
      "url": "https://www.faa.gov/air_traffic/publications/aim_html/chap4_section_3.html",
      "title": "FAA — Aeronautical Information Manual",
      "locator": "§4-3-6 Declared Distances",
      "passage": "Различные доступные дистанции публикуются для каждого направления ВПП и могут отличаться от физической длины полосы."
    },
    "faa-elevator-control": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 6",
      "locator": "Elevator",
      "passage": "На многих лёгких самолётах руль высоты связан с колонкой управления механическими тягами или тросами."
    },
    "faa-flaps": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 6",
      "locator": "Secondary Flight Controls, Flaps",
      "passage": "Закрылки Фаулера выдвигаются назад, увеличивая площадь крыла, и наклоняются вниз."
    },
    "faa-mechanic": {
      "url": "https://www.faa.gov/mechanics/become",
      "title": "FAA — Become an Aviation Mechanic",
      "locator": "Certificate privileges and ratings",
      "passage": "Сертификат авиационного механика FAA может иметь допуск к работе с планером или силовой установкой или оба допуска."
    },
    "faa-oxygen": {
      "url": "https://www.faa.gov/blog/clearedfortakeoff/responding-airborne-emergencies",
      "title": "FAA — Responding to Airborne Emergencies",
      "locator": "Cabin depressurization",
      "passage": "При потере давления кислородные маски в кабине пассажиров выпускаются автоматически. Экипаж использует переносные маски в рамках своих обязанностей."
    },
    "faa-oxygen-type": {
      "url": "https://www.faa.gov/about/initiatives/cabin_safety/regs/tso",
      "title": "FAA — Cabin Safety Technical Standard Orders",
      "locator": "TSO C64, Passenger Oxygen Mask",
      "passage": "Среди сертифицируемых изделий есть пассажирские кислородные маски с непрерывной подачей кислорода."
    },
    "faa-rudder-control": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 6",
      "locator": "Rudder",
      "passage": "Пилот отклоняет руль направления педалями. При крене руль помогает согласовать поворот."
    },
    "faa-seatbelt": {
      "url": "https://www.faa.gov/documentLibrary/media/Advisory_Circular/AC_121-24E.pdf",
      "title": "FAA — AC 121-24E, Passenger Safety Information",
      "locator": "§A.4.1.3 Seatbelts",
      "passage": "Инструктаж объясняет застёгивание, подтягивание и расстёгивание. FAA рекомендует держать ремень застёгнутым, когда пассажир сидит."
    },
    "faa-slide": {
      "url": "https://www.faa.gov/evacuations",
      "title": "FAA — Passenger Evacuations",
      "locator": "Use the Evacuation Slide Safely",
      "passage": "Надувной трап позволяет спуститься из самолёта при эвакуации. Ручную кладь оставляют в салоне."
    },
    "faa-slide-raft": {
      "url": "https://www.faa.gov/lessonslearned/transportairplane/accidents/N160US",
      "title": "FAA — Airbus SAS A320-214",
      "locator": "Emergency Evacuation and Rescue; Ditching Equipment",
      "passage": "На A320 передние аварийные трапы могут служить плотами при посадке на воду."
    },
    "faa-spoilers": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 5–6",
      "locator": "High Speed Flight Controls; Spoilers",
      "passage": "Спойлеры уменьшают подъёмную силу. После касания это увеличивает нагрузку на колёса и эффективность их тормозов. В полёте некоторые конструкции помогают управлять креном."
    },
    "faa-vest": {
      "url": "https://www.faa.gov/documentLibrary/media/Advisory_Circular/AC_121-24E.pdf",
      "title": "FAA — AC 121-24E, Passenger Safety Information",
      "locator": "Appendix A, Flotation Equipment; Extended Overwater Operations",
      "passage": "Жилет может храниться под креслом, между креслами или сбоку. Объясняют порядок извлечения и надевания."
    },
    "nasa-elevator": {
      "url": "https://www1.grc.nasa.gov/beginners-guide-to-aeronautics/airplane-parts-function/",
      "title": "NASA Glenn Research Center — Airplane Parts and Function",
      "locator": "Vertical and Horizontal Stabilizer",
      "passage": "Руль высоты на обычном самолёте управляет тангажом. В некоторых конструкциях управление тангажом обеспечивает цельноповоротная поверхность."
    },
    "nasa-flaps": {
      "url": "https://www1.grc.nasa.gov/beginners-guide-to-aeronautics/airplane-parts-function/",
      "title": "NASA Glenn Research Center — Airplane Parts and Function",
      "locator": "Flaps and Spoilers",
      "passage": "Выпуск закрылков увеличивает подъёмную силу крыла для взлёта и посадки."
    }
  },
