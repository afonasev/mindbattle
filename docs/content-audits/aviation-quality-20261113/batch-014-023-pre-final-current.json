  "initialReceipt": "batch-014-023-initial.json",
  "sources": {
    "nasa": {
      "url": "https://www1.grc.nasa.gov/beginners-guide-to-aeronautics/airplane-parts-function/",
      "title": "NASA Glenn Research Center — Airplane Parts and Function",
      "locator": "Wings; Vertical and Horizontal Stabilizer; Fuselage",
      "passage": "У крыла возникает бо́льшая часть подъёмной силы, а законцовки снижают сопротивление. Киль и горизонтальный стабилизатор помогают сохранять устойчивость по рысканию и тангажу соответственно. На части самолётов топливо хранится в фюзеляже. В некоторых конструкциях горизонтальная поверхность оперения поворачивается целиком."
    },
    "faa-controls": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 6",
      "locator": "Chapter 6, Flight Controls",
      "passage": "Парные элероны на задней кромке обычно отклоняются в противоположные стороны. Дифференциальное отклонение вверх больше, чем вниз. Выпущенные предкрылки пропускают воздух через щель к верхней поверхности крыла, оттягивая отрыв потока."
    },
    "faa-slat": {
      "url": "https://www.faa.gov/lessons_learned/transport_airplane/accidents/B18616",
      "title": "FAA — Boeing B-737-800",
      "locator": "Boeing 737 Leading Edge Slats",
      "passage": "У предкрылков 737-800 есть промежуточное и полностью выпущенное положения. Они помогают выполнять взлёт и посадку на меньшей скорости."
    },
    "faa-trim-detailed": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 6",
      "locator": "Trim Systems, Trim Tabs",
      "passage": "Одно из распространённых устройств снимает постоянное усилие с органов управления с помощью небольшой подвижной поверхности на задней кромке руля высоты."
    },
    "nasa-four": {
      "url": "https://www1.grc.nasa.gov/beginners-guide-to-aeronautics/four-forces-on-an-airplane/",
      "title": "NASA Glenn Research Center — Four Forces on an Airplane",
      "locator": "Weight; Lift; Drag; Thrust",
      "passage": "Вес направлен к центру Земли и зависит от массы самолёта с грузом и топливом. Подъёмная сила перпендикулярна траектории относительно воздуха. Трение воздуха — один из источников сопротивления."
    },
    "nasa-motion": {
      "url": "https://www1.grc.nasa.gov/beginners-guide-to-aeronautics/equations-of-motion/",
      "title": "NASA Glenn Research Center — Equations of Motion",
      "locator": "Aircraft Motion, cruising flight",
      "passage": "В описанной модели установившегося горизонтального полёта подъёмная сила уравновешивает вес, тяга — сопротивление."
    },
    "nasa-ld": {
      "url": "https://www1.grc.nasa.gov/beginners-guide-to-aeronautics/lift-to-drag-ratio/",
      "title": "NASA Glenn Research Center — Lift to Drag Ratio",
      "locator": "The Lift Equation; the Drag Equation",
      "passage": "Коэффициенты подъёмной силы и сопротивления входят в уравнения. При неизменных коэффициентах и плотности обе силы пропорциональны квадрату скорости."
    },
    "nasa-drag": {
      "url": "https://www1.grc.nasa.gov/beginners-guide-to-aeronautics/what-is-drag/",
      "title": "NASA Glenn Research Center — What is Drag?",
      "locator": "Sources of Drag",
      "passage": "Сопротивление создают все поверхности. Источники включают трение и сопротивление формы."
    },
    "nasa-thrust": {
      "url": "https://www1.grc.nasa.gov/beginners-guide-to-aeronautics/what-is-thrust/",
      "title": "NASA Glenn Research Center — What is Thrust?",
      "locator": "Thrust; Accelerating Gas",
      "passage": "Двигатель создаёт тягу реакцией на ускорение массы газа. Величина зависит от потока и изменения его скорости."
    },
    "nasa-fuel": {
      "url": "https://www1.grc.nasa.gov/beginners-guide-to-aeronautics/maximum-flight-time-1/",
      "title": "NASA Glenn Research Center — Maximum Flight Time",
      "locator": "Maximum Time Aloft",
      "passage": "При сжигании топлива вес самолёта меняется."
    },
    "faa-glossary": {
      "url": "https://www.faa.gov/sites/faa.gov/files/21_phak_glossary.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, глоссарий",
      "locator": "Angle of attack; Angle of incidence",
      "passage": "Угол атаки измеряют между хордой и набегающим потоком. Угол установки — между хордой и продольной осью самолёта."
    },
    "nasa-geometry": {
      "url": "https://www1.grc.nasa.gov/beginners-guide-to-aeronautics/wing-geometry/",
      "title": "NASA Glenn Research Center — Wing Geometry",
      "locator": "Chord, sweep, dihedral",
      "passage": "В плане передняя и задняя кромки могут быть стреловидными. При положительном поперечном V законцовки выше корня."
    },
    "faa-stability": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 5",
      "locator": "Lateral Stability; Free Directional Oscillations (Dutch Roll)",
      "passage": "Поперечное V влияет на реакцию креном на скольжение. При голландском шаге связаны колебания по крену и рысканию, которые обычно идут не в одной фазе. На самолётах применяют демпферы рыскания."
    },
    "faa-mach": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 5",
      "locator": "High Speed Flight, Shock Waves",
      "passage": "Локальные скачки уплотнения меняют распределение давления и скос потока. Смещение центра давления крыла назад создаёт момент на опускание носа, Mach tuck."
    },
    "faa-altitude": {
      "url": "https://www.faa.gov/documentLibrary/media/Advisory_Circular/AC_61-107B_CHG_1_FAA.pdf",
      "title": "FAA — AC 61-107B, Aircraft Operations at High Altitude",
      "locator": "Mach Tuck; Q-Corner or Coffin Corner; buffet boundaries",
      "passage": "На большой высоте между низко- и высокоскоростным бафтингом может остаться малая разница. Высота и перегрузка меняют запас. Mach tuck означает появление момента на опускание носа при смещении центра давления назад."
    },
    "navy-phugoid": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/00-80T-80.pdf",
      "title": "U.S. Navy — Aerodynamics for Naval Aviators",
      "locator": "Longitudinal Dynamic Stability, pp. 279–281",
      "passage": "Фугоида — длительное продольное колебание скорости и высоты с почти неизменным углом атаки."
    },
    "faa-incidence-extra": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/amt_general_handbook.pdf",
      "title": "FAA — Aviation Maintenance Technician Handbook, General",
      "locator": "Aerodynamics, angle of incidence and washout",
      "passage": "При геометрической крутке угол установки меняется по размаху крыла."
    },
    "nasa-sweep": {
      "url": "https://www.nasa.gov/reference/openvsp-wings/",
      "title": "NASA — OpenVSP Wings",
      "locator": "Sweep angle and sweep location",
      "passage": "Стреловидность задают на выбранной доле хорды, в том числе на четверти хорды."
    },
    "faa-mach-auto": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/airplane_handbook/17_afh_ch16.pdf",
      "title": "FAA — Airplane Flying Handbook, гл. 16",
      "locator": "High-Speed Flight, Mach Tuck",
      "passage": "На многих скоростных реактивных самолётах предусмотрена автоматическая компенсация затягивания в пикирование."
    }
  },
