  "sources": {
    "faa-compressibility": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 5",
      "locator": "Sweepback; Mach Number versus Airspeed",
      "passage": "Стреловидность задерживает начало эффектов сжимаемости. Стреловидное крыло также может вносить вклад в путевую устойчивость."
    },
    "faa-dme": {
      "url": "https://www.faa.gov/air_traffic/publications/aim_html/chap1_section_1.html",
      "title": "FAA — Aeronautical Information Manual",
      "locator": "§1-1-7 Distance Measuring Equipment",
      "passage": "DME измеряет дальность по времени прохождения запроса и ответа. Дальность выражают в морских милях."
    },
    "faa-glossary": {
      "url": "https://www.faa.gov/sites/faa.gov/files/21_phak_glossary.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, глоссарий",
      "locator": "Angle of attack; Angle of incidence",
      "passage": "Угол атаки измеряют между хордой и набегающим потоком. Угол установки — между хордой и продольной осью самолёта."
    },
    "faa-ground-loop-compare": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/airplane_handbook/10_afh_ch9.pdf",
      "title": "FAA — Airplane Flying Handbook, гл. 9",
      "locator": "Ground Loop",
      "passage": "Самолёты с носовым колесом менее склонны к наземному развороту, чем самолёты с хвостовым колесом."
    },
    "faa-ils": {
      "url": "https://www.faa.gov/air_traffic/publications/aim_html/chap1_section_1.html",
      "title": "FAA — Aeronautical Information Manual",
      "locator": "§1-1-9 Instrument Landing System",
      "passage": "Курсовой маяк даёт боковое наведение для посадки, глиссадный — вертикальное. Эти передатчики работают в разных частотных диапазонах."
    },
    "faa-incidence-extra": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/amt_general_handbook.pdf",
