  "sources": {
    "faa-airspeed": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/phak/10_phak_ch8.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 8",
      "locator": "Airspeed Indicator; Airspeed Indicator Markings",
      "passage": "Механический указатель сравнивает полное и статическое давление. На циферблатах белая дуга показывает диапазон для выпущенных закрылков."
    },
    "faa-altimeter": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/phak/10_phak_ch8.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 8",
      "locator": "Altimeter; Effect of Nonstandard Pressure and Temperature",
      "passage": "Барометрический высотомер преобразует статическое давление в высоту. У механического прибора есть шкала опорного давления."
    },
    "faa-compass": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/phak/10_phak_ch8.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 8",
      "locator": "Magnetic Compass; Deviation",
      "passage": "Компас ориентируется по магнитному полю Земли. Остаточную девиацию указывают на карточке поправок."
    },
    "faa-components-drag": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 5",
      "locator": "Parasite Drag",
      "passage": "К паразитному сопротивлению относятся сопротивление формы, трение и интерференционное сопротивление. Плавные обтекатели помогают уменьшить сопротивление в местах стыка поверхностей."
    },
    "faa-dme": {
      "url": "https://www.faa.gov/air_traffic/publications/aim_html/chap1_section_1.html",
      "title": "FAA — Aeronautical Information Manual",
      "locator": "§1-1-7 Distance Measuring Equipment",
      "passage": "DME измеряет дальность по времени прохождения запроса и ответа. Дальность выражают в морских милях."
    },
    "faa-fuel-gauge": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 7",
      "locator": "Fuel Systems; Fuel Gauges",
      "passage": "Датчики в баках измеряют остаток топлива, который может отображаться в галлонах или фунтах."
    },
    "faa-ils": {
      "url": "https://www.faa.gov/air_traffic/publications/aim_html/chap1_section_1.html",
      "title": "FAA — Aeronautical Information Manual",
      "locator": "§1-1-9 Instrument Landing System",
      "passage": "Курсовой маяк даёт боковое наведение для посадки, глиссадный — вертикальное. Эти передатчики работают в разных частотных диапазонах."
    },
    "faa-ndb": {
      "url": "https://www.faa.gov/air_traffic/publications/aim_html/chap1_section_1.html",
      "title": "FAA — Aeronautical Information Manual",
      "locator": "§1-1-2 Nondirectional Radio Beacon",
      "passage": "Помехи от гроз или удалённых станций могут исказить показания ADF при приёме NDB."
    },
    "faa-takeoff-safe": {
      "url": "https://www.faa.gov/sites/faa.gov/files/2022-11/takeoff_safety.pdf",
      "title": "FAA — Takeoff Safety Training Aid",
      "locator": "§2.3.1.2–2.3.1.3",
      "passage": "V1 связывают с началом первого действия для остановки. VR — скорость, на которой начинается подъём носа."
    },
    "faa-v-speeds": {
      "url": "https://www.govinfo.gov/content/pkg/CFR-2025-title14-vol1/pdf/CFR-2025-title14-vol1-sec25-107.pdf",
      "title": "14 CFR §25.107 — Takeoff speeds",
      "locator": "§25.107(a), (c), (e)",
      "passage": "Определение V1 связано с отказом на VEF. VR не ниже V1, с учётом других ограничений. V2 выбирают с запасом над минимальными значениями."
    },
    "faa-vor": {
      "url": "https://www.faa.gov/air_traffic/publications/aim_html/chap1_section_1.html",
      "title": "FAA — Aeronautical Information Manual",
      "locator": "§1-1-3 VHF Omni-directional Range",
      "passage": "VOR передаёт сигналы в метровом диапазоне. Приём ограничен радиовидимостью и зависит от высоты."
    },
    "faa-vref": {
      "url": "https://www.faa.gov/lessons_learned/transport_airplane/accidents/N200WQ",
      "title": "FAA — Bombardier DHC-8-400",
      "locator": "Vref and approach speeds",
      "passage": "VREF зависит от посадочной конфигурации и служит основой расчёта нормальной скорости захода."
    },
    "nasa-induced": {
      "url": "https://www1.grc.nasa.gov/beginners-guide-to-aeronautics/induced-drag-coefficient/",
      "title": "NASA Glenn Research Center — Induced Drag Coefficient",
      "locator": "Induced Drag Coefficient",
      "passage": "При прочих равных коэффициент индуктивного сопротивления пропорционален квадрату коэффициента подъёмной силы и обратно пропорционален удлинению крыла."
    },
    "nasa-wave": {
      "url": "https://www1.grc.nasa.gov/beginners-guide-to-aeronautics/what-is-drag/",
      "title": "NASA Glenn Research Center — What is Drag?",
      "locator": "Wave and Ram Drag",
      "passage": "Скачки уплотнения около скорости звука дают волновое сопротивление. Его величина зависит от числа Маха."
    }
  },
