  "initialReceipt": "batch-064-073-initial.json",
  "sources": {
    "faa-accelerate": {
      "url": "https://www.faa.gov/sites/faa.gov/files/2022-11/takeoff_safety.pdf",
      "title": "FAA — Takeoff Safety Training Aid",
      "locator": "§2.3.1.1; Figures 7–8",
      "passage": "Схемы показывают дистанции от начала разбега до полной остановки или до достижения контрольной высоты после отказа двигателя."
    },
    "faa-attitude": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/phak/10_phak_ch8.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 8",
      "locator": "Attitude Indicator",
      "passage": "Авиагоризонт показывает крен и тангаж. В традиционной схеме используют гироскоп, условный силуэт самолёта и линию горизонта."
    },
    "faa-autorotation": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/helicopter_flying_handbook/hfh_ch02.pdf",
      "title": "FAA — Helicopter Flying Handbook, гл. 2",
      "locator": "Autorotation",
      "passage": "При авторотации поток через диск винта идёт снизу вверх и поддерживает его вращение. Скорость снижения зависит от воздушной скорости."
    },
    "faa-balanced": {
      "url": "https://www.faa.gov/sites/faa.gov/files/2022-11/takeoff_safety.pdf",
      "title": "FAA — Takeoff Safety Training Aid",
      "locator": "§2.3.1.2; Figure 10 Balanced Field",
      "passage": "Сбалансированной называют длину при равенстве потребной дистанции продолженного и прерванного взлёта."
    },
    "faa-declared": {
      "url": "https://www.faa.gov/air_traffic/publications/aim_html/chap4_section_3.html",
      "title": "FAA — Aeronautical Information Manual",
      "locator": "§4-3-6 Declared Distances",
      "passage": "Различные доступные дистанции публикуются для каждого направления ВПП и могут отличаться от физической длины полосы."
    },
    "faa-helicopter": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/helicopter_flying_handbook/hfh_ch02.pdf",
      "title": "FAA — Helicopter Flying Handbook, гл. 2",
      "locator": "Powered Flight; Hovering Flight; Translational Lift",
      "passage": "Несущий винт обеспечивает подъёмную силу при зависании. В поступательном полёте его эффективность возрастает."
    },
    "faa-pitot": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/phak/10_phak_ch8.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 8",
      "locator": "Impact Pressure; Blocked Pitot System",
      "passage": "Через приёмник Пито на прибор поступает полное давление. У некоторых приёмников есть обогрев, а дренаж отводит влагу."
    },
    "faa-rotor": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/helicopter_flying_handbook/hfh_ch04.pdf",
      "title": "FAA — Helicopter Flying Handbook, гл. 4",
      "locator": "Main Rotor System",
      "passage": "Несущие винты различают по способу крепления лопастей и их подвижности относительно втулки. Выделяют жёсткую, полужёсткую и шарнирную схемы."
    },
    "faa-static": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/phak/10_phak_ch8.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 8",
      "locator": "Static Pressure; Blocked Static System",
      "passage": "Статический порт сообщается с окружающим воздухом. Его засорение влияет на приборы, получающие от него давление."
    },
    "faa-swashplate": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/helicopter_flying_handbook/hfh_ch04.pdf",
      "title": "FAA — Helicopter Flying Handbook, гл. 4",
      "locator": "Swash Plate Assembly",
      "passage": "У автомата перекоса есть неподвижная и вращающаяся части. Тяги передают движение изменяющего положение механизма лопастям."
    },
    "faa-tail-rotor": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/helicopter_flying_handbook/hfh_ch04.pdf",
      "title": "FAA — Helicopter Flying Handbook, гл. 4",
      "locator": "Antitorque System",
      "passage": "Рулевой винт служит для компенсации реактивного момента. Его тягу меняют, чтобы сохранить или изменить направление носа."
    },
    "faa-turboshaft": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/helicopter_flying_handbook/hfh_ch04.pdf",
      "title": "FAA — Helicopter Flying Handbook, гл. 4",
      "locator": "Turbine Engine; Free Power Turbine",
      "passage": "В турбовальном двигателе мощность передаётся на вал. В конструкции со свободной турбиной силовая турбина может вращаться отдельно от вала газогенератора."
    },
    "faa-turn": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/phak/10_phak_ch8.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 8",
      "locator": "Turn Indicators; Inclinometer",
      "passage": "Указатель поворота показывает направление и угловую скорость. Шарик инклинометра показывает, согласован ли поворот."
    },
    "faa-v-speeds": {
      "url": "https://www.govinfo.gov/content/pkg/CFR-2025-title14-vol1/pdf/CFR-2025-title14-vol1-sec25-107.pdf",
      "title": "14 CFR §25.107 — Takeoff speeds",
      "locator": "§25.107(a), (c), (e)",
      "passage": "Определение V1 связано с отказом на VEF. VR не ниже V1, с учётом других ограничений. V2 выбирают с запасом над минимальными значениями."
    },
    "faa-v2-path": {
      "url": "https://www.govinfo.gov/content/pkg/CFR-2025-title14-vol1/pdf/CFR-2025-title14-vol1-sec25-111.pdf",
      "title": "14 CFR §25.111 — Takeoff path",
      "locator": "§25.111(c)(2)",
      "passage": "При сертификационном расчёте V2 требуется достичь к установленной высоте в начале набора с одним неработающим двигателем."
    },
    "faa-vref": {
      "url": "https://www.faa.gov/lessons_learned/transport_airplane/accidents/N200WQ",
      "title": "FAA — Bombardier DHC-8-400",
      "locator": "Vref and approach speeds",
      "passage": "VREF зависит от посадочной конфигурации и служит основой расчёта нормальной скорости захода."
    },
    "nasa-turbofan": {
      "url": "https://www.grc.nasa.gov/www/k-12/airplane/Animation/turbtyp/etft.html",
      "title": "NASA Glenn Research Center — Turbofan Engine",
      "locator": "Core and bypass airflow",
      "passage": "Вентилятор ускоряет часть воздуха, которая проходит вокруг газогенератора. Отношение этого потока к расходу воздуха через ядро называется степенью двухконтурности."
    },
    "nasa-turbojet": {
      "url": "https://www.grc.nasa.gov/www/k-12/airplane/trbtyp.html",
      "title": "NASA Glenn Research Center — Types of Gas Turbines",
      "locator": "Turbojet",
      "passage": "Пройдя компрессор, камеру сгорания и турбину, газ в одноконтурном турбореактивном двигателе расширяется в сопле и создаёт тягу."
    },
    "nasa-turbojet-history": {
      "url": "https://www.nasa.gov/altitude-wind-tunnel-post-war-engines/",
      "title": "NASA — Altitude Wind Tunnel: Post-War Engines",
      "locator": "Early turbojets",
      "passage": "На первых реактивных двигателях использовали как центробежные, так и осевые компрессоры."
    },
    "nasa-turboprop": {
      "url": "https://www.grc.nasa.gov/WWW/k-12/airplane/aturbp.html",
      "title": "NASA Glenn Research Center — Turboprop Engine",
      "locator": "Gas turbine core; Propeller",
      "passage": "В турбовинтовой установке дополнительная турбина через редуктор приводит воздушный винт. Пропеллер эффективен на умеренной скорости."
    }
  },
