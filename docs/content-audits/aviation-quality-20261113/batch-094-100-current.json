  "sources": {
    "dot-codeshare": {
      "url": "https://www.transportation.gov/policy/aviation-policy/licensing/code-sharing",
      "title": "U.S. DOT — Code Sharing",
      "locator": "Definition and authorization",
      "passage": "При код-шеринге перевозчик продаёт рейс другой авиакомпании под своим кодом."
    },
    "dot-disclosure": {
      "url": "https://www.transportation.gov/airconsumer/codeshare-disclosure",
      "title": "U.S. DOT — Codeshare Disclosure",
      "locator": "14 CFR Part 257",
      "passage": "Покупателя уведомляют, какая авиакомпания фактически выполняет рейс."
    },
    "faa-accelerate": {
      "url": "https://www.faa.gov/sites/faa.gov/files/2022-11/takeoff_safety.pdf",
      "title": "FAA — Takeoff Safety Training Aid",
      "locator": "§2.3.1.1; Figures 7–8",
      "passage": "Схемы показывают дистанции от начала разбега до полной остановки или до достижения контрольной высоты после отказа двигателя."
    },
    "faa-balanced": {
      "url": "https://www.faa.gov/sites/faa.gov/files/2022-11/takeoff_safety.pdf",
      "title": "FAA — Takeoff Safety Training Aid",
      "locator": "§2.3.1.2; Figure 10 Balanced Field",
      "passage": "Сбалансированной называют длину при равенстве потребной дистанции продолженного и прерванного взлёта."
    },
    "faa-declared": {
      "url": "https://www.faa.gov/air_traffic/publications/aim_html/chap4_section_3.html",
      "title": "FAA — Aeronautical Information Manual",
      "locator": "§4-3-6 Declared Distances",
      "passage": "Различные доступные дистанции публикуются для каждого направления ВПП и могут отличаться от физической длины полосы."
    },
    "faa-flutter": {
      "url": "https://www.faa.gov/documentLibrary/media/Advisory_Circular/AC_90-89B.pdf",
      "title": "FAA — AC 90-89B, Flight Testing Handbook",
      "locator": "§5-8 Flutter",
      "passage": "Флаттер возникает при взаимодействии аэродинамических сил, упругости и инерции. При превышении критического режима амплитуда может нарастать."
    },
    "faa-ground-effect": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 5",
      "locator": "Ground Effect",
      "passage": "Близость поверхности меняет обтекание крыла и уменьшает индуктивное сопротивление. При посадке это может удлинить выдерживание над полосой."
    },
    "faa-mach-buffet": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/airplane_handbook/17_afh_ch16.pdf",
      "title": "FAA — Airplane Flying Handbook, гл. 16",
      "locator": "Mach Buffet",
      "passage": "Поток отрывается за скачком уплотнения и вызывает вибрацию. Явление зависит от скорости воздуха непосредственно над крылом."
    },
    "iata-hub": {
      "url": "https://www.iata.org/en/iata-repository/publications/economic-reports/airlines-operate-key-hubs-for-growth-and-connectivity/",
      "title": "IATA — Airlines operate key hubs for growth and connectivity",
      "locator": "Connectivity and network economics",
      "passage": "Узловые аэропорты создают возможность пересадки между рейсами и позволяют увеличивать частоту некоторых рейсов за счёт объединения потоков."
    },
    "iata-interline": {
      "url": "https://www.iata.org/contentassets/e7a533819be440edbb1e49da96e0f2a8/guidance-document-on-baggage-standards-for-interline.pdf",
      "title": "IATA — Guidance Document on Baggage Standards for Interline",
      "locator": "§8 Passenger and Baggage Processing",
      "passage": "Интерлайн позволяет оформить передачу зарегистрированного багажа при стыковке на одном билете между участвующими перевозчиками. Для багажа применяют согласованные бирки."
    },
    "iata-network": {
      "url": "https://www.iata.org/contentassets/3fc4569936dd4b9eae3c3e5d09fae86e/iata-slots-white-paper-december-2024.pdf",
      "title": "IATA — Airport Slot Coordination White Paper",
      "locator": "Airline networks",
      "passage": "Узловая модель собирает пассажиров в пересадочном аэропорту. Модель прямых маршрутов связывает отдельные пары аэропортов."
    },
    "nasa-coanda": {
      "url": "https://www.nasa.gov/wp-content/uploads/2023/04/sp-4539.pdf",
      "title": "NASA — Upper Surface Blowing: Efficient, Quiet, Short Takeoff and Landing",
      "locator": "Upper Surface Blowing",
      "passage": "Эффект Коанда заставляет струю следовать кривизне близкой поверхности. Обдув сверху испытывали на YC-14 и QSRA."
    }
  },
