  "sources": {
    "nasa": {
      "url": "https://www1.grc.nasa.gov/beginners-guide-to-aeronautics/airplane-parts-function/",
      "title": "NASA Glenn Research Center — Airplane Parts and Function",
      "locator": "Wings; Vertical and Horizontal Stabilizer; Fuselage",
      "passage": "У крыла возникает бо́льшая часть подъёмной силы, а законцовки снижают сопротивление. Киль и горизонтальный стабилизатор помогают сохранять устойчивость по рысканию и тангажу соответственно. На части самолётов топливо хранится в фюзеляже. В некоторых конструкциях горизонтальная поверхность оперения поворачивается целиком."
    },
    "faa-fuselage": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 3",
      "locator": "Chapter 3, Aircraft Construction, Fuselage",
      "passage": "Фюзеляж — центральный корпус для экипажа, пассажиров и груза. С ним конструктивно соединены крылья и хвостовое оперение."
    },
    "faa-wing": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "locator": "Chapter 3, Aircraft Construction, Wings",
      "passage": "Крыло может располагаться в верхней, средней или нижней части фюзеляжа. Нервюры задают форму и толщину профиля крыла."
    },
    "faa-tail": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 3",
      "locator": "Chapter 3, Aircraft Construction, Empennage",
      "passage": "Хвостовое оперение включает неподвижные поверхности, в том числе вертикальный и горизонтальный стабилизаторы."
    },
    "faa-t-tail": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "locator": "Chapter 6, Flight Controls, T-Tail",
      "passage": "В Т-образной схеме горизонтальные поверхности оперения закреплены в верхней части вертикального стабилизатора."
    },
    "faa-gear": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "locator": "Chapter 3, Aircraft Construction, Landing Gear and Figure 3-12; Chapter 7, Retractable Landing Gear",
      "passage": "Для посадки на воду или снег самолёт может оснащаться шасси с поплавками или лыжами. Убираемое шасси в крейсерском полёте помещается внутри конструкции самолёта.",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 3"
    },
    "airbus-cockpit": {
      "url": "https://www.airbus.com/en/products-services/commercial-aircraft/cockpits",
      "title": "Airbus — Cockpits",
      "locator": "A220 Cockpit; cockpit commonality",
      "passage": "У A220 боковые ручки и бортовая система управления полётом. Airbus описывает схожую компоновку кабин своих семейств."
    },
    "airbus-cabin": {
      "url": "https://www.airbus.com/en/newsroom/press-releases/2021-09-airbus-new-single-aisle-airspace-cabin-enters-into-service-with",
      "title": "Airbus — Single-Aisle Airspace cabin",
      "locator": "Список особенностей салона",
      "passage": "Иллюминаторы с интегрированными шторками, увеличенные верхние багажные полки, светодиодное освещение."
    },
    "airbus-cargo": {
      "url": "https://www.aircraft.airbus.com/sites/g/files/jlcbta126/files/2023-12/ac_a320_1223.pdf",
      "title": "Airbus — A320 Aircraft Characteristics",
      "locator": "Cargo Compartments, Locations and Dimensions",
      "passage": "На схемах показаны отдельные передний и задний грузовые отсеки и позиции для контейнеров."
    },
    "airbus-hold": {
      "url": "https://safetyfirst.airbus.com/a320-family-cargo-containers-pallets-movement/?airbus-iframe=true&airbus-post=2156",
      "title": "Airbus Safety First — A320 Family Cargo Containers / Pallets Movement",
      "locator": "Cargo loading system; XZ latches",
      "passage": "В грузовых отсеках семейства A320 без системы CLS грузят поштучно. Опциональная CLS позволяет использовать контейнеры или поддоны и фиксировать их защёлками."
    },
    "faa-galley": {
      "url": "https://www.faa.gov/sites/faa.gov/files/about/initiatives/cabin_safety/regs/acob212.pdf",
      "title": "FAA — Stowage of Galley Service Items",
      "locator": "Background, FAR §121.577",
      "passage": "В документе описаны припасы и тележки бортовой кухни и необходимость закрепить их в местах хранения перед движением по земле, взлётом и посадкой."
    },
    "tsb-cabin": {
      "url": "https://www.faa.gov/sites/faa.gov/files/2022-11/a05h0002.pdf",
      "title": "Transportation Safety Board of Canada — A05H0002",
      "locator": "§1.6.1 General Information, p. 11",
      "passage": "В пассажирском салоне A340 расположены ряды кресел, проходы и закрывающиеся полки над креслами."
    },
    "ba-baggage": {
      "url": "https://www.britishairways.com/content/en/gb/information/legal/conditions-of-carriage/general-conditions-of-carriage",
      "title": "British Airways — General Conditions of Carriage",
      "locator": "§8(i) Checked baggage",
      "passage": "Зарегистрированный багаж принимают для перевозки в грузовом отсеке и по возможности в том же самолёте."
    },
    "faa-runway": {
      "url": "https://www.faa.gov/air_traffic/publications/atpubs/pcg_html/glossary-r.html",
      "title": "FAA — Pilot/Controller Glossary",
      "locator": "RUNWAY",
      "passage": "ВПП подготовлена для посадки и взлётного разбега вдоль её длины. Номера обычно отражают магнитное направление."
    },
    "faa-taxiway": {
      "url": "https://www.faa.gov/airports/aip/aip_handbook/index.cfm?Chapter=Appendix",
      "title": "FAA — Airport Improvement Program Handbook",
      "locator": "Appendix, Taxiway",
      "passage": "Рулёжная дорожка — выделенный путь для движения самолётов между точками аэродрома."
    },
    "faa-markings": {
      "url": "https://www.faa.gov/air_traffic/publications/aim_html/chap2_section_3.html",
      "title": "FAA — Aeronautical Information Manual",
      "locator": "§2-3-4 Taxiway Markings",
      "passage": "Обычная осевая маркировка рулёжной дорожки — сплошная жёлтая линия."
    },
    "faa-hangar": {
      "url": "https://www.faa.gov/airports/airport_compliance/hangar_use",
      "title": "FAA — Policy on Use of Hangars at Obligated Airports",
      "locator": "Uses of aircraft hangars",
      "passage": "Ангары предназначены для хранения самолётов и могут служить местом ремонта или сборки самолёта из комплекта."
    },
    "heathrow": {
      "url": "https://www.heathrow.com/at-the-airport/airport-maps",
      "title": "Heathrow — Airport maps",
      "locator": "Interactive maps",
      "passage": "Карты терминалов помогают найти выходы на посадку."
    },
    "faa-controls": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 6",
      "locator": "Chapter 6, Flight Controls",
      "passage": "Парные элероны на задней кромке обычно отклоняются в противоположные стороны. Дифференциальное отклонение вверх больше, чем вниз. Выпущенные предкрылки пропускают воздух через щель к верхней поверхности крыла, оттягивая отрыв потока."
    },
    "faa-trim": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 6",
      "locator": "Chapter 6, Trim Systems",
      "passage": "Триммер позволяет снять постоянное усилие с органов управления. Одна из схем использует подвижную поверхность на задней кромке руля. В кабине для триммера могут использовать отдельное колесо и указатель положения."
    },
    "faa-slat": {
      "url": "https://www.faa.gov/lessons_learned/transport_airplane/accidents/B18616",
      "title": "FAA — Boeing B-737-800",
      "locator": "Boeing 737 Leading Edge Slats",
      "passage": "У предкрылков 737-800 есть промежуточное и полностью выпущенное положения. Они помогают выполнять взлёт и посадку на меньшей скорости."
    },
    "nasa-roll": {
      "url": "https://www.grc.nasa.gov/www/k-12/VirtualAero/BottleRocket/airplane/aroll.html",
      "title": "NASA Glenn Research Center — Animated Aileron Roll",
      "locator": "Animated Aileron Roll",
      "passage": "Элероны у внешней части задней кромки отклоняются в разные стороны, увеличивая подъёмную силу одного крыла и уменьшая её у другого."
    },
    "faa-v-tail": {
      "url": "https://www.faa.gov/documentLibrary/media/Advisory_Circular/AC_90-109A.pdf",
      "locator": "Appendix 6, Nontraditional Configuration and/or Controls",
      "passage": "В V-образном оперении наклонные поверхности совмещают функции управления тангажом и рысканием."
    },
    "faa-adjustable-tail": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "locator": "Chapter 6, Adjustable Stabilizer",
      "passage": "При триммировании на некоторых самолётах меняется угол установки всего горизонтального стабилизатора."
    }
  },
