  "sources": {
    "faa-airspeed": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/phak/10_phak_ch8.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 8",
      "locator": "Airspeed Indicator; Airspeed Indicator Markings",
      "passage": "Механический указатель сравнивает полное и статическое давление. На циферблатах белая дуга показывает диапазон для выпущенных закрылков."
    },
    "faa-altimeter": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/phak/10_phak_ch8.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 8",
      "locator": "Altimeter; Effect of Nonstandard Pressure and Temperature",
      "passage": "Барометрический высотомер преобразует статическое давление в высоту. У механического прибора есть шкала опорного давления."
    },
    "faa-attitude": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/phak/10_phak_ch8.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 8",
      "locator": "Attitude Indicator",
      "passage": "Авиагоризонт показывает крен и тангаж. В традиционной схеме используют гироскоп, условный силуэт самолёта и линию горизонта."
    },
    "faa-briefing": {
      "url": "https://www.faa.gov/documentLibrary/media/Advisory_Circular/AC_121-24E.pdf",
      "title": "FAA — AC 121-24E, Passenger Safety Information",
      "locator": "Appendix A, Oral Briefings",
      "passage": "Бортпроводники проводят инструктаж и демонстрируют оборудование. В инструктаж входят ремни, аварийные выходы и другие средства безопасности."
    },
    "faa-compass": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/phak/10_phak_ch8.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 8",
      "locator": "Magnetic Compass; Deviation",
      "passage": "Компас ориентируется по магнитному полю Земли. Остаточную девиацию указывают на карточке поправок."
    },
    "faa-controller": {
      "url": "https://www.faa.gov/sites/faa.gov/files/2021-11/2018-ABA-200-CWP_2019_Report_508.pdf",
      "title": "FAA — Air Traffic Controller Workforce Plan",
      "locator": "Flight phases and controller positions",
      "passage": "Работа диспетчеров делится между управлением движением на земле, местным управлением, выдачей разрешений и передачей данных."
    },
    "faa-crew-training": {
      "url": "https://www.faa.gov/safety/people",
      "title": "FAA — Safety: The People",
      "locator": "The Flight Attendant; The Pilot",
      "passage": "Бортпроводники обучаются эвакуации и первой помощи. Пилоты проходят периодическую подготовку и проверки."
    },
    "faa-cruise": {
      "url": "https://www.faa.gov/air_traffic/community_engagement/phx/PHX-Draft-EA-App-D-PBN-ATC.pdf",
      "title": "FAA — Phoenix Area Modernization, Appendix D",
      "locator": "Phases of Flight",
      "passage": "Крейсерский полёт следует за набором высоты. На маршруте самолёт обычно обслуживает районный центр управления воздушным движением."
    },
    "faa-flightcrew": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/airplane_handbook/03_afh_ch2.pdf",
      "title": "FAA — Airplane Flying Handbook, гл. 2",
      "locator": "Pilot skills; Ground Operations",
      "passage": "Пилот контролирует полёт, управляет системами и принимает решения об эксплуатации самолёта."
    },
    "faa-fuel-gauge": {
      "url": "https://www.faa.gov/sites/faa.gov/files/pilots/pilot_handbook.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 7",
      "locator": "Fuel Systems; Fuel Gauges",
      "passage": "Датчики в баках измеряют остаток топлива, который может отображаться в галлонах или фунтах."
    },
    "faa-landing": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/airplane_handbook/10_afh_ch9.pdf",
      "title": "FAA — Airplane Flying Handbook, гл. 9",
      "locator": "Normal Approach and Landing; Round Out; Touchdown",
      "passage": "Перед касанием пилот выполняет выравнивание. После касания вес самолёта постепенно переходит с крыльев на колёса."
    },
    "faa-mechanic": {
      "url": "https://www.faa.gov/mechanics/become",
      "title": "FAA — Become an Aviation Mechanic",
      "locator": "Certificate privileges and ratings",
      "passage": "Сертификат авиационного механика FAA может иметь допуск к работе с планером или силовой установкой или оба допуска."
    },
    "faa-pitot": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/phak/10_phak_ch8.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 8",
      "locator": "Impact Pressure; Blocked Pitot System",
      "passage": "Через приёмник Пито на прибор поступает полное давление. У некоторых приёмников есть обогрев, а дренаж отводит влагу."
    },
    "faa-static": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/phak/10_phak_ch8.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 8",
      "locator": "Static Pressure; Blocked Static System",
      "passage": "Статический порт сообщается с окружающим воздухом. Его засорение влияет на приборы, получающие от него давление."
    },
    "faa-takeoff": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/airplane_handbook/07_afh_ch6.pdf",
      "title": "FAA — Airplane Flying Handbook, гл. 6",
      "locator": "Normal Takeoff; Effect of Wind",
      "passage": "Обычный взлёт включает разбег, отрыв и начальный набор высоты. Встречный ветер сокращает разбег при прочих равных."
    },
    "faa-taxi": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/airplane_handbook/03_afh_ch2.pdf",
      "title": "FAA — Airplane Flying Handbook, гл. 2",
      "locator": "Taxiing",
      "passage": "Руление — движение самолёта по поверхности под собственной тягой. Пилот выбирает скорость, позволяющую безопасно остановить самолёт."
    },
    "faa-taxi-diagram": {
      "url": "https://www.faa.gov/airports/runway_safety/pilots/best_practices",
      "title": "FAA — Pilot Best Practices for Airfield Safety",
      "locator": "Taxi operations",
      "passage": "Схема аэродрома помогает сверить назначенный маршрут руления."
    },
    "faa-turn": {
      "url": "https://www.faa.gov/sites/faa.gov/files/regulations_policies/handbooks_manuals/aviation/phak/10_phak_ch8.pdf",
      "title": "FAA — Pilot’s Handbook of Aeronautical Knowledge, гл. 8",
      "locator": "Turn Indicators; Inclinometer",
      "passage": "Указатель поворота показывает направление и угловую скорость. Шарик инклинометра показывает, согласован ли поворот."
    }
  },
