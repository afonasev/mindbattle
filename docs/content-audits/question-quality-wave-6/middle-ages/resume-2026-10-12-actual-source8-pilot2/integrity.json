    {
      "id": "middle-ages-indulgence",
      "difficulty": "easy",
      "canonicalCardSha256": "446a10a3092c51d42d829f55e30f41eaad919e243ad5a611c0c6c153ca8f89b4",
      "expectedFrozenSha256": "446a10a3092c51d42d829f55e30f41eaad919e243ad5a611c0c6c153ca8f89b4",
      "canonicalCardMatch": true,
      "fieldShaRecipe": "SHA-256 of exact UTF-8 strings without normalization; non-string fields use canonical compact sorted-key JSON UTF-8",
      "reviewFields": {
        "prompt": {
          "literal": "Какую церковную практику обсуждают знаменитые «95 тезисов» Мартина Лютера?",
          "sha256": "5622de00a9cd621ea2f8a66e22261d89a2eb8df4694618ac3ff1a9a16b7f1259",
          "recipe": "exact UTF-8 scalar; no normalization"
        },
        "answer0.text": {
          "literal": "Покаяние",
          "sha256": "330779cf906be71752c1aaf2a2df83ff76dfef35df9f1c527b6bdfe121ef9e06",
          "recipe": "exact UTF-8 scalar; no normalization"
        },
        "answer0.note": {
          "literal": "Покаяние означало раскаяние в совершённом грехе и стремление исправить содеянное.",
          "sha256": "2bb683fa17d3a9ad4bd4113579785bf3ba3fef182d8c5e1cbb0ece69399424de",
          "recipe": "exact UTF-8 scalar; no normalization"
        },
        "answer1.text": {
          "literal": "Паломничество",
          "sha256": "d54e87b2eb90ba55e96a407c0d931af998517d4b6cdc8da60cd563fbd0c83663",
          "recipe": "exact UTF-8 scalar; no normalization"
        },
        "answer1.note": {
          "literal": "Паломничество было религиозным путешествием к почитаемому святому месту.",
          "sha256": "ae829ac53a89792ac1947e7dce20f08ab375f1b328c48ce5fb4e6f504dbadc5d",
          "recipe": "exact UTF-8 scalar; no normalization"
        },
        "answer2.text": {
          "literal": "Индульгенция",
          "sha256": "dbc829081261bdd089c42fefa2677a36213ba7f36c50485deb2abc9852c374c8",
          "recipe": "exact UTF-8 scalar; no normalization"
        },
        "answer2.note": {
          "literal": "Индульгенция относилась к временной каре за грехи, уже прощённые церковью; она могла быть полной или частичной.",
          "sha256": "c313ba0966d446b93848a829e4554b3eb3ad3aa255de7323fd52ab9804bd0e8b",
          "recipe": "exact UTF-8 scalar; no normalization"
        },
        "answer3.text": {
          "literal": "Монастырский устав",
          "sha256": "4dbfa2f887ce5e9bde121d255a979b9456c65cce369c875c24e1c38dd9386229",
          "recipe": "exact UTF-8 scalar; no normalization"
        },
        "answer3.note": {
          "literal": "Монастырский устав устанавливал общие правила жизни монашеской общины.",
          "sha256": "cb11caaf51ad794ac1470ee799d65f580ebbc43434e1e4d3850ac33d2818b24f",
          "recipe": "exact UTF-8 scalar; no normalization"
        },
        "key.correctIndex": {
          "literal": 2,
          "sha256": "d4735e3a265e16eee03f59718b9b5d03019c07d8b6c51f90da3a666eec13ab35",
          "recipe": "canonical JSON scalar UTF-8"
        },
        "explanation": {
          "literal": "В заглавии тезисов Лютера говорится о силе и действенности индульгенций. В церковном определении это освобождение от временной кары за уже прощённые грехи; паломничество и монастырский устав относятся к другим сторонам религиозной жизни.",
          "sha256": "349610ef15d95c7119807a3cb3073d496e0432db89a1f36e728e818abeffb204",
          "recipe": "exact UTF-8 scalar; no normalization"
        },
        "mainSource": {
          "literal": {
            "title": "Martin Luther — Disputatio pro Declaratione Virtutis Indulgentiarum (95 Theses)",
            "url": "https://sourcebooks.web.fordham.edu/source/95theses-latin.asp",
            "verifiedAt": "2026-10-12"
          },
          "sha256": "e218d3068bebf7090f7aa3a850bc1f6d18d0005dbc857445e38ca2eb2c27d0df",
          "recipe": "canonical sorted-key JSON UTF-8; field object preserved as literal"
        }
      }
