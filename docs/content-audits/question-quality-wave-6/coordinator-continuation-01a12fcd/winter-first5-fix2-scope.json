  "baselineCards": {
    "winter-sports-059": {
      "id": "winter-sports-059",
      "difficulty": "easy",
      "prompt": "В каком направлении проходят стандартный овал в конькобежном беге на длинной дорожке?",
      "answers": [
        {
          "text": "По часовой стрелке",
          "note": "Стандартный овал длинной дорожки проходят против часовой стрелки. В индивидуальном забеге пары меняются дорожками каждый круг, но направление не разворачивают."
        },
        {
          "text": "Зависит от длины дистанции",
          "note": "Дистанции действительно различаются — например, 500, 1000 и 1500 метров; однако пары проходят овал против часовой и меняются дорожками раз в круг."
        },
        {
          "text": "Против часовой стрелки",
          "note": "Если оба спортсмена одновременно приходят к пересечению, преимущество имеет участник на внешней дорожке."
        },
        {
          "text": "Направление меняется на каждом пересечении",
          "note": "На пересечении спортсмены меняют дорожки; при этом продолжают проходить овал против часовой, уравнивая пройденное расстояние."
        }
      ],
      "correctIndex": 2,
      "explanation": "На длинном стандартном овале спортсмены движутся против часовой стрелки. В индивидуальных дистанциях они меняются дорожками каждый круг, чтобы уравнять длину пути; при одновременном прибытии к пересечению преимущество у внешней дорожки.",
      "source": {
        "title": "Canadian Olympic Committee — Long Track Speed Skating",
        "url": "https://olympic.ca/sports/long-track/",
        "verifiedAt": "2026-10-12"
      }
    },
    "winter-sports-067": {
      "id": "winter-sports-067",
      "difficulty": "medium",
      "prompt": "Какой хоккейный термин IIHF соответствует типичным сочетаниям 5 на 4, 5 на 3 или 4 на 3 после штрафа?",
      "answers": [
        {
          "text": "Овертайм",
          "note": "IIHF описывает основное время как три периода по 20 минут; овертайм и серия бросков следуют отдельно, если нужны."
        },
        {
          "text": "Проброс",
          "note": "Проброс фиксируют, когда шайбу отправляют из-за центральной линии за линию ворот соперника без касания; это основание для остановки игры."
        },
        {
          "text": "Большинство",
          "note": "По глоссарию IIHF голы команды в большинстве не включаются в её показатель «плюс/минус» для игроков на льду."
        },
        {
          "text": "Отложенный свисток",
          "note": "Судья показывает штраф, но не останавливает игру, пока шайбой владеет команда, не нарушившая правила."
        }
      ],
      "correctIndex": 2,
      "explanation": "IIHF связывает эти расстановки с ситуацией power play: штраф оставляет одну команду в меньшинстве, а соперник получает лишнего игрока. Чаще всего это 5 на 4, 5 на 3 или 4 на 3.",
      "source": {
        "title": "IIHF — Ice Hockey Terminology",
        "url": "https://canada-central.iihf.com/en/events/2026/olympic-w/static/71794/ice_hockey_terminology",
        "verifiedAt": "2026-10-12"
      }
    }
  },
