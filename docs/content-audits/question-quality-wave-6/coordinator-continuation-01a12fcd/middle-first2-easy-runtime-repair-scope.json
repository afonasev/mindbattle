  "currentCards": [
    {
      "id": "middle-ages-shrine",
      "difficulty": "easy",
      "prompt": "Что верующие могли почитать в центре христианской святыни?",
      "answers": [
        {
          "text": "Останки святого",
          "note": "Останки святого считались реликвией; в описанном Шмёльцем типе святынь их в центре не было."
        },
        {
          "text": "Изображение святого",
          "note": "Шмёльц приводит Марианские святыни Суффолка, в том числе в Лонг-Мелфорде, Керси, Садбери и Ипсвиче."
        },
        {
          "text": "Личная вещь святого",
          "note": "К реликвиям относили также вещи, которыми пользовался святой; в центре этого типа святынь их не было."
        },
        {
          "text": "Книга с молитвами",
          "note": "В центре описанных Шмёльцем святынь находились именно изображения, а не книги."
        }
      ],
      "correctIndex": 1,
      "explanation": "Шмёльц описывает новый тип святыни в приходской церкви: в центре находилось изображение святого, а не первичная или вторичная реликвия. Примеры относятся к позднесредневековой Восточной Англии.",
      "source": {
        "title": "Michael Schmoelz — Pilgrimage in Medieval East Anglia: A Regional Survey of the Shrines and Pilgrimages of Norfolk and Suffolk",
        "url": "https://ueaeprints.uea.ac.uk/id/eprint/63940/1/Pilgrimage_in_medieval_East_Anglia.pdf",
        "verifiedAt": "2026-10-12"
      }
    },
    {
      "id": "middle-ages-indulgence",
      "difficulty": "easy",
      "prompt": "Какую церковную практику обсуждают знаменитые «95 тезисов» Мартина Лютера?",
      "answers": [
        {
          "text": "Покаяние",
          "note": "Покаяние означало раскаяние в совершённом грехе и стремление исправить содеянное."
        },
        {
          "text": "Паломничество",
          "note": "Паломничество было религиозным путешествием к почитаемому святому месту."
        },
        {
          "text": "Индульгенция",
          "note": "Индульгенция относилась к временной каре за грехи, уже прощённые церковью; она могла быть полной или частичной."
        },
        {
          "text": "Монастырский устав",
          "note": "Монастырский устав устанавливал общие правила жизни монашеской общины."
        }
      ],
      "correctIndex": 2,
      "explanation": "В заглавии тезисов Лютера говорится о силе и действенности индульгенций. В церковном определении это освобождение от временной кары за уже прощённые грехи; паломничество и монастырский устав относятся к другим сторонам религиозной жизни.",
      "source": {
        "title": "Martin Luther — Disputatio pro Declaratione Virtutis Indulgentiarum (95 Theses)",
        "url": "https://sourcebooks.web.fordham.edu/source/95theses-latin.asp",
        "verifiedAt": "2026-10-12"
      }
    }
  ],
