  "cardBefore": {
    "id": "winter-sports-058",
    "difficulty": "easy",
    "prompt": "В какой дисциплине конькобежцы соревнуются группой на меньшем овале, размеченном внутри катка?",
    "answers": [
      {
        "text": "Индивидуальные дистанции на длинной дорожке",
        "note": "На длинной дорожке индивидуальные дистанции проходят парами против секундомера."
      },
      {
        "text": "Шорт-трек",
        "note": "Овал шорт-трека длиной 111,12 метра размечают внутри катка международного размера."
      },
      {
        "text": "Масс-старт",
        "note": "Масс-старт проходит группой на стандартном 400-метровом овале длинной дорожки."
      },
      {
        "text": "Командная гонка преследования",
        "note": "В преследовании команды стартуют с противоположных сторон длинного овала."
      }
    ],
    "correctIndex": 1,
    "explanation": "Шорт-трек проводят на коротком овале внутри международного катка. В масс-старте тоже едут группой, но по стандартной длинной дорожке.",
    "source": {
      "title": "Canadian Olympic Committee — Short Track Speed Skating",
      "url": "https://olympic.ca/sports/short-track/",
