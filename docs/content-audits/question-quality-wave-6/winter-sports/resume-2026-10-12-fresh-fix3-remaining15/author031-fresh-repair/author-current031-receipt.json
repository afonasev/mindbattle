    "counterIncrement": 0,
    "beforeCard": {
      "id": "winter-sports-031",
      "difficulty": "easy",
      "prompt": "Какую часть тела горнолыжные очки защищают от погоды и лучей?",
      "answers": [
        {
          "text": "Голову",
          "note": "FIS требует шлем на всех соревнованиях по горным лыжам и задаёт для него стандарты безопасности."
        },
        {
          "text": "Руки",
          "note": "В соседнем разделе FIS описывает перчатки как защиту от погоды и внешних воздействий."
        },
        {
          "text": "Глаза",
          "note": "FIS добавляет, что линзы горнолыжных очков должны быть оптически правильными."
        },
        {
          "text": "Голень",
          "note": "Правило FIS запрещает носить внутри горнолыжного ботинка дополнительные жёсткие щитки на голени."
        }
      ],
      "correctIndex": 2,
      "explanation": "FIS описывает горнолыжные очки как устройства для защиты глаз от погоды и лучей. Хорошая видимость во всех погодных условиях — их цель; линзы должны быть оптически правильными.",
      "source": {
        "title": "FIS — Alpine rules and competition equipment, 2026",
        "url": "https://assets.fis-ski.com/f/252177/x/00f097325f/specifications_for_alpine_competition_equipment_08-10-2026.pdf",
        "verifiedAt": "2026-10-11"
      }
    },
    "afterCard": {
      "id": "winter-sports-031",
      "difficulty": "easy",
      "prompt": "Зачем горнолыжным очкам нужна вентиляция?",
      "answers": [
        {
          "text": "Адаптироваться к изменению освещения.",
          "note": "Julbo указывает, что фотохромные линзы автоматически адаптируются к изменениям освещения."
        },
        {
          "text": "Снижать блики от снега и льда.",
          "note": "Поляризационные линзы уменьшают блики, отражённые снегом и льдом."
        },
        {
          "text": "Уменьшать запотевание линз.",
          "note": "Помимо защиты от запотевания, вентиляция помогает поддерживать комфортную температуру у лица."
        },
        {
          "text": "Расширять боковой обзор.",
          "note": "Более широкая оправа может увеличивать периферический обзор."
        }
