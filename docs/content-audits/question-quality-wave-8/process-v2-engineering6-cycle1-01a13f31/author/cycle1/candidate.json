      "beforeCard": {
        "id": "engineering-machines-milling-cutter",
        "difficulty": "medium",
        "prompt": "Какой процесс снимает материал вращающейся многолезвийной фрезой?",
        "answers": [
          {
            "text": "Сверление",
            "note": "Сверление формирует отверстие осевым продвижением вращающегося сверла."
          },
          {
            "text": "Фрезерование",
            "note": "При фрезеровании режущие зубья вращающейся фрезы периодически входят в материал."
          },
          {
            "text": "Шлифование",
            "note": "Шлифование снимает тонкий слой материала абразивным кругом или лентой."
          },
          {
