  "entries": [
    {
      "id": "history-russia-novgorod-assembly",
      "status": "READY_FOR_SAME_READER_FINAL",
      "beforeHash": "e38d4f6ac46e4b35e6f612410a5d36da350a97d801d818a4fdd8bc9c077bfeb8",
      "afterHash": "36dd8478fd827afbfbdbe08daabda4ffc790eb0ab1dacc996a3fb899e07bf2f7",
      "literalGroups": [
        {
          "group": "prompt_ordered_answers_key",
          "literal": {
            "prompt": "Какой орган власти в Новгородской республике решал вопросы войны и мира и приглашал князя?",
            "answers": [
              "Земский собор",
              "Правительствующий сенат",
              "Вече",
              "Государственный совет"
            ],
            "correctIndex": 2
          },
          "literalSHA256": "a767ad33bf93cbe3ce565b8fb3dd1328b6d93592d5363e416ff2e5ce4ad9291b",
          "primaryGround": "Revised prompt asks for the body by its functions in the Novgorod Republic, and the keyed label is only «Вече»; no answer repeats «Новгородское». SPbU identifies veche as the Republic’s highest authority and reports decisions on war/peace and inviting princes (L326-L343). The other three labels are historically attested government bodies; «Земский собор» is also an assembly, so the option row has a plausible same-category rival and requires recognition of the Novgorod-specific role rather than lexical matching.",
          "locator": "turn2view2 L326-L346; distractor support retained in the unchanged option notes (PБ source locators in sourceproof)",
          "sourcePaths": [
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a16254/source-history-russia83/raw/spbu-veche-relevant-find.json",
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a160a6/source-history-russia70/raw/prlib-ivan-iv-zemsky-sobor.json",
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a1605d/source-history-russia60/raw/prlib-kazan-1552.json",
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a16107/source-history-russia74/raw/prlib-state-council-1810-open.json"
          ]
        },
        {
          "group": "explanation",
          "literal": "Новгородское вече было высшим органом власти в Новгородской республике. Оно решало вопросы войны и мира и приглашало князя из других русских земель.",
          "literalSHA256": "f6469bba6f1918197a8f2317947ea3095d37423cf0f67585f5c5f3dbfd83316b",
          "primaryGround": "SPbU passage establishes Republic status and highest authority of veche; its decisions include war/peace and inviting princes from other Rus lands.",
          "locator": "turn2view2 L326-L343",
          "sourcePaths": [
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a16254/source-history-russia83/raw/spbu-veche-relevant-find.json"
          ]
        },
        {
          "group": "note0",
          "literal": "Первый Земский собор традиционно датируют 1549 годом.",
          "literalSHA256": "6c6aa24d6d2f4481dffaf44d08bfd120239ef24a1d6b9c75efd63fb3ec57b269",
          "primaryGround": "Presidential Library records first Zemsky Sobor in 1549.",
          "locator": "L55",
          "sourcePaths": [
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a160a6/source-history-russia70/raw/prlib-ivan-iv-zemsky-sobor.json"
          ]
        },
        {
          "group": "note1",
          "literal": "Правительствующий сенат был учреждён Петром I как высший орган управления.",
          "literalSHA256": "ad5f35f53df0b17ed2b1b5e3b4e9e98a128f0e2d3b05bcd02eea1dfae5b36a0c",
          "primaryGround": "Presidential Library Senate page in retained combined output records Peter I establishment in 1711 and its state role.",
          "locator": "combined body turn1view1 L40-L49",
          "sourcePaths": [
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a1605d/source-history-russia60/raw/prlib-kazan-1552.json"
          ]
        },
        {
          "group": "note2",
          "literal": "Вече выбирало главу новгородской церкви.",
          "literalSHA256": "77df933ed1c373735a8498e5c27ba649d6b8b49aa641d9948009f511baf33118",
          "primaryGround": "SPbU explicitly says veche elected the head of the Novgorod church.",
          "locator": "turn2view2 L343",
          "sourcePaths": [
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a16254/source-history-russia83/raw/spbu-veche-relevant-find.json"
          ]
        },
        {
          "group": "note3",
          "literal": "Государственный совет был учреждён Александром I в 1810 году.",
          "literalSHA256": "1f7de78d46b2c1ea7c1341f86697d9c53302f73e34696fb2cdf9ec5f3aaad075",
          "primaryGround": "Presidential Library records State Council established under Alexander I in 1810.",
          "locator": "L42, L46-L48",
          "sourcePaths": [
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a16107/source-history-russia74/raw/prlib-state-council-1810-open.json"
          ]
        }
      ],
