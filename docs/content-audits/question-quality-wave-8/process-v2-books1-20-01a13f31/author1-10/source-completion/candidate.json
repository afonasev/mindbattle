      "beforeCard": {
        "id": "books-publishing-cover-part",
        "difficulty": "easy",
        "prompt": "Какая внешняя часть книги защищает страницы и сообщает название?",
        "answers": [
          {
            "text": "Обложка",
            "note": "Обложка закрывает книжный блок спереди и сзади. На ней обычно размещают название и оформление."
          },
          {
            "text": "Корешок",
            "note": "Корешок закрывает место скрепления тетрадей. Его надпись читают, не вынимая книгу."
          },
          {
            "text": "Титульный лист",
            "note": "Титульный лист содержит основные выходные сведения. Он следует в начале книжного блока."
          },
          {
            "text": "Форзац",
            "note": "Форзац приклеен к внутренней стороне крышки и первой тетради. Он укрепляет соединение блока с переплётом."
          }
        ],
