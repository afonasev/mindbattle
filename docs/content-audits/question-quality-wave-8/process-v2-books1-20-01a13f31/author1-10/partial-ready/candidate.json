      "beforeHash": "6de5bb19fd1c06070e02aaa5ff3259ec7d2948a7ede6180ab5780596cc207fe1",
      "proposedCard": {
        "id": "books-publishing-cover-part",
        "difficulty": "easy",
        "prompt": "Какая часть служит внешней защитой всего книжного блока?",
        "answers": [
          {
            "text": "Обложка",
            "note": "Передняя и задняя стороны вместе с корешком образуют внешнюю оболочку книги."
          },
          {
            "text": "Корешок",
            "note": "Корешок обычно обращён к читателю на полке; на нём размещают название и имя автора."
          },
          {
            "text": "Титульный лист",
            "note": "Титульный лист входит в предварительные страницы перед основным текстом."
          },
          {
            "text": "Форзац",
            "note": "Форзац соединяет крышку с внутренними страницами и иногда бывает декоративным, например мраморным."
          }
        ],
        "correctIndex": 0,
        "explanation": "Обложка окружает книжный блок и защищает его снаружи. Её передняя и задняя стороны связаны с корешком в общий внешний комплект.",
        "source": {
