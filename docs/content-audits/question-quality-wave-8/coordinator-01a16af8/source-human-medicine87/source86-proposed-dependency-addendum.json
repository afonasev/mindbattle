    "candidateCanonicalSHA256": "1d6a1504958ff2dc7ae1a7a062758b574bee01ec5aee2d23f34be127fded3cb2",
    "fullProposedCard": {
      "id": "human-medicine-ext-cell-eating",
      "difficulty": "medium",
      "prompt": "Как называется процесс, при котором клетка поглощает крупные частицы?",
      "answers": [
        {
          "text": "Пиноцитоз",
          "note": "При пиноцитозе клетка захватывает внеклеточную жидкость с растворёнными в ней веществами в мембранных пузырьках."
        },
        {
          "text": "Рецептор-опосредованный эндоцитоз",
          "note": "Рецептор-опосредованный эндоцитоз выборочно захватывает вещества, связавшиеся со специфическими рецепторами на мембране клетки."
        },
        {
          "text": "Фагоцитоз",
          "note": "Многие иммунные клетки поглощают этим способом вторгшиеся патогены и переваривают их."
        },
        {
          "text": "Экзоцитоз",
          "note": "При экзоцитозе внутриклеточный пузырёк сливается с клеточной мембраной и выпускает содержимое наружу."
        }
      ],
      "correctIndex": 2,
      "explanation": "Фагоцитоз — форма эндоцитоза, при которой клетка захватывает крупную частицу. Клеточная мембрана окружает её и образует пузырёк; пиноцитоз захватывает жидкость, а рецепторный эндоцитоз — определённые вещества.",
      "source": {
        "title": "OpenStax Anatomy and Physiology 2e: The Cell Membrane",
        "url": "https://openstax.org/books/anatomy-and-physiology-2e/pages/3-1-the-cell-membrane",
        "verifiedAt": "2026-10-24"
      }
    }
  },
