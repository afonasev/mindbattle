        {
          "group": "prompt_ordered_answers_key",
          "literal": {
            "prompt": "Как называют роспуск Второй Государственной думы и публикацию нового избирательного положения в 1907 году?",
            "answers": [
              "Дело петрашевцев",
              "Февральская революция",
              "Кровавое воскресенье",
              "Третьеиюньский переворот"
            ],
            "correctIndex": 3
          },
          "literalSHA256": "b53cd4d09edcbcf9f85a0898046cbdd3f457b20828ff2f383dd57b1be5ad7efc",
          "primaryGround": "Official PBL lines L45-L46 identify the event and new law. Retained official contexts separately establish the four option identities and dates.",
          "sourcePaths": [
            "docs/content-audits/question-quality-wave-8/coordinator-01a1656b/source-history-russia98/raw/prlib-third-duma.json",
            "docs/content-audits/question-quality-wave-8/coordinator-01a1656b/source-history-russia98/raw/prlib-dostoevsky-petrashevtsy.pdf.json",
