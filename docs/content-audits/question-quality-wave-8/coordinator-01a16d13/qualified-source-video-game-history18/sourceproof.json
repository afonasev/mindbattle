  "entries": [
    {
      "id": "video-game-history-playstation-two-disc-format",
      "status": "READY_FOR_INDEPENDENT_REVIEW",
      "literalGroups": [
        {
          "group": "prompt_ordered_answers_key",
          "literal": {
            "prompt": "Какой оптический формат, согласно истории платформ Sony, был принят в PlayStation 2?",
            "answers": [
              "DVD-ROM",
              "LaserDisc",
              "MiniDisc",
              "HD DVD"
            ],
            "correctIndex": 0
          },
          "literalSHA256": "685ff82d1c6e0bc842cc73f93311f73bc052930aaffa243d060b08259d83be08",
          "primaryGround": "Sony IR Day L28-L29 dates PS1/CD-ROM to 1994 and PS2/DVD-ROM to 2000, directly supporting the asked relation and unique key; it does not claim PS2 used no other media.",
          "sourcePaths": [
            "docs/content-audits/question-quality-wave-8/coordinator-01a16d13/source-video-game-history18/raw-sony-ir-day-2014.pdf.json"
          ],
          "locator": "Sony IR Day L28-L29.",
          "sourcePathsBeforeTechnicalNormalization": [
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a16d13/source-video-game-history18/raw-sony-ir-day-2014.pdf.json"
          ]
        },
        {
          "group": "explanation",
          "literal": "Sony связывает появление PlayStation 2 в 2000 году с принятием формата DVD-ROM. Это отличало поколение PS2 от первой PlayStation, для которой основным оптическим носителем был CD-ROM.",
          "literalSHA256": "a39641b5a3a063e76f4e3d531ed66ac34e374d2dede581bad2b22018aca45f8f",
          "primaryGround": "Sony states PS1 introduced CD-ROM as a major format in 1994 and PS2 adapted DVD-ROM in 2000, supporting the generational contrast.",
          "sourcePaths": [
            "docs/content-audits/question-quality-wave-8/coordinator-01a16d13/source-video-game-history18/raw-sony-ir-day-2014.pdf.json"
          ],
          "locator": "Sony IR Day L28-L29.",
          "sourcePathsBeforeTechnicalNormalization": [
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a16d13/source-video-game-history18/raw-sony-ir-day-2014.pdf.json"
          ]
        },
        {
          "group": "note0",
          "literal": "PS2 также воспроизводила DVD-фильмы, совмещая игровую приставку с DVD-плеером.",
          "literalSHA256": "9b08b5526043ae07364950c9049ff3161f1f752d0e350d504c264ca1f1d155d9",
          "primaryGround": "PlayStation history says PS2 offered a DVD player and that DVD playback plus gaming was attractive in 2000.",
          "sourcePaths": [
            "docs/content-audits/question-quality-wave-8/coordinator-01a16d13/source-video-game-history18/raw-playstation-history-2000-ps2-polish.json"
          ],
          "locator": "PlayStation history L61, L69-L71.",
          "sourcePathsBeforeTechnicalNormalization": [
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a16d13/source-video-game-history18/raw-playstation-history-2000-ps2-polish.json"
          ]
        },
        {
          "group": "note1",
          "literal": "Philips и MCA публично продемонстрировали лазерный видеодиск в 1972 году; Pioneer представила проигрыватель LaserDisc в 1979-м.",
          "literalSHA256": "1aeeca0addfa572f95f4713f58d342116131224566bf2359f5ac1d3841bfb0e8",
          "primaryGround": "Computer History Museum dates the Philips/MCA public demonstration to 1972 and the Pioneer LaserDisc player to 1979; chronology does not assign sole invention to Pioneer.",
          "sourcePaths": [
            "docs/content-audits/question-quality-wave-8/coordinator-01a16d13/source-video-game-history18/raw-computer-history-museum-laserdisc.json"
          ],
          "locator": "Computer History Museum L81-L83.",
          "sourcePathsBeforeTechnicalNormalization": [
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a16d13/source-video-game-history18/raw-computer-history-museum-laserdisc.json"
          ]
        },
        {
          "group": "note2",
          "literal": "Мини-диск — цифровой магнитооптический носитель информации.",
          "literalSHA256": "1087495765fc34b59330e11edce640e6c39ab8665f5d704d89eb4459c5de25d8",
          "primaryGround": "Sony Group History describes MiniDisc as 6.4 cm magneto-optical audio media associated with portability.",
          "sourcePaths": [
            "docs/content-audits/question-quality-wave-8/coordinator-01a16d13/source-video-game-history18/raw-sony-minidisc-history.json"
          ],
          "locator": "Sony Group History L226-L229.",
          "sourcePathsBeforeTechnicalNormalization": [
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a16d13/source-video-game-history18/raw-sony-minidisc-history.json"
          ]
        },
        {
          "group": "note3",
          "literal": "HD DVD — формат DVD-дисков для видео высокой чёткости, разрабатывавшийся в DVD Forum.",
          "literalSHA256": "e6b8e88e15b61a5863ad2b4d89b275c10d79d8ef33ee4ae386497fc10d86710f",
          "primaryGround": "Toshiba identifies HD DVD as a high-definition DVD disc standard developed in DVD Forum.",
          "sourcePaths": [
            "docs/content-audits/question-quality-wave-8/coordinator-01a16d13/source-video-game-history18/raw-toshiba-hd-dvd-press-release.json"
          ],
          "locator": "Toshiba L50-L51.",
          "sourcePathsBeforeTechnicalNormalization": [
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a16d13/source-video-game-history18/raw-toshiba-hd-dvd-press-release.json"
          ]
        }
      ],
