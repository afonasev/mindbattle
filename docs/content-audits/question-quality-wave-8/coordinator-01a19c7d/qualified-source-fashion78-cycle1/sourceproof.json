  "entries": [
    {
      "id": "fashion-paisley",
      "topicId": "fashion",
      "sourceOrder": 78,
      "status": "READY_FOR_INDEPENDENT_REVIEW",
      "literalGroups": [
        {
          "group": "prompt_ordered_answers_key",
          "literal": {
            "prompt": "Название какого из этих текстильных узоров Merriam-Webster связывает с городом в Шотландии?",
            "answers": [
              "Гусиная лапка",
              "Пейсли",
              "Тонкая полоска",
              "Тартан"
            ],
            "correctIndex": 1
          },
          "literalSHA256": "ee994e5b331837598b9bc829b2030a55a69254326f546b84fcf19e62b5b0f8f9",
          "primaryGround": "MW указывает этимологию paisley как “Paisley, Scotland” (L62-L64); географическая статья определяет Пейсли как город на юго-западе Шотландии (L115-L124). Варианты — другие текстильные рисунки; отдельные MW записи описывают их рисунок, а не связывают их название с шотландским городом.",
          "sourcePaths": [
            "docs/content-audits/question-quality-wave-8/coordinator-01a19c7d/source-fashion76/paisley-mw-capture.json"
          ],
          "locator": "Merriam-Webster PAISLEY L62-L68, L115-L124; сравнительные записи MW HOUNDSTOOTH L36-L42, PINSTRIPE L42-L60, TARTAN L38-L50",
          "sourcePathsBeforeTechnicalNormalization": [
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a19c7d/source-fashion76/paisley-mw-capture.json"
          ]
        },
        {
          "group": "explanation",
          "literal": "Merriam-Webster связывает этимологию paisley с Пейсли в Шотландии. Этим словом также называют ткань или принт с цветными изогнутыми абстрактными фигурами.",
          "literalSHA256": "34bd6cda8e9842eaccaaf20f649e3c1a8e874d114a402d346dca6299c86e62ff",
          "primaryGround": "MW связывает этимологию paisley с Paisley, Scotland (L62-L64), а определение описывает paisley как ткань/принт с цветными изогнутыми абстрактными фигурами (L40-L48).",
          "sourcePaths": [
            "docs/content-audits/question-quality-wave-8/coordinator-01a19c7d/source-fashion76/paisley-mw-capture.json"
          ],
          "locator": "Merriam-Webster PAISLEY L40-L48, L62-L68",
          "sourcePathsBeforeTechnicalNormalization": [
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a19c7d/source-fashion76/paisley-mw-capture.json"
          ]
        },
        {
          "group": "note0",
          "literal": "Merriam-Webster определяет её как обычно мелкий узор с ломаной клеткой; так также называют ткань, сотканную с этим рисунком.",
          "literalSHA256": "852d71266824905054cbcba15e352996f50d061d5908811236ea997dbcd10cae",
          "primaryGround": "MW определяет houndstooth как обычно мелкий узор с ломаной клеткой и ткань, сотканную с этим рисунком (L36-L42).",
          "sourcePaths": [
            "docs/content-audits/question-quality-wave-8/coordinator-01a19c7d/source-fashion76/houndstooth-mw-capture.json"
          ],
          "locator": "Merriam-Webster HOUNDSTOOTH L36-L42",
          "sourcePathsBeforeTechnicalNormalization": [
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a19c7d/source-fashion76/houndstooth-mw-capture.json"
          ]
        },
        {
          "group": "note1",
          "literal": "Первое известное употребление paisley как прилагательного о ткани с цветными изогнутыми фигурами словарь датирует 1790 годом.",
          "literalSHA256": "45c29004a3807f6ae40aa24a49e3eec98b2ad7f476562c88c864c732f992c6c8",
          "primaryGround": "MW указывает, что первое известное употребление paisley относится к значению 1 прилагательного: ткань, обычно из мягкой шерсти, с цветными изогнутыми фигурами, сотканными или напечатанными (L40-L44, L66-L68). Дата не приписывается отдельному значению «узор» из L46-L48.",
          "sourcePaths": [
            "docs/content-audits/question-quality-wave-8/coordinator-01a19c7d/source-fashion76/paisley-mw-capture.json"
          ],
          "locator": "Merriam-Webster PAISLEY L40-L48, L66-L68",
          "sourcePathsBeforeTechnicalNormalization": [
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a19c7d/source-fashion76/paisley-mw-capture.json"
          ]
        },
        {
          "group": "note2",
          "literal": "Pinstripe — очень тонкая полоска, особенно на ткани; этим словом также называют одежду с такими полосами.",
          "literalSHA256": "a85acd37161dc7eae92903935e1716833be81b0ff0306f1d86515d1c5e243ec7",
          "primaryGround": "MW определяет pinstripe как очень тонкую полосу, особенно на ткани, а также одежду с такими полосами (L42-L60).",
          "sourcePaths": [
            "docs/content-audits/question-quality-wave-8/coordinator-01a19c7d/source-fashion76/pinstripe-mw-capture.json"
          ],
          "locator": "Merriam-Webster PINSTRIPE L42-L60",
          "sourcePathsBeforeTechnicalNormalization": [
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a19c7d/source-fashion76/pinstripe-mw-capture.json"
          ]
        },
        {
          "group": "note3",
          "literal": "Tartan — шотландский рисунок из полос разной ширины и цвета, обычно связанный с определённым кланом.",
          "literalSHA256": "dff74d4c850190ad1bcb4fe23e19f13caeb9b1b1873bbef3605e45790012a35d",
          "primaryGround": "MW определяет tartan как шотландский текстильный рисунок из полос разной ширины и цвета, обычно связанный с кланом; также определяет ткань с таким рисунком (L38-L50).",
          "sourcePaths": [
            "docs/content-audits/question-quality-wave-8/coordinator-01a19c7d/source-fashion76/tartan-mw-capture.json"
          ],
          "locator": "Merriam-Webster TARTAN L38-L50",
          "sourcePathsBeforeTechnicalNormalization": [
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a19c7d/source-fashion76/tartan-mw-capture.json"
          ]
        }
      ],
