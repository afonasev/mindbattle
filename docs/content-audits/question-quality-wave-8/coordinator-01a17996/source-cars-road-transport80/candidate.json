      "beforeHash": "8e9dc9c3c94d01f3c442b502b68046f0af38a3d5a5c241eb231b9b69cfe6291b",
      "proposedCard": {
        "id": "cars-road-transport-tire-valve-air",
        "difficulty": "easy",
        "prompt": "Что у шины нажимают, если давление оказалось выше рекомендованного?",
        "answers": [
          {
            "text": "Протектор",
            "note": "Протектор обеспечивает сцепление; NHTSA рекомендует заменить шину, когда его износ достигает 2/32 дюйма."
          },
          {
            "text": "Шток вентиля",
            "note": "К штоку мягко прижимают край манометра, чтобы медленно выпустить лишний воздух до рекомендованного давления."
          },
          {
            "text": "Боковина шины",
            "note": "На боковине легковых шин, продаваемых в США, размещают оценки износостойкости, сцепления и сопротивления нагреву."
          },
          {
            "text": "Обод колеса",
            "note": "NHTSA выпускает и применяет федеральные стандарты безопасности для ободов колёс и шин."
          }
        ],
        "correctIndex": 1,
        "explanation": "При слишком высоком давлении мягко прижимают край манометра к штоку вентиля и медленно выпускают воздух. Когда давление достигнет нормы производителя, выпуск прекращают.",
