      "beforeHash": "a747b3d4af2ffcfe7b48cfd83da74f456b669e131a3f6d1c4079cc0755415095",
      "proposedCard": {
        "id": "human-medicine-ext-voice-organ",
        "difficulty": "medium",
        "prompt": "В какой части дыхательных путей расположены истинные голосовые складки?",
        "answers": [
          {
            "text": "В глотке",
            "note": "Глотка — мышечная трубка с тремя отделами: носоглоткой, ротоглоткой и гортаноглоткой."
          },
          {
            "text": "В гортани",
            "note": "Истинные голосовые складки прикреплены к щитовидному и черпаловидным хрящам; их свободные края колеблются при фонации."
          },
          {
            "text": "В трахее",
            "note": "Стенку трахеи поддерживают 16–20 С-образных колец из гиалинового хряща, предотвращающих её спадение."
          },
          {
            "text": "В бронхах",
            "note": "У карины трахея разделяется на правый и левый главные бронхи, которые входят в лёгкие."
          }
        ],
        "correctIndex": 1,
        "explanation": "Истинные голосовые складки расположены в гортани. Их свободные края колеблются и создают звук при фонации.",
