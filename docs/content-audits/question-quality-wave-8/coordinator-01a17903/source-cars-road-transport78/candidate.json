      "beforeHash": "cca3ba8fd901b75623d6a209630ad59a5952617148ad5411a9565844728f2f96",
      "proposedCard": {
        "id": "cars-road-transport-tire-tread-grip",
        "difficulty": "easy",
        "prompt": "Какая часть шины помогает сохранять сцепление на мокрой дороге?",
        "answers": [
          {
            "text": "Протектор",
            "note": "NHTSA рекомендует заменить шину, когда протектор изношен до 2/32 дюйма; состояние рисунка стоит проверять регулярно."
          },
          {
            "text": "Боковина",
            "note": "На боковине находится идентификационный номер DOT; последние четыре цифры указывают неделю и год изготовления шины."
          },
          {
            "text": "Вентиль",
            "note": "Вентильный шток позволяет выпустить воздух, если давление в шине выше рекомендованного."
          },
          {
            "text": "Индикатор износа",
            "note": "Выступающие индикаторы проходят между участками протектора и показывают, когда его пора менять."
          }
        ],
        "correctIndex": 0,
        "explanation": "Протектор создаёт сцепление, помогая шине не скользить на мокрой дороге. NHTSA советует заменить шину, когда протектор изношен до 2/32 дюйма.",
