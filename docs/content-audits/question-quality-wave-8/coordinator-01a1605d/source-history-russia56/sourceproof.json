          "group": "prompt_ordered_answers_key",
          "literal": {
            "prompt": "Как называется событие 9 января (22 января по новому стилю) 1905 года, когда в Санкт-Петербурге войска и полиция открыли огонь по шествию рабочих?",
            "answers": [
              "Восстание декабристов",
              "Кровавое воскресенье",
              "Февральская революция",
              "Кронштадтское восстание"
