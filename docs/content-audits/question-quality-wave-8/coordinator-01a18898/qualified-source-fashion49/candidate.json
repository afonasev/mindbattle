      "beforeCard": {
        "id": "fashion-lace-openwork",
        "difficulty": "medium",
        "prompt": "Какой способ образования ткани создаёт ажурное полотно из нитей и пустот?",
        "answers": [
          {
            "text": "Кружевоплетение",
            "note": "Кружево строится из переплетённых нитей с намеренными просветами."
          },
          {
            "text": "Вязание крючком",
            "note": "Вязание крючком создаёт полотно, протягивая нить крючком через петли."
          },
          {
            "text": "Ткачество",
            "note": "Ткачество соединяет нити основы и утка под прямым углом."
          },
          {
            "text": "Вязание",
            "note": "Вязание образует полотно из последовательно сцепленных петель."
          }
        ],
        "correctIndex": 0,
        "explanation": "Кружево строится из переплетённых нитей с намеренными просветами. Его выполняют иглой, коклюшками или машиной.",
        "source": {
          "title": "lace Definition & Meaning",
          "url": "https://www.merriam-webster.com/dictionary/lace",
          "verifiedAt": "2026-09-02"
