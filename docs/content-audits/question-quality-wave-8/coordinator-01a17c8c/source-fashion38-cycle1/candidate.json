          {
            "text": "Перчатка",
            "note": "Перчатка нередко закрывает часть руки выше кисти."
          },
          {
            "text": "Шарф",
            "note": "Шарф — широкая полоса ткани, которую носят на плечах, вокруг шеи или на голове."
          },
          {
            "text": "Ремень",
            "note": "Ремень — гибкая полоса материала, которую носят преимущественно вокруг талии."
          }
