          ]
        },
        {
          "group": "note0",
          "literal": "Хлопковое волокно состоит из волосков вокруг семян растений рода Gossypium.",
          "literalSHA256": "9a40b1c3e9c75c499c3021607a799a42301078405ffc30290814b640dca06284",
          "primaryGround": "Cotton fibre consists of hairs surrounding seeds of Gossypium plants.",
          "sourcePaths": [
            "docs/content-audits/question-quality-wave-8/coordinator-01a17bfa/source-fashion31/mw-cotton.json"
          ],
          "locator": "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a17bfa/source-fashion31/mw-cotton.json#/originalRecord/payload/output/1/text (L40-L48)",
          "sourcePathsBeforeTechnicalNormalization": [
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a17bfa/source-fashion31/mw-cotton.json"
          ]
        },
        {
          "group": "note1",
          "literal": "Льняная ткань также известна прочностью и блеском.",
          "literalSHA256": "3fab69fc0c0a4e0e109012ca1e94dabef037018544ffa7a023a9b8e726173a7b",
          "primaryGround": "The linen entry also notes strength and luster, additional properties beyond the prompt’s cooling quality.",
          "sourcePaths": [
            "docs/content-audits/question-quality-wave-8/coordinator-01a17bfa/source-fashion34/linen-context.json"
          ],
          "locator": "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a17bfa/source-fashion34/linen-context.json#/originalRecord/payload/output/1/text (L54-L62)",
