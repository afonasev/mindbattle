          ],
          "locator": "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a17bfa/source-fashion34/linen-context.json#/originalRecord/payload/output/1/text (L54-L66); /Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a17bfa/source-fashion31/mw-cotton.json#/originalRecord/payload/output/1/text (L44-L64); /Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a17bfa/source-fashion31/mw-silk.json#/originalRecord/payload/output/1/text (L44-L50); /Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a17bfa/source-fashion31/mw-wool.json#/originalRecord/payload/output/1/text (L44-L50)",
