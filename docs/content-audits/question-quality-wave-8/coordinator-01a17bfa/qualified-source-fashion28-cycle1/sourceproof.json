          ],
          "sourcePathsBeforeTechnicalNormalization": [
            "/Users/eaafonasev/.codex/worktrees/question-quality-wave6-01a12b0f/mindbattle/docs/content-audits/question-quality-wave-8/coordinator-01a17b9e/source-fashion26/raw/mw-fedora.json",
