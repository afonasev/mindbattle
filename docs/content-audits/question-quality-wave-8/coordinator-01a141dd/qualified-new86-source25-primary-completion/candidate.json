      "beforeHash": "50239a1ede688c7f0353003c6078f1316ae1a3a4226d942f2f619098ddf5cd82",
      "proposedCard": {
        "id": "books-publishing-tablet-form",
        "difficulty": "medium",
        "prompt": "Как называют предварительный раздел книги, который приглашённый внешний специалист пишет по просьбе автора?",
        "answers": [
          {
            "text": "Вступительное слово (foreword)",
            "note": "Обычно его пишет внешний эксперт по просьбе автора; имя автора раздела указывают в конце."
          },
          {
            "text": "Предисловие автора (preface)",
            "note": "Автор объясняет, почему и как он пришёл к написанию книги, и может описать свою компетентность."
          },
          {
            "text": "Введение (introduction)",
            "note": "Этот раздел описывает книгу в целом: содержание, тему, устройство и особенности."
          },
          {
            "text": "Послесловие (afterword)",
            "note": "Это заключительный раздел, помещённый после основного текста."
          }
        ],
        "correctIndex": 0,
        "explanation": "Вступительное слово (foreword) обычно пишет внешний эксперт по просьбе автора книги. Его имя, место и дата могут быть указаны в конце текста.",
