            {
              "path": "docs/content-audits/question-quality-wave-8/process-v2-books-remaining10-fresh-source-01a14018/author/sources/tepapa-how-books-printed.readable.txt",
              "url": "https://blog.tepapa.govt.nz/2016/11/18/how-are-books-printed/",
              "sha256": "588a7b199acb02568ad2563f8ef0a9e51db582f59036e776d50dd8f370db4d9c",
              "type": "complete captured readable body"
            }
          ]
        },
        {
          "group": "note2",
          "literal": "После смены форм печатник запускает пробные листы и проверяет качество настройки перед тиражом.",
          "literalSHA256": "ae62e9afa3a822a1fe5374bb3b69ea47df7ef320bc10d86ce0c0f6657e1d959d",
          "primaryGround": "L44 says after plate changes and blanket cleaning, the printer runs test sheets and checks quality; once set, a sheet takes about five minutes. The first clause is extra beyond prompt/key.",
          "locator": "L44",
          "sourcePaths": [
            {
              "path": "docs/content-audits/question-quality-wave-8/process-v2-books-remaining10-fresh-source-01a14018/author/sources/tepapa-how-books-printed.html",
