              "sha256": "588a7b199acb02568ad2563f8ef0a9e51db582f59036e776d50dd8f370db4d9c",
              "type": "complete captured readable body"
            }
          ]
        },
        {
          "group": "note1",
          "literal": "Цифровыми ползунками печатник увеличивает или уменьшает подачу отдельной краски на разных участках листа.",
          "literalSHA256": "3fe4ae4805071092e7ebe086ecd63ce2aa78ec4736dce9de9244c43621ec8e3b",
          "primaryGround": "L30 says digital slider controls increase or decrease a given ink at any strip across the sheet.",
          "locator": "L30",
          "sourcePaths": [
            {
              "path": "docs/content-audits/question-quality-wave-8/process-v2-books-remaining10-fresh-source-01a14018/author/sources/tepapa-how-books-printed.html",
              "url": "https://blog.tepapa.govt.nz/2016/11/18/how-are-books-printed/",
