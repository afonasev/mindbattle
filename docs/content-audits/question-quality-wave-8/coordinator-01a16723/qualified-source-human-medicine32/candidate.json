        "prompt": "В какой полости тела находятся лёгкие?",
        "answers": [
          {
            "text": "В брюшной",
            "note": "Брюшная полость содержит большую часть органов пищеварения."
          },
          {
            "text": "В полости таза",
            "note": "Полость таза содержит мочевой пузырь, прямую кишку и внутренние половые органы."
          },
          {
            "text": "В черепной",
            "note": "Черепная полость содержит головной мозг и его оболочки."
          },
          {
            "text": "В грудной",
            "note": "Лёгкие находятся в грудной полости по обе стороны от сердца."
          }
