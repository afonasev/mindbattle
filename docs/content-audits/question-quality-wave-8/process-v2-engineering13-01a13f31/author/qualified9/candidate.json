    {
      "id": "engineering-machines-rotary-motion",
      "topicId": "engineering-machines",
      "sourceOrder": 32,
      "status": "READY_FOR_INDEPENDENT_REVIEW",
      "beforeCard": {
        "id": "engineering-machines-rotary-motion",
        "difficulty": "easy",
        "prompt": "Как называется движение детали вокруг оси?",
        "answers": [
          {
            "text": "Поступательное движение",
            "note": "При поступательном движении тело перемещается без вращения."
          },
          {
            "text": "Возвратно-поступательное движение",
            "note": "Возвратно-поступательное движение регулярно меняет направление вдоль одной линии."
          },
          {
            "text": "Вращательное движение",
            "note": "При вращательном движении каждая точка тела описывает окружность вокруг оси."
          },
