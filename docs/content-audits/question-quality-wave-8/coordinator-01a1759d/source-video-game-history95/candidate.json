      "proposedCard": {
        "id": "video-game-history-ext-extra-life-term",
        "difficulty": "easy",
        "prompt": "Какой эффект даёт зелёный 1-Up Mushroom в New Super Mario Bros. для Nintendo DS?",
        "answers": [
          {
            "text": "Увеличение размера Марио",
            "note": "Мега-гриб превращает Марио в гиганта, который разрушает всё на пути."
          },
          {
            "text": "Получение монет из блока",
            "note": "Блоки с несколькими монетами могут дать ещё несколько монет и предмет."
          },
          {
            "text": "Получение дополнительной жизни",
            "note": "В New Super Mario Bros. зелёные 1-Up Mushrooms часто спрятаны по всему королевству."
          },
          {
            "text": "Появление лианы из скрытого блока",
            "note": "В World 1-1 скрытый блок открывает лиану, которая ведёт Марио вверх."
          }
        ],
