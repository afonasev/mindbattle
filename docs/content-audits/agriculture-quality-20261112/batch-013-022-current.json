  "sources": {
    "pto": {
      "title": "John Deere — Round Balers Specifications",
      "url": "https://www.deere.com/assets/pdfs/region-4/industries/government-and-military-sales/contracts/price-pages/agricultural/Balers_Jan_2022.pdf",
      "context": "Round baler specifications, PTO tractor hookup and clevis hitch, lines 2225–2229 and 3827–3843."
    },
    "tractor": {
      "title": "John Deere — Agricultural Products, 6000–9000 Series Tractors",
      "url": "https://www.deere.com/assets/pdfs/region-4/industries/government-and-military-sales/contracts/price-pages/agricultural/A2_6000_9000_Series_20190806.pdf",
      "context": "Tractor specs under PTO, Hydraulics, Hitch and Drawbar."
    },
    "plow": {
      "title": "Michigan State University Extension — Types of Tillage Equipment and Their Functions",
      "url": "https://www.canr.msu.edu/beginning-farmer/uploads/files/BFRDMG_Equipment_Tillage.pdf",
      "context": "Plows, lines 105–112. Inversion, clods may remain; moldboard leaves little surface residue; chisel leaves more."
    },
    "till": {
      "title": "NC State Extension — Tillage Management",
      "url": "https://soilmanagement.ces.ncsu.edu/soil-health-management/tillage-management/",
      "context": "Conventional Tillage Management and Chisel Plow. Moldboard slices, lifts, turns soil, unlike chisel."
    },
    "combine": {
      "title": "Purdue Extension — Safe Operation of a Combine",
      "url": "https://www.extension.purdue.edu/extmedia/s/s-74.html",
      "context": "Combine size, Unloading the grain tank, lines 62–64 and 103–108. Unloading auger, grain tank, unload into truck/wagon on the go."
    },
    "clean": {
      "title": "Purdue Extension — Where Grain Hides in a Combine",
      "url": "https://www.extension.purdue.edu/extmedia/GQ/GQ-49-W.pdf",
      "context": "Cleanout Recommendations. Grain remaining in tank, feederhouse and cleaning shoe; cleaning between grain lots."
    },
    "drill": {
      "title": "UMN Extension — Planting equipment calibration",
      "url": "https://extension.umn.edu/agriculture/crop-production/small-grains/planting-equipment-calibration",
      "context": "Lines 243–267. Speed, planting depth, firm covering and metering checks over a measured drill row."
    },
    "cornplant": {
      "title": "UMN Extension — Strategies for successful corn planting",
      "url": "https://extension.umn.edu/agriculture/crop-production/corn/strategies-successful-corn-planting",
      "context": "Optimal planting depth and timing, lines 257–270. Bouncing planter, uneven placement/emergence, conditions of germination."
    },
    "garden": {
      "title": "UMN Extension — Planting the vegetable garden",
      "url": "https://extension.umn.edu/garden-and-home/yard-and-garden/gardening-in-minnesota/planting-the-vegetable-garden",
      "context": "Outdoor planting and transplanting, lines 319–346. Carrots and beets direct seeded, tomatoes started indoors."
    },
    "weed": {
      "title": "UMN Extension — Controlling weeds in home gardens",
      "url": "https://extension.umn.edu/garden-and-home/yard-and-garden/gardening-in-minnesota/controlling-weeds-in-home-gardens",
      "context": "Lines 269–276. Pull or hoe weeds, limit depth to protect crop roots, remove before flowering, including weeds growing in mulch holes."
    },
    "prune": {
      "title": "UMN Extension — Pruning and training apple trees",
      "url": "https://extension.umn.edu/garden-and-home/yard-and-garden/gardening-in-minnesota/pruning-and-training-apple-trees",
      "context": "General pruning guidelines and Central leader pruning. Remove broken/crossing/dead branches; heading cuts encourage growth below; before spring growth; more sun/air."
    },
    "hail": {
      "title": "UMN Extension — Hail netting for apple orchards",
      "url": "https://extension.umn.edu/agriculture/specialty-crops/commercial-fruit-production/hail-netting-for-apple-orchards",
      "context": "Application and Removal, lines 274–294. Net after petal fall and removed before harvest, netting over tree rows."
    },
    "apple": {
      "title": "UMN Extension — Growing apples in the home garden",
      "url": "https://extension.umn.edu/garden-and-home/yard-and-garden/gardening-in-minnesota/growing-apples",
      "context": "Pollination considerations, lines 276–286; spacing lines 391–395. Different apple varieties for pollen; avoid close spacing."
    },
    "vine": {
      "title": "UMN Extension — Vineyard production and grape farming",
      "url": "https://extension.umn.edu/agriculture/specialty-crops/commercial-fruit-production/vineyard-production-and-grape-farming",
      "context": "Intro and Growing grapes in Minnesota. Most Minnesota production for wine, some table grapes; trellis support, can take multiple years to establish."
    },
    "trellis": {
      "title": "UMN Extension — Trellises for grapes",
      "url": "https://extension.umn.edu/agriculture/specialty-crops/commercial-fruit-production/vineyard-production-and-grape-farming/trellises-for-grapes",
      "context": "Trellis components, supports vines and fruit with posts and wire."
    },
    "pasture": {
      "title": "UMN Extension — Managing grazing livestock during wet weather",
      "url": "https://extension.umn.edu/agriculture/animals-and-livestock/beef/managing-grazing-livestock-during-wet-weather",
      "context": "Managing wet pastures, allow areas to rest. Rotate cattle to limit compaction and allow recovery; dense grass tolerates wet conditions better."
    },
    "glass": {
      "title": "Cornell Small Farms — Season Extension",
      "url": "https://smallfarms.cornell.edu/resources/guide-to-urban-farming/season-extension/",
      "context": "Greenhouses, lines 106–108: glass or greenhouse plastic, additional heat, automated cooling and heating for extended season."
    },
    "soy": {
      "title": "Iowa State University Extension — Soybean harvest: When the time is right",
      "url": "https://crops.extension.iastate.edu/post/soybean-harvest-when-time-right",
      "context": "Harvest scheduling: soybean moisture at harvest, penalties above 13%, storage and field losses."
    },
    "header": {
      "title": "John Deere — X9 Combine Header Optimization Guide",
      "url": "https://www.deere.com/assets/pdfs/common/qrg/x9-rthg-optimization-guide.pdf",
      "context": "Header types and crop categories including draper for small grains and corn heads."
    },
    "sod": {
      "title": "Penn State Extension — Managing Soil Health: Concepts and Practices",
      "url": "https://blogs.ext.vt.edu/farm-to-table/files/2014/10/AIP_SoilHlth.pdf",
      "context": "Common Primary Tillage Implements: moldboard plow buries sod and residue; chisel does not invert."
    },
    "share": {
      "title": "Oklahoma State University — Dibble Sticks, Donkeys, and Diesels, §4.9 Moldboard Plows",
      "url": "https://nue.okstate.edu/Hand_Planter/DDA.pdf",
      "context": "§4.9 and Fig. 4.13, lines 1925–1937: share forms the cutting part of the plow bottom and cuts the soil slice; moldboard lifts it."
    }
  },
